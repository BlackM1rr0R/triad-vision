// ─── Housing search + Anmeldung (lib/housing) ──────────────────────────

enum HousingListingType {
  ROOM // single room
  SHARED_FLAT // WG
  APARTMENT
  WORKER_HOUSING // employer / partner accommodation for several workers
  BOARDING_HOUSE // furnished short-term flat
}

enum ContractReviewStatus {
  NONE
  REQUESTED // client asked the team to look at the uploaded rental contract
  REVIEWED // staff answered
}

enum HousingProposalResponse {
  PENDING
  INTERESTED
  NOT_INTERESTED
}

/// Housing search checklist and Anmeldung of one (approved) case. Files live in the client's vault.
model CaseHousing {
  id                        String               @id @default(cuid())
  caseId                    String               @unique
  case                      Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  city                      String?              @db.VarChar(80) // where the client looks for a flat (overrides arrival plan / employer city)
  budgetMax                 Int? // EUR warm rent per month
  housingSteps              Json? // { stepKey: ISO date done }
  bringItems                Json? // Anmeldung "what to bring" ticks { itemKey: ISO date }
  moveInDate                DateTime? // calendar day (00:00 UTC); Anmeldung deadline = + 14 days
  contractVaultDocId        String?              @db.VarChar(40)
  contractUploadedAt        DateTime?
  contractReview            ContractReviewStatus @default(NONE)
  contractQuestion          String?              @db.Text
  contractReply             String?              @db.Text
  contractReviewRequestedAt DateTime?
  contractReviewedAt        DateTime?
  contractReviewedById      String?              @db.VarChar(40)
  appointmentAt             DateTime? // Bürgeramt appointment (UTC; entered as Berlin wall time)
  appointmentAddress        String?              @db.VarChar(300)
  appointmentNote           String?              @db.VarChar(500)
  appointmentSetAt          DateTime?
  appointmentSetById        String?              @db.VarChar(40)
  meldeVaultDocId           String?              @db.VarChar(40) // Meldebescheinigung
