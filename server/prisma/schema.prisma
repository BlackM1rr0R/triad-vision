// ─── Scheduled jobs and privacy-friendly analytics ───────────────────

/// One row per reminder actually sent, so a job never sends the same reminder twice.
model ReminderLog {
  id     String   @id @default(cuid())
  key    String   @unique // e.g. "appointment-24h:<caseId>:<appointmentAt ISO>"
  sentAt DateTime @default(now())
}

/// Aggregated daily counters (no cookies, no IPs, no user ids) for the conversion funnel.
model AnalyticsDaily {
  id     String   @id @default(cuid())
  day    DateTime @db.Date
  metric String // visit | register | email_verified | case_created | approved | inquiry | booking | vacancy_apply
  source String   @default("") // utm_source / referrer host, lower-cased, max 60 chars
  count  Int      @default(0)

  @@unique([day, metric, source])
  @@index([metric, day])
}

// ─── Team workspace: drive (folders/files with inherited permissions) ───

enum DriveSpace {
  SHARED // the company drive everyone in the team works in
  PERSONAL // one root per staff member ("My files")
  CASES // system root; per-case sub-folders are virtual (built from Case/Document)
}

enum DriveNodeKind {
  FOLDER
  FILE
}

/// Ordered from least to most. Each level includes everything below it.
enum DriveAccess {
  VIEW // see the folder and preview files in the browser
  DOWNLOAD // VIEW + download single files
  EXPORT // DOWNLOAD + download whole folders as ZIP
  EDIT // EXPORT + upload, create folders, rename, move, delete (to trash), new versions
  MANAGE // EDIT + change who has access to this folder
}

/// One folder or file. Files are stored on disk under <DOCS_DIR>/drive/<storageKey> (renames and moves
/// never touch the disk). Sibling names are unique among non-deleted nodes (enforced in code).
model DriveNode {
  id                 String             @id @default(cuid())
  space              DriveSpace
  kind               DriveNodeKind
  parentId           String?
  parent             DriveNode?         @relation("DriveTree", fields: [parentId], references: [id], onDelete: Cascade)
  children           DriveNode[]        @relation("DriveTree")
  name               String             @db.VarChar(255)
  /// PERSONAL space: the staff member whose "My files" this is (set on every node of that tree).
  ownerId            String?
  owner              User?              @relation("DriveNodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// false = permissions are NOT inherited from the parent (only grants from this node down apply).
  inheritPermissions Boolean            @default(true)
  /// System nodes (space roots) cannot be renamed, moved or deleted.
  system             Boolean            @default(false)
  color              String?            @db.VarChar(20) // folder colour in the explorer
  // File fields (kind = FILE)
  storageKey         String?            @unique
  mimeType           String?
  size               Int?
  version            Int                @default(1)
  createdById        String?
  createdBy          User?              @relation("DriveNodeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  /// Recycle bin: set when deleted; purged for good after the trash period.
  deletedAt          DateTime?
  deletedById        String?
  deletedBy          User?              @relation("DriveNodeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  grants             DriveGrant[]
  versions           DriveFileVersion[]
  favorites          DriveFavorite[]
  taskLinks          TaskAttachment[]
  /// Copy of a case document (accepted upload) placed in the client's folder; the link to the case stays.
  documentId         String?            @unique
  /// Edit lock: who is editing the file right now (released on save/close or after it goes stale).
  lockedById         String?
  lockedBy           User?              @relation("DriveNodeLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  lockedAt           DateTime?
  /// Text extracted from the file (PDF text layer or OCR of scans/images) for full-text search.
  textContent        String?            @db.LongText
  textIndexedAt      DateTime?
  /// Document workflow column on the board (Gələn → Yoxlanılır → Tərcümədə → Apostildə → Hazır → Səfirliyə göndərildi).
  workflowStage      DocWorkflowStage?
  workflowAt         DateTime?
  /// "Final" lock: signed contract / sent embassy package — nobody may change it any more (super admin can unlock).
  finalAt            DateTime?
  finalById          String?
  /// sha256 of the current file content (duplicate detection).
  contentHash        String?            @db.Char(64)
  /// Moved to the archive by the retention policy.
  archivedAt         DateTime?
  tags               DriveNodeTag[]
  comments           DriveComment[]
  shareLinks         DriveShareLink[]

  @@index([parentId, deletedAt])
  @@index([space, ownerId])
  @@index([deletedAt])
  @@index([name])
  @@index([contentHash])
  @@index([workflowStage])
}

/// Access to a node (and, by inheritance, everything below it) for one user OR every user of a role.
model DriveGrant {
  id          String      @id @default(cuid())
  nodeId      String
  node        DriveNode   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?       @relation("DriveGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  role        Role? // e.g. STAFF = everyone on the team with that role (and above)
  access      DriveAccess
  grantedById String?
  grantedBy   User?       @relation("DriveGrantGivenBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([nodeId, userId])
  @@unique([nodeId, role])
  @@index([userId])
}

/// Previous versions of a file (the current one lives on the node itself).
model DriveFileVersion {
  id           String    @id @default(cuid())
  nodeId       String
  node         DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  version      Int
  storageKey   String    @unique
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@unique([nodeId, version])
}

model DriveFavorite {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId    String
  node      DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([userId, nodeId])
}

// ─── Team workspace: tasks ─────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id          String              @id @default(cuid())
  number      Int                 @unique // shown as T-0001; assigned as max+1 in code
  title       String              @db.VarChar(200)
  description String?             @db.Text
  status      TaskStatus          @default(TODO)
  priority    TaskPriority        @default(NORMAL)
  startAt     DateTime?
  dueAt       DateTime? // deadline: by when it must be solved
  completedAt DateTime?
  sortOrder   Int                 @default(0) // order inside a board column
  caseId      String? // optional link to a visa case
  case        Case?               @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?               @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignees   TaskAssignee[]
  comments    TaskComment[]
  checklist   TaskChecklistItem[]
  attachments TaskAttachment[]

  @@index([status, dueAt])
  @@index([caseId])
}

model TaskAssignee {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String   @db.Text
  /// System entries ("status changed to Done") render as activity, not as a comment bubble.
  system    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model TaskChecklistItem {
  id        String  @id @default(cuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String  @db.VarChar(300)
  done      Boolean @default(false)
  sortOrder Int     @default(0)
}

/// A drive file or folder linked to a task.
model TaskAttachment {
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  nodeId    String
  node      DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([taskId, nodeId])
}

// ─── Messaging: WhatsApp / SMS, templates ───────────────────────────────

enum OutboundChannel {
  WHATSAPP
  SMS
}

enum OutboundStatus {
  QUEUED
  SENT
  FAILED
  CONSOLE
}

/// Every WhatsApp/SMS message the system tried to send (like EmailLog, with provider ids and errors).
model OutboundMessage {
  id          String          @id @default(cuid())
  channel     OutboundChannel
  to          String
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  caseId      String?
  case        Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  templateKey String?
  body        String          @db.Text
  status      OutboundStatus  @default(QUEUED)
  providerId  String?
  error       String?         @db.Text
  createdAt   DateTime        @default(now())
  sentAt      DateTime?

  @@index([userId, createdAt])
  @@index([caseId])
  @@index([status, createdAt])
}

/// Admin-edited override of a notification text (title/body per type and locale). Missing rows fall back to code.
model NotificationTemplate {
  id          String   @id @default(cuid())
  type        String
  locale      Locale
  title       String
  body        String   @db.Text
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@unique([type, locale])
}

// ─── Document requirement templates per visa type ──────────────────────

model RequirementTemplate {
  id             String        @id @default(cuid())
  visaCategoryId String? // null = default set used when the visa type has no own list
  visaCategory   VisaCategory? @relation(fields: [visaCategoryId], references: [id], onDelete: Cascade)
  stage          DocStage
  key            String? // PASSPORT, PHOTO, CV, DIPLOMA, LANGUAGE_CERT, …
  title          Json
  description    Json?
  required       Boolean       @default(true)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())

  @@index([visaCategoryId, stage])
}

// ─── Post-arrival onboarding, German preparation ───────────────────────

model OnboardingItem {
  id        String           @id @default(cuid())
  slug      String           @unique
  icon      String           @default("CheckCircle2")
  title     Json
  body      Json // L10n, paragraphs separated by blank lines
  link      String?          @db.Text
  dueDays   Int? // days after arrival by which it should be done (e.g. Anmeldung: 14)
  sortOrder Int              @default(0)
  published Boolean          @default(true)
  progress  CaseOnboarding[]
}

model CaseOnboarding {
  id     String         @id @default(cuid())
  caseId String
  case   Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  itemId String
  item   OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  doneAt DateTime?
  note   String?        @db.Text

  @@unique([caseId, itemId])
}

model GermanQuestion {
  id        String  @id @default(cuid())
  level     String // A1 | A2 | B1 | B2
  question  Json // L10n prompt (the sentence itself is German)
  options   Json // string[]
  answer    Int
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model LanguageCourse {
  id          String  @id @default(cuid())
  name        String
  provider    String?
  city        String?
  url         String? @db.Text
  levels      String? // e.g. "A1–B1"
  format      String? // online | offline | hybrid
  description Json? // L10n
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

// ─── Interviews (employer ↔ candidate) ─────────────────────────────────

enum InterviewStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
  DONE
  NO_SHOW
}

model Interview {
  id            String              @id @default(cuid())
  applicationId String?
  application   VacancyApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  candidateId   String
  candidate     User                @relation("InterviewCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  staffId       String?
  staff         User?               @relation("InterviewStaff", fields: [staffId], references: [id], onDelete: SetNull)
  startsAt      DateTime
  endsAt        DateTime
  meetingUrl    String?             @db.Text
  status        InterviewStatus     @default(PROPOSED)
  notes         String?             @db.Text
  createdById   String?
  createdBy     User?               @relation("InterviewCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  /// Set when the candidate picked the time themselves from the employer's free slots.
  invite InterviewInvite?

  @@index([candidateId, startsAt])
  @@index([companyId, startsAt])
  @@index([startsAt])
}

// ─── Interview calendar: employer availability, candidate picks the time ───

enum InterviewAvailabilityKind {
  WEEKLY // recurring free hours on a weekday
  DATE // one-off free hours on one day
  BLOCK // one-off unavailable time (whole day without times)
}

/// The employer's free hours for interviews, as German wall-clock time (Europe/Berlin).
model InterviewAvailability {
  id        String                    @id @default(cuid())
  companyId String
  company   Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      InterviewAvailabilityKind
  /// WEEKLY: ISO weekday, 1 = Monday … 7 = Sunday.
  weekday   Int?
  /// DATE / BLOCK: German calendar day "YYYY-MM-DD".
  day       String?                   @db.VarChar(10)
  /// "HH:MM" (end may be "24:00"); a BLOCK without times covers the whole day.
  startTime String?                   @db.VarChar(5)
  endTime   String?                   @db.VarChar(5)
  note      String?                   @db.VarChar(200)
  createdAt DateTime                  @default(now())

  @@index([companyId, kind])
}

/// Per-employer booking rules for self-scheduled interviews.
model InterviewSchedulingSettings {
  companyId         String   @id
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slotMinutes       Int      @default(45)
  bufferMinutes     Int      @default(15)
  minNoticeHours    Int      @default(24)
  horizonDays       Int      @default(21)
  /// The candidate may move or cancel a self-booked interview until this many hours before it.
  cancelCutoffHours Int      @default(12)
  maxReschedules    Int      @default(2)
  updatedAt         DateTime @updatedAt
}

enum InterviewInviteStatus {
  OPEN
  BOOKED
  CANCELLED
}

/// "Pick a time": the employer (or staff) invites a presented candidate, who books a free slot.
model InterviewInvite {
  id            String                @id @default(cuid())
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applicationId String?
  application   VacancyApplication?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  candidateId   String
  candidate     User                  @relation("InterviewInviteCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  minutes       Int
  notes         String?               @db.Text
  status        InterviewInviteStatus @default(OPEN)
  interviewId   String?               @unique
  interview     Interview?            @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  reschedules   Int                   @default(0)
  createdById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([candidateId, status])
  @@index([companyId, status])
}

// ─── Internal knowledge base ───────────────────────────────────────────

model KbCategory {
  id        String      @id @default(cuid())
  name      String
  sortOrder Int         @default(0)
  articles  KbArticle[]
}

model KbArticle {
  id          String      @id @default(cuid())
  categoryId  String?
  category    KbCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title       String
  body        String      @db.Text // markdown
  tags        Json? // string[]
  pinned      Boolean     @default(false)
  published   Boolean     @default(true)
  updatedById String?
  updatedBy   User?       @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@fulltext([title, body])
}

// ─── Partner API keys and webhooks ─────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String // first 8 chars, shown in the UI
  keyHash     String    @unique // sha256 of the full key
  scopes      Json // string[] e.g. ["vacancies:read","applications:read","candidates:read"]
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Webhook {
  id          String            @id @default(cuid())
  url         String            @db.Text
  secret      String // HMAC-SHA256 signing secret
  events      Json // string[] e.g. ["case.status_changed","application.created"]
  companyId   String?
  company     Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  active      Boolean           @default(true)
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  deliveries  WebhookDelivery[]
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model WebhookDelivery {
  id            String         @id @default(cuid())
  webhookId     String
  webhook       Webhook        @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  responseCode  Int?
  lastError     String?        @db.Text
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
}

// ─── Team workspace: mail ───────────────────────────────────────────────

enum MailProvider {
  GMAIL
  OUTLOOK
  YANDEX
  MAILRU
  CUSTOM
}

enum MailSyncStatus {
  IDLE
  SYNCING
  OK
  ERROR
}

/// A staff member's own mailbox (IMAP + SMTP); the password is sealed with the server key.
model MailAccount {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String         @db.VarChar(190)
  displayName   String?        @db.VarChar(120)
  provider      MailProvider   @default(CUSTOM)
  imapHost      String         @db.VarChar(190)
  imapPort      Int            @default(993)
  imapSecure    Boolean        @default(true)
  smtpHost      String         @db.VarChar(190)
  smtpPort      Int            @default(465)
  smtpSecure    Boolean        @default(true)
  username      String         @db.VarChar(190)
  passwordEnc   String         @db.Text
  signatureHtml String?        @db.Text
  isDefault     Boolean        @default(false)
  syncEnabled   Boolean        @default(true)
  syncStatus    MailSyncStatus @default(IDLE)
  syncError     String?        @db.VarChar(500)
  lastSyncAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  folders       MailFolder[]
  messages      MailMessage[]
  rules         MailRule[]

  @@unique([userId, email])
}

enum MailFolderRole {
  INBOX
  SENT
  DRAFTS
  TRASH
  JUNK
  ARCHIVE
  OTHER
}

model MailFolder {
  id          String         @id @default(cuid())
  accountId   String
  account     MailAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  path        String         @db.VarChar(255) // IMAP mailbox path
  name        String         @db.VarChar(120)
  role        MailFolderRole @default(OTHER)
  delimiter   String?        @db.VarChar(4)
  uidValidity BigInt?
  lastUid     BigInt         @default(0) // highest UID synced so far
  total       Int            @default(0)
  unread      Int            @default(0)
  subscribed  Boolean        @default(true)
  sortOrder   Int            @default(0)
  messages    MailMessage[]

  @@unique([accountId, path])
}

model MailMessage {
  id             String             @id @default(cuid())
  accountId      String
  account        MailAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folderId       String
  folder         MailFolder         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uid            BigInt? // IMAP UID inside the folder; null for local drafts
  messageId      String?            @db.VarChar(500)
  inReplyTo      String?            @db.VarChar(500)
  refs           String?            @db.Text // References header
  threadKey      String?            @db.VarChar(190) // root Message-ID of the conversation
  subject        String?            @db.VarChar(1000)
  fromName       String?            @db.VarChar(255)
  fromAddr       String?            @db.VarChar(255)
  toList         Json // [{ name, address }]
  ccList         Json?
  bccList        Json?
  replyTo        String?            @db.VarChar(255)
  date           DateTime
  snippet        String?            @db.VarChar(300)
  text           String?            @db.LongText
  html           String?            @db.LongText // sanitised before storing
  hasAttachments Boolean            @default(false)
  size           Int?
  seen           Boolean            @default(false)
  flagged        Boolean            @default(false)
  answered       Boolean            @default(false)
  isDraft        Boolean            @default(false)
  snoozedUntil   DateTime?
  caseId         String? // linked visa case
  case           Case?              @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  attachments    MailAttachment[]
  labels         MailMessageLabel[]
  triage         MailTriage? // AI triage of an incoming message (lib/ai/features/mailTriage.ts)

  @@unique([folderId, uid])
  @@index([accountId, date])
  @@index([accountId, threadKey])
  @@index([accountId, seen])
  @@index([messageId])
  @@index([snoozedUntil])
  @@fulltext([subject, text])
}

model MailAttachment {
  id         String      @id @default(cuid())
  messageId  String
  message    MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename   String      @db.VarChar(255)
  mimeType   String      @db.VarChar(120)
  size       Int
  contentId  String?     @db.VarChar(255) // inline images (cid:)
  inline     Boolean     @default(false)
  partId     String?     @db.VarChar(40) // IMAP body part, for lazy download
  storageKey String?     @unique // <DOCS_DIR>/mail/<key> once fetched

  @@index([messageId])
}

model MailLabel {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String             @db.VarChar(60)
  color     String             @db.VarChar(20)
  sortOrder Int                @default(0)
  messages  MailMessageLabel[]

  @@unique([userId, name])
}

model MailMessageLabel {
  messageId String
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  labelId   String
  label     MailLabel   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([messageId, labelId])
}

/// Inbox rule: when an incoming message matches `conditions`, apply `actions` (label, mark read, move, flag, link to case).
model MailRule {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String?
  account    MailAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String       @db.VarChar(80)
  enabled    Boolean      @default(true)
  conditions Json
  actions    Json
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

/// Canned responses (personal, or shared with the whole team).
model MailTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shared    Boolean  @default(false)
  name      String   @db.VarChar(80)
  subject   String?  @db.VarChar(300)
  html      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Team workspace: chat ───────────────────────────────────────────────

enum ChatChannelKind {
  PUBLIC
  PRIVATE
  DM
}

enum ChatMemberRole {
  OWNER
  MEMBER
}

model ChatChannel {
  id          String          @id @default(cuid())
  kind        ChatChannelKind
  name        String?         @db.VarChar(80) // null for DMs
  topic       String?         @db.VarChar(250)
  caseId      String? // channel opened for a visa case
  case        Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?           @relation("ChatChannelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ChatMember[]
  messages    ChatMessage[]
  polls       Poll[]

  @@index([kind, archivedAt])
}

model ChatMember {
  id         String         @id @default(cuid())
  channelId  String
  channel    ChatChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ChatMemberRole @default(MEMBER)
  joinedAt   DateTime       @default(now())
  lastReadAt DateTime?
  muted      Boolean        @default(false)
  pinned     Boolean        @default(false)

  @@unique([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id          String           @id @default(cuid())
  channelId   String
  channel     ChatChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body        String           @db.Text
  parentId    String? // thread reply
  parent      ChatMessage?     @relation("ChatThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ChatMessage[]    @relation("ChatThread")
  replyCount  Int              @default(0)
  mentions    Json? // user ids mentioned
  editedAt    DateTime?
  deletedAt   DateTime?
  pinnedAt    DateTime?
  createdAt   DateTime         @default(now())
  attachments ChatAttachment[]
  reactions   ChatReaction[]

  @@index([channelId, createdAt])
  @@index([parentId])
  @@fulltext([body])
}

model ChatAttachment {
  id          String      @id @default(cuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String      @db.VarChar(255)
  mimeType    String      @db.VarChar(120)
  size        Int
  storageKey  String      @unique // <DOCS_DIR>/chat/<key>
  driveNodeId String? // when shared from the team drive instead of uploaded

  @@index([messageId])
}

model ChatReaction {
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String      @db.VarChar(16)
  createdAt DateTime    @default(now())

  @@id([messageId, userId, emoji])
}

// ─── Team workspace: calendar ───────────────────────────────────────────

enum EventVisibility {
  PRIVATE
  TEAM
}

enum AttendeeStatus {
  NEEDS_ACTION
  ACCEPTED
  DECLINED
  TENTATIVE
}

model CalendarEvent {
  id              String             @id @default(cuid())
  ownerId         String
  owner           User               @relation("CalendarEventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title           String             @db.VarChar(200)
  description     String?            @db.Text
  location        String?            @db.VarChar(255)
  meetingUrl      String?            @db.VarChar(500)
  startsAt        DateTime
  endsAt          DateTime
  allDay          Boolean            @default(false)
  color           String?            @db.VarChar(20)
  visibility      EventVisibility    @default(TEAM)
  rrule           String?            @db.VarChar(255) // RFC 5545 RRULE, e.g. FREQ=WEEKLY;BYDAY=MO
  reminderMinutes Int?
  caseId          String?
  case            Case?              @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  attendees       CalendarAttendee[]

  @@index([startsAt])
  @@index([ownerId, startsAt])
}

model CalendarAttendee {
  eventId String
  event   CalendarEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status  AttendeeStatus @default(NEEDS_ACTION)

  @@id([eventId, userId])
  @@index([userId])
}

// ─── Team workspace: contacts, announcements, notes, polls, leave ───────

enum ContactSource {
  MANUAL
  MAIL
  IMPORT
}

/// Shared address book (plus private contacts when shared = false).
model Contact {
  id            String        @id @default(cuid())
  createdById   String?
  createdBy     User?         @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  shared        Boolean       @default(true)
  firstName     String        @db.VarChar(80)
  lastName      String?       @db.VarChar(80)
  email         String?       @db.VarChar(190)
  emails        Json? // additional addresses
  phone         String?       @db.VarChar(40)
  company       String?       @db.VarChar(120)
  companyId     String?
  companyRef    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  position      String?       @db.VarChar(120)
  address       String?       @db.VarChar(255)
  notes         String?       @db.Text
  tags          Json?
  userId        String? // linked platform account (client / employer)
  user          User?         @relation("ContactUser", fields: [userId], references: [id], onDelete: SetNull)
  source        ContactSource @default(MANUAL)
  lastContactAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([email])
  @@index([createdById, shared])
  @@fulltext([firstName, lastName, email, company])
}

model Announcement {
  id          String             @id @default(cuid())
  authorId    String
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String             @db.VarChar(200)
  body        String             @db.Text
  pinned      Boolean            @default(false)
  publishedAt DateTime           @default(now())
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  reads       AnnouncementRead[]

  @@index([pinned, publishedAt])
}

model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
}

/// Personal sticky notes.
model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?  @db.VarChar(120)
  body      String   @db.Text
  color     String?  @db.VarChar(20)
  pinned    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, pinned])
}

