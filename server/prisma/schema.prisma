  email       String
  phone       String?
  topic       String? // candidate | company | other
  message     String?          @db.Text
  locale      String           @default("az")
  meetingUrl  String           @db.Text
  manageToken String           @unique // sha256 of the cancel link token
  status      BookingStatus    @default(BOOKED)
  createdAt   DateTime         @default(now())
  /// Office visits: the case the visit belongs to (topic = originals | passport | sign | other).
  caseId      String?
  case        Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull)
  /// Referral partner whose link the visitor came with (tv_ref cookie holding a partner code).
  partnerId   String?          @db.VarChar(40)

  @@index([email])
  @@index([caseId])
}

// ─── Invoices ─────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique // e.g. TV-RE-2026-0001
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  issueDate  DateTime
  dueDate    DateTime
  currency   String        @default("EUR")
  items      Json // { description, quantity, unitPriceCents }[]
  netCents   Int
  vatRate    Int           @default(19) // percent
