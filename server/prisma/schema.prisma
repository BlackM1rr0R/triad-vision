enum LeaveType {
  VACATION
  SICK
  REMOTE
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
