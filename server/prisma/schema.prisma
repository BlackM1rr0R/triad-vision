// ─── Reviews (collected after a visa approval) ───────────────────────

enum ReviewStatus {
  REQUESTED // invitation sent, not answered yet
  PENDING // submitted, waiting for moderation
  APPROVED
  REJECTED
}

model Review {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId         String       @unique
  tokenHash      String       @unique // link in the invitation email
  rating         Int? // 1–5
  text           String?      @db.Text
  displayName    String? // e.g. "Ali M., truck driver"
  consentPublish Boolean      @default(false)
  locale         String       @default("az")
  status         ReviewStatus @default(REQUESTED)
  createdAt      DateTime     @default(now())
