}

model Stat {
  id        String @id @default(cuid())
  icon      String
  value     Int
  prefix    String @default("")
  suffix    String @default("")
  label     Json
  sortOrder Int    @default(0)
}

model Faq {
  id        String  @id @default(cuid())
  question  Json
  answer    Json
  audience  String  @default("all") // all | company | candidate
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model Post {
  id             String   @id @default(cuid())
  slug           String   @unique
  cover          String   @db.Text
  title          Json
  excerpt        Json
  body           Json
  published      Boolean  @default(true)
  seoTitle       Json? // L10n override of <title>
  seoDescription Json? // L10n override of the meta description
  ogImage        String?  @db.Text
  noindex        Boolean  @default(false)
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
  ARCHIVED
}

model Inquiry {
  id            String        @id @default(cuid())
  kind          String // company | contact
  companyName   String?
  contactName   String
  email         String
  phone         String?
  sector        String?
  workersNeeded Int?
  message       String        @db.Text
  locale        String
  source        String?       @db.VarChar(80) // e.g. "event:<id>" (info-session registrant)
  status        InquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
  /// Lead scoring (rules in Setting `leadScoring`).
  score         Int           @default(0)
  scoreLevel    String?       @db.VarChar(10) // COLD | WARM | HOT
  scoreReasons  Json?
  scoredAt      DateTime?
  visitorId     String?       @db.VarChar(40)
  quizResult    Json?
  estimate      Json? // cost calculator result the lead asked about
  landingPageId String?       @db.VarChar(40)
  utm           Json?
  /// Referral partner whose link the visitor came with (tv_ref cookie holding a partner code).
