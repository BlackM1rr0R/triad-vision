generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Localized text fields are stored as JSON: { "az": "...", "de": "...", "en": "...", "ru": "..." }

enum Role {
  CLIENT
  COMPANY // employer account (belongs to a Company)
  AGENT // regional partner who brings candidates (agent portal only)
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum Locale {
  az
  de
  en
  ru
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  role                    Role                     @default(CLIENT)
  firstName               String
  lastName                String
  phone                   String?
  locale                  Locale                   @default(az)
  isActive                Boolean                  @default(true)
  // Candidate profile (all optional, filled in the portal)
  birthDate               DateTime?
  nationality             String?
  city                    String?
  address                 String?                  @db.Text
  profession              String?
  experienceYears         Int?
  germanLevel             String? // none | A1 | A2 | B1 | B2 | C1 | C2
  education               String? // school | vocational | university
  /// Recognition of the foreign qualification (Anerkennung): NONE | NOT_REQUIRED | IN_PROGRESS | PARTIAL (Defizitbescheid) | RECOGNISED
  recognitionStatus       String?                  @db.VarChar(20)
  recognitionNote         String?                  @db.VarChar(300)
  /// Short video introduction for employers (private upload key / drive node id).
  introVideoKey           String?                  @db.VarChar(300)
  drivingLicence          String? // e.g. "B, C, CE"
  about                   String?                  @db.Text
  // Notification preferences (in-app notifications are always kept)
  emailNotifications      Boolean                  @default(true)
  pushNotifications       Boolean                  @default(true)
  passportExpiry          DateTime? // for the passport-expiry reminder
  passportNumber          String? // from passport OCR (MRZ) or typed by the client
  whatsappOptIn           Boolean                  @default(true) // case updates via WhatsApp (needs a phone number)
  smsNotifications        Boolean                  @default(true) // appointment reminders via SMS
  calendarToken           String?                  @unique // secret for the personal ICS feed (staff)
  // Email verification and two-factor authentication
  emailVerifiedAt         DateTime?
  totpSecret              String?                  @db.Text // encrypted with the server key; set while enrolling
  totpEnabledAt           DateTime?
  recoveryCodes           Json? // sha256 hashes of unused one-time recovery codes
  emailOtpEnabledAt       DateTime? // two-step login with a code sent by email (CLIENT / COMPANY only)
  emailOtpCodes           EmailOtpCode[]
  // Employer accounts
  companyId               String?
  company                 Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  cases                   Case[]                   @relation("CaseClient")
  assignedCases           Case[]                   @relation("CaseStaff")
  notifications           Notification[]
  events                  CaseEvent[]
  messages                CaseMessage[]
  documents               Document[]
  resetTokens             PasswordResetToken[]
  devices                 PushDevice[]
  sessions                Session[]
  auditLogs               AuditLog[]
  docFolder               DocFolder?
  docGrants               DocGrant[]               @relation("GrantUser")
  grantsGiven             DocGrant[]               @relation("GrantedBy")
  docFiles                DocFile[]
  verifyTokens            EmailVerificationToken[]
  applications            VacancyApplication[]
  bookings                Booking[]                @relation("BookingUser")
  slots                   ConsultationSlot[]       @relation("SlotStaff")
  clientTasksCreated      ClientTask[]             @relation("ClientTaskCreatedBy")
  reviews                 Review[]
  driveNodesCreated       DriveNode[]              @relation("DriveNodeCreatedBy")
  driveNodesOwned         DriveNode[]              @relation("DriveNodeOwner")
  driveNodesDeleted       DriveNode[]              @relation("DriveNodeDeletedBy")
  driveGrants             DriveGrant[]             @relation("DriveGrantUser")
  driveGrantsGiven        DriveGrant[]             @relation("DriveGrantGivenBy")
  driveVersions           DriveFileVersion[]
  driveFavorites          DriveFavorite[]
  tasksCreated            Task[]                   @relation("TaskCreatedBy")
  taskAssignments         TaskAssignee[]
  taskComments            TaskComment[]
  outboundMessages        OutboundMessage[]
  templateEdits           NotificationTemplate[]
  kbArticles              KbArticle[]
  apiKeys                 ApiKey[]
  webhooks                Webhook[]
  interviewsAsCandidate   Interview[]              @relation("InterviewCandidate")
  interviewsAsStaff       Interview[]              @relation("InterviewStaff")
  interviewsCreated       Interview[]              @relation("InterviewCreatedBy")
  interviewInvites        InterviewInvite[]        @relation("InterviewInviteCandidate")
  statusText              String?                  @db.VarChar(120) // workspace presence: "In a meeting", …
  statusEmoji             String?                  @db.VarChar(16)
  statusUntil             DateTime?
  mailAccounts            MailAccount[]
  mailLabels              MailLabel[]
  mailRules               MailRule[]
  mailTemplates           MailTemplate[]
  chatChannelsCreated     ChatChannel[]            @relation("ChatChannelCreatedBy")
  chatMemberships         ChatMember[]
  chatMessages            ChatMessage[]
  chatReactions           ChatReaction[]
  calendarEvents          CalendarEvent[]          @relation("CalendarEventOwner")
  calendarAttendance      CalendarAttendee[]
  contactsCreated         Contact[]                @relation("ContactCreatedBy")
  contactLinks            Contact[]                @relation("ContactUser")
  announcements           Announcement[]
  announcementReads       AnnouncementRead[]
  notes                   Note[]
  polls                   Poll[]
  pollVotes               PollVote[]
  leaveRequests           LeaveRequest[]           @relation("LeaveUser")
  leaveDecisions          LeaveRequest[]           @relation("LeaveDecidedBy")
  referredByAgentId       String? // agent whose link / code the client signed up with
  referredByAgent         Agent?                   @relation("AgentReferrals", fields: [referredByAgentId], references: [id], onDelete: SetNull)
  referredAt              DateTime?
  /// Referral partner who owns this client (signed up with the partner's link / code, or registered by the
  /// partner). Locked once set: only ADMIN+ reassign it (PartnerClientChange keeps the history).
  ownerPartnerId          String?
  ownerPartner            ReferralPartner?         @relation("PartnerOwnedClients", fields: [ownerPartnerId], references: [id], onDelete: SetNull)
  ownerPartnerAt          DateTime?
  agentProfile            Agent?                   @relation("AgentUser")
  agentCommissions        AgentCommission[]        @relation("CommissionClient")
  translationOrders       TranslationOrder[]       @relation("TranslationClient")
  translationAssigned     TranslationOrder[]       @relation("TranslationStaff")
  translationEvents       TranslationOrderEvent[]
  consents                ConsentRecord[]
  privacyRequests         PrivacyRequest[]         @relation("PrivacyRequester")
  privacyHandled          PrivacyRequest[]         @relation("PrivacyHandler")
  cv                      CandidateCv?
  motivationLetters       MotivationLetter[]
  vaultDocuments          VaultDocument[]
  arrivalPlans            ArrivalPlan[]            @relation("ArrivalClient")
  arrivalPlansHandled     ArrivalPlan[]            @relation("ArrivalStaff")
  surveys                 SatisfactionSurvey[]     @relation("SurveyClient")
  surveysAbout            SatisfactionSurvey[]     @relation("SurveyStaff")
  driveLocks              DriveNode[]              @relation("DriveNodeLockedBy")
  driveComments           DriveComment[]           @relation("DriveCommentAuthor")
  driveShareLinks         DriveShareLink[]         @relation("DriveShareCreatedBy")
  driveActivities         DriveActivity[]          @relation("DriveActivityActor")
  referralPartner         ReferralPartner?         @relation("PartnerUser")
  contractTemplates       ContractTemplate[]
  candidateRequests       CandidateRequest[]
  signatureRequests       SignatureRequest[]       @relation("SignatureRequestCreatedBy")
  signatureSignings       SignatureSigner[]        @relation("SignatureSignerUser")
  aiConversations         AiConversation[]
  aiActions               AiAction[]
  candidateProfiles       CandidateProfileDraft[]
  timeEntries             TimeEntry[]              @relation("TimeEntryUser") // staff time tracking
  /// Marketing consent for campaigns (UWG § 7 / DSGVO Art. 7): current state, when and where it was set
  /// (REGISTER | PROFILE | PRIVACY_CENTER | UNSUBSCRIBE). Every change is also logged in ConsentRecord (MARKETING_EMAIL).
  marketingOptIn          Boolean                  @default(false)
  marketingOptInAt        DateTime?
  marketingOptInSource    String?                  @db.VarChar(40)
  campaignSegments        CampaignSegment[]        @relation("CampaignSegmentCreatedBy")
  campaignsCreated        Campaign[]               @relation("CampaignCreatedBy")
  campaignRecipients      CampaignRecipient[]      @relation("CampaignRecipientUser")
  quotesCreated           Quote[]                  @relation("QuoteCreatedBy")
  /// Duplicate merge (lib/userMerge.ts): this account was merged into another one and is closed.
  mergedIntoId            String?
  mergedInto              User?                    @relation("UserMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom              User[]                   @relation("UserMergedInto")
  mergedAt                DateTime?
  duplicatesA             DuplicatePair[]          @relation("DuplicateA")
  duplicatesB             DuplicatePair[]          @relation("DuplicateB")
  /// Messaging plus: show messages in their original language instead of the automatic translation.
  showOriginalMessages    Boolean                  @default(false)
  partyThreadsAsCandidate PartyThread[]            @relation("PartyThreadCandidate")
  partyThreadsCreated     PartyThread[]            @relation("PartyThreadCreatedBy")
  partyThreadMembers      PartyThreadMember[]      @relation("PartyThreadMemberUser")
  partyThreadMessages     PartyThreadMessage[]     @relation("PartyThreadMessageAuthor")
  voiceClips              VoiceClip[]              @relation("VoiceClipUploader")
  germanPlan              GermanPlan?              @relation("GermanPlanUser")
  germanCourses           GermanCourse[]           @relation("GermanCourseUser")
  germanExams             GermanExam[]             @relation("GermanExamUser")
  germanWordProgress      GermanWordProgress[]     @relation("GermanWordProgressUser")
  germanPracticeDays      GermanPracticeDay[]      @relation("GermanPracticeDayUser")
  germanTestAttempts      GermanTestAttempt[]      @relation("GermanTestAttemptUser")
  referralCode            ClientReferralCode?      @relation("ReferralCodeOwner")
  referralsMade           ClientReferral[]         @relation("ReferralReferrer")
  referredBy              ClientReferral?          @relation("ReferralReferred")
  skillVideos             SkillVideo[]             @relation("SkillVideoOwner")

  @@index([companyId])
  @@index([mergedIntoId])
  @@index([ownerPartnerId])
}

/// Server-side login session. The JWT only carries the session id, so a session can be revoked
/// (logout, password change, admin action) and expires after `expiresAt` or a period of inactivity.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client     String // web | mobile
  ip         String?
  userAgent  String?   @db.Text
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// Security-relevant actions (user management, permissions, document changes, session revocations).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ─── Staff document workspace (/docs/<user>) ───────────────────────────

enum DocAccess {
  VIEW // list and preview in the browser
  DOWNLOAD // VIEW + download/export
  EDIT // DOWNLOAD + upload, replace, rename, move, delete
}

/// One workspace per staff member, stored on disk at <DOCS_DIR>/<slug>/.
model DocFolder {
  id        String     @id @default(cuid())
  ownerId   String     @unique
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug      String     @unique
  createdAt DateTime   @default(now())
  files     DocFile[]
  dirs      DocDir[]
  grants    DocGrant[]
}

/// A sub-directory inside a workspace (kept so empty directories survive). `path` is relative, "/"-separated.
model DocDir {
  id        String    @id @default(cuid())
  folderId  String
  folder    DocFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  path      String
  createdAt DateTime  @default(now())

  @@unique([folderId, path])
}

model DocFile {
  id           String    @id @default(cuid())
  folderId     String
  folder       DocFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  path         String // directory inside the workspace, "" for the root
  name         String // file name on disk
  mimeType     String
  size         Int
  version      Int       @default(1)
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([folderId, path, name])
  @@index([folderId, path])
}

/// What another staff member may do inside a workspace. Granted by the super admin.
model DocGrant {
  id          String    @id @default(cuid())
  folderId    String
  folder      DocFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("GrantUser", fields: [userId], references: [id], onDelete: Cascade)
  access      DocAccess
  grantedById String?
  grantedBy   User?     @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([folderId, userId])
  @@index([userId])
}

/// Expo push token of a phone where the user is logged in to the mobile app.
model PushDevice {
  id         String   @id @default(cuid())
  token      String   @unique
  platform   String // ios | android
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─── Visa case workflow ────────────────────────────────────────────────

/// Kind of application the client starts (chosen instead of typing a profession).
enum VisaType {
  WORK // skilled work / employment visa (§18a, §18b, §19c …)
  AUSBILDUNG // vocational training (§16a)
  WEITERBILDUNG // further training / qualification measure for recognition (§16d)
  JOB_SEEKER // Chancenkarte / job seeker visa
  STUDY // university studies (§16b)
  FAMILY // family reunion
  TOURIST // Schengen visitor visa
}

/// Residence title held in Germany after arrival (Case.residenceTitleKind).
enum ResidenceTitleKind {
  RESIDENCE_PERMIT // Aufenthaltserlaubnis (§18a, §16a …)
  EU_BLUE_CARD // Blaue Karte EU (§18g)
}

enum CaseStatus {
  DOCUMENTS_PENDING // client uploads initial documents
  DOCUMENTS_REVIEW // client submitted, staff reviewing
  CONTRACT_SENT // staff sent contract, waiting for client signature
  CONTRACT_SIGNED // client signed, staff verifying
  EMBASSY_DOCUMENTS // client uploads embassy documents
  EMBASSY_REVIEW // client submitted embassy docs, staff reviewing
  APPOINTMENT_SCHEDULED // embassy appointment date set
  DECISION_PENDING // application lodged at the embassy, awaiting decision
  APPROVED
  REJECTED
  CANCELLED
}

enum DocStage {
  INITIAL
  EMBASSY
  CONTRACT
  CONTRACT_SIGNED
  VISA
  OTHER
}

enum DocStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Case {
  id                       String                @id @default(cuid())
  number                   String                @unique
  clientId                 String
  client                   User                  @relation("CaseClient", fields: [clientId], references: [id], onDelete: Cascade)
  assignedStaffId          String?
  assignedStaff            User?                 @relation("CaseStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  visaCategoryId           String?
  visaCategory             VisaCategory?         @relation(fields: [visaCategoryId], references: [id], onDelete: SetNull)
  profession               String
  visaType                 VisaType              @default(WORK) // what the client applies for: drives step names and expected durations
  status                   CaseStatus            @default(DOCUMENTS_PENDING)
  staffNote                String?               @db.Text // latest note visible to client (e.g. what to fix)
  appointmentAt            DateTime?
  appointmentPlace         String?               @db.Text
  decisionAt               DateTime?
  decisionReason           String?               @db.Text // rejection reason or approval remark
  visaValidFrom            DateTime?
  visaValidTo              DateTime?
  /// Residence title in Germany after arrival (Aufenthaltstitel); drives the renewal reminder.
  residenceTitleExpiresAt  DateTime?
  /// Which title it is (null = an ordinary Aufenthaltserlaubnis) and the health insurance end date (lib/permits reminders).
  residenceTitleKind       ResidenceTitleKind?
  healthInsuranceExpiresAt DateTime?
  /// Renewal case: the case this one renews (plain id) / when the renewal case for this one was opened.
  renewalOfCaseId          String?               @db.VarChar(40)
  renewalCaseCreatedAt     DateTime?
  probationReminderAt      DateTime?
  cancelReason             String?               @db.Text
  companyId                String? // employer this candidate is placed with (company portal visibility)
  company                  Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vacancyId                String?
  vacancy                  Vacancy?              @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  // Family reunion (Familiennachzug): member cases hang under the main applicant's case.
  parentCaseId             String?
  parentCase               Case?                 @relation("CaseFamily", fields: [parentCaseId], references: [id], onDelete: SetNull)
  familyMembers            Case[]                @relation("CaseFamily")
  relation                 String? // spouse | child | parent (for member cases)
  closedAt                 DateTime? // set when the case reaches APPROVED / REJECTED / CANCELLED
  documentsPurgedAt        DateTime? // DSGVO retention: files deleted after the retention period
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  requirements             DocumentRequirement[]
  documents                Document[]
  contract                 Contract?
  events                   CaseEvent[]
  messages                 CaseMessage[]
  notifications            Notification[]
  tasks                    Task[]
  outboundMessages         OutboundMessage[]
  onboarding               CaseOnboarding[]
  mailMessages             MailMessage[]
  chatChannels             ChatChannel[]
  calendarEvents           CalendarEvent[]
  agentCommissions         AgentCommission[]
  translationOrders        TranslationOrder[]
  arrivalPlan              ArrivalPlan?
  motivationLetters        MotivationLetter[]
  surveys                  SatisfactionSurvey[]
  signatureRequests        SignatureRequest[]
  originals                OriginalDocument[]
  settlements              SettlementEntry[]
  aiRuns                   CaseAiRun[]
  aiFindingStates          CaseAiFindingState[]
  costs                    CaseCost[] // manual costs for the profitability view (lib/profitability)
  partyThread              PartyThread?          @relation("PartyThreadCase")
  timeEntries              TimeEntry[] // staff time tracking (lib/timeTracking)
  arrivalFollowUp          ArrivalFollowUp? // post-arrival check-ins (lib/checkIns)
  familyProfiles           FamilyMember[]        @relation("FamilyMemberMain") // members of this main case (details)
  familyProfile            FamilyMember?         @relation("FamilyMemberCase") // this case is a member's case
  familyReunionInfo        FamilyReunionInfo?    @relation("FamilyReunionInfo") // main applicant's title / flat / income for the reunion check
  clientTasks              ClientTask[] // to-dos the team gives the client (lib/clientProcess)
  officeVisits             Booking[] // office visits booked from the portal (lib/clientProcess)
  caseForms                CaseForm[] // smart questionnaires (lib/clientData)
  dataConfirmations        DataConfirmation[] // client confirms the embassy data (lib/clientData)
  dataValues               CaseDataValue[] // client-provided VIDEX values (lib/clientData)
  housing                  CaseHousing? // housing search checklist + Anmeldung (lib/housing)
  housingProposals         HousingProposal[] // partner landlord listings proposed to the client (lib/housing)
  /// Partner (middleman) who brought this client; their folder in the shared drive holds the client folder.
  partnerId                String?
  partner                  ReferralPartner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  /// The client's real folder in the shared drive ("Ad Soyad · Pass-Nr."), created with the case.
  driveFolderId            String?               @unique
  /// Extra columns of the client register (admin-defined), keyed by ClientRegisterColumn.id.
  registerData             Json?
  /// Team document workflow (lib/caseProcessing): null = "In Bearbeitung" (default) | IN_PROGRESS | WRITTEN ("Schon geschrieben") | DONE ("Fertig") | REFUSED ("Ablehnung").
  processingStage          String?               @db.VarChar(16)
  processingStageAt        DateTime?
  processingStageById      String?               @db.VarChar(40)
  /// Staff member who should take the next step (gets a notification and a "my work" item).
  processingAssigneeId     String?               @db.VarChar(40)
  processingMoves          CaseProcessingMove[]

  @@index([clientId])
  @@index([status])
  @@index([companyId])
  @@index([closedAt])
  @@index([parentCaseId])
  @@index([partnerId])
  @@index([processingStage])
  @@index([processingAssigneeId])
}

model DocumentRequirement {
  id          String       @id @default(cuid())
  key         String? // stable id from the template (e.g. PASSPORT, LANGUAGE_CERT) for automations
  caseId      String
  case        Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage       DocStage
  title       Json
  description Json?
  required    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  documents   Document[]
  clientTasks ClientTask[] // tasks completed by an upload to this requirement

  @@index([caseId, stage])
}

model Document {
  id               String               @id @default(cuid())
  caseId           String
  case             Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requirementId    String?
  requirement      DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  stage            DocStage
  originalName     String
  storedName       String               @unique
  mimeType         String
  size             Int
  status           DocStatus            @default(PENDING)
  reviewNote       String?              @db.Text
  ocr              Json? // fields extracted from the file (passport MRZ: number, names, birthDate, expiry…)
  ocrAt            DateTime?
  checks           Json? // automatic quality checks right after upload (blur, darkness, cut-off, type, expiry)
  checkedAt        DateTime?
  vaultDocumentId  String? // copied from the client's document vault
  expiresAt        DateTime? // validity end (passport, diploma copy, certificates) — from OCR or set by staff
  expiryRemindedAt DateTime? // last expiry warning sent
  uploadedById     String
  uploadedBy       User                 @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime             @default(now())
  /// Biometric photo check result (passport photo rules: size, ratio, background, face area …).
  photoCheck       Json?
  /// Staff marks on a rejected scan shown to the client: [{ page, x, y, w, h (0–1), note }].
  reviewMarks      Json?

  @@index([caseId, stage])
}

model Contract {
  id                 String    @id @default(cuid())
  caseId             String    @unique
  case               Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileDocumentId     String // unsigned contract (Document with stage CONTRACT)
  signedDocumentId   String? // signed PDF produced by the server (Document with stage CONTRACT_SIGNED)
  signerName         String?
  signedAt           DateTime?
  signerIp           String?
  signerUserAgent    String?   @db.Text
  sentAt             DateTime  @default(now())
  version            Int       @default(1)
  signatureRequestId String? // set when this version is signed through the multi-party module (SignatureRequest.id)
}

model CaseEvent {
  id              String      @id @default(cuid())
  caseId          String
  case            Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type            String // e.g. STATUS_CHANGED, DOCUMENT_UPLOADED, DOCUMENT_REVIEWED, CONTRACT_SIGNED
  fromStatus      CaseStatus?
  toStatus        CaseStatus?
  note            String?     @db.Text
  actorId         String?
  actor           User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  visibleToClient Boolean     @default(true)
  createdAt       DateTime    @default(now())

  @@index([caseId, createdAt])
  @@index([createdAt])
}

model CaseMessage {
  id           String               @id @default(cuid())
  caseId       String
  case         Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId     String
  author       User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body         String               @db.Text
  channel      String               @default("app") // app | whatsapp | sms
  externalId   String?              @unique // provider message id (WhatsApp), for de-duplication
  readAt       DateTime? // when the other side opened it (read receipt)
  lang         Locale? // detected language of the text (messaging plus: automatic translation)
  voiceId      String?              @unique // voice message (VoiceClip); body is then empty
  voice        VoiceClip?           @relation("CaseMessageVoice", fields: [voiceId], references: [id], onDelete: SetNull)
  translations MessageTranslation[]
  createdAt    DateTime             @default(now())

  @@index([caseId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String?
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @db.Text
  link      String?   @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String   @db.Text
  status    String // SENT | FAILED | CONSOLE
  error     String?  @db.Text
  createdAt DateTime @default(now())
}

// ─── Website content (CMS) ─────────────────────────────────────────────

model VisaCategory {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  icon                 String // lucide icon name
  image                String                @db.Text
  visaLabel            String // e.g. "§18b", "§16d", "Saisonarbeit"
  title                Json
  summary              Json
  items                Json // { az: string[], de: string[], ... }
  body                 Json // long description per locale
  // Structured details for the visa page (all optional; figures are indicative and editable in the CMS)
  germanLevel          String? // e.g. "A2", "B1"
  salaryMin            Int? // EUR gross per month
  salaryMax            Int?
  processingMin        Int? // weeks
  processingMax        Int?
  familyReunion        Boolean?
  requirements         Json? // L10nList
  documents            Json? // L10nList
  faq                  Json? // { q: L10n, a: L10n }[]
  forecast             Json? // optional per-step expected days { DOCUMENTS: [min,max], CONTRACT: …, EMBASSY: …, APPOINTMENT: …, DECISION: … }
  sortOrder            Int                   @default(0)
  published            Boolean               @default(true)
  seoTitle             Json? // L10n override of <title>
  seoDescription       Json? // L10n override of the meta description
  ogImage              String?               @db.Text
  noindex              Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  cases                Case[]
  vacancies            Vacancy[]
  requirementTemplates RequirementTemplate[]
}

model Service {
  id             String   @id @default(cuid())
  slug           String   @unique
  icon           String // lucide icon name
  image          String   @db.Text
  audience       String   @default("all") // all | company | candidate
  title          Json
  summary        Json
  body           Json // long description per locale, paragraphs separated by blank lines
  features       Json // { az: string[], ... } what is included
  steps          Json? // L10nList: service-specific "how it works" steps
  duration       Json? // L10n, e.g. "2–4 weeks"
  sortOrder      Int      @default(0)
  published      Boolean  @default(true)
  seoTitle       Json? // L10n override of <title>
  seoDescription Json? // L10n override of the meta description
  ogImage        String?  @db.Text
  noindex        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Partner {
  id          String  @id @default(cuid())
  name        String
  logo        String? @db.Text // URL; if empty the name is rendered as a wordmark
  website     String? @db.Text
  sector      String? // logistics | courier | industry | construction | hospitality | healthcare | agriculture | other
  city        String? // German location shown on the partners map
  description Json? // L10n
  featured    Boolean @default(false)
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model VisaSample {
  id         String  @id @default(cuid())
  image      String  @db.Text
  profession Json
  visaLabel  String
  dateLabel  Json
  sortOrder  Int     @default(0)
  published  Boolean @default(true)
}

model Testimonial {
  id         String  @id @default(cuid())
  quote      Json
  author     Json
  role       Json
  kind       String  @default("company") // company | candidate
  sortOrder  Int     @default(0)
  published  Boolean @default(true)
  /// Video success story: YouTube/Vimeo link or uploaded file, plus filters for the stories page.
  videoUrl   String? @db.Text
  posterUrl  String? @db.Text
  profession String? @db.VarChar(120)
  country    String? @db.VarChar(40) // origin country code: AZ | TR | UA …
  city       String? @db.VarChar(80) // German city
