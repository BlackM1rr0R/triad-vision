// ─── Team workspace: chat ───────────────────────────────────────────────

enum ChatChannelKind {
  PUBLIC
  PRIVATE
  DM
}

enum ChatMemberRole {
  OWNER
  MEMBER
}

model ChatChannel {
  id          String          @id @default(cuid())
  kind        ChatChannelKind
  name        String?         @db.VarChar(80) // null for DMs
  topic       String?         @db.VarChar(250)
  caseId      String? // channel opened for a visa case
  case        Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?           @relation("ChatChannelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ChatMember[]
  messages    ChatMessage[]
  polls       Poll[]

