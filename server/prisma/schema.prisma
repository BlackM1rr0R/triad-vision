}

enum SurveyTrigger {
  VISA_APPROVED
  CASE_CLOSED // rejected or cancelled
}

/// Short satisfaction survey sent to the client when the visa is approved or the case is closed.
model SatisfactionSurvey {
  id         String        @id @default(cuid())
  caseId     String        @unique
  case       Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientId   String
  client     User          @relation("SurveyClient", fields: [clientId], references: [id], onDelete: Cascade)
  staffId    String? // assigned staff member at the time (results per employee)
  staff      User?         @relation("SurveyStaff", fields: [staffId], references: [id], onDelete: SetNull)
  trigger    SurveyTrigger
  tokenHash  String        @unique @db.Char(64) // sha256 of the link token (answer without logging in)
  score      Int? // 0–10 recommendation score (NPS)
  ratings    Json? // { communication, speed, clarity, support } 1–5
  comment    String?       @db.Text
  sentAt     DateTime      @default(now())
  remindedAt DateTime?
  answeredAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([answeredAt])
  @@index([staffId, answeredAt])
}

enum ContractKind {
  WORK // Arbeitsvertrag
  AUSBILDUNG // Ausbildungsvertrag
  SERVICE // Dienstleistungsvertrag (Triad Vision ↔ client)
}

/// Contract template with {{placeholders}} filled from client / case / company data, then sent for e-signature.
model ContractTemplate {
  id          String       @id @default(cuid())
  name        String       @db.VarChar(160)
  kind        ContractKind
  language    String       @default("de") @db.VarChar(5)
  body        String       @db.LongText
  isDefault   Boolean      @default(false)
  active      Boolean      @default(true)
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([kind, active])
}

enum CandidateRequestStatus {
  OPEN
  IN_PROGRESS
  FILLED
  CANCELLED
}

/// Employer's bulk request ("we need 10 truck drivers"); staff match and propose candidates.
model CandidateRequest {
  id             String                 @id @default(cuid())
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title          String                 @db.VarChar(200)
  profession     String                 @db.VarChar(120)
  quantity       Int
  visaCategoryId String?
  germanLevel    String?                @db.VarChar(4)
  drivingLicence String?                @db.VarChar(40)
  minExperience  Int?
  city           String?                @db.VarChar(80)
  startDate      DateTime?
  salaryMin      Int?
  salaryMax      Int?
  notes          String?                @db.Text
  status         CandidateRequestStatus @default(OPEN)
  vacancyId      String? // vacancy created from the request (candidates are proposed through it)
  staffNote      String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([companyId, status])
  @@index([status, createdAt])
}

// ─── Shared documents: partners (middlemen) and the client register ─────────

/// Person who brings clients and cooperates on visas (e.g. Ilqar, Ənvər); own folder in the shared drive.
model ReferralPartner {
  id                String              @id @default(cuid())
  name              String              @unique @db.VarChar(120)
  phone             String?             @db.VarChar(40)
  email             String?             @db.VarChar(191)
  note              String?             @db.Text
  active            Boolean             @default(true)
  /// Login of the partner for the partner portal (own clients, commissions, uploads).
  userId            String?             @unique
  user              User?               @relation("PartnerUser", fields: [userId], references: [id], onDelete: SetNull)
  /// Default commission per client in cents (copied into each new commission row).
  commissionCents   Int?
  currency          String              @default("EUR") @db.VarChar(3)
  /// Personal sign-up code (/register?ref=CODE, short /p/CODE): clients who use it belong to the partner.
  code              String?             @unique @db.VarChar(32)
  /// When the automatic commission of a case is created: ASSIGNED (the case gets the partner) | CONTRACT_SIGNED | VISA_APPROVED.
  commissionTrigger String              @default("ASSIGNED") @db.VarChar(20)
  /// What the portal shows of the clients: MINIMAL (masked) | EXTENDED (contacts + payments, only for clients who consented).
  visibility        String              @default("MINIMAL") @db.VarChar(12)
  // Profile (lib/partners/profile.ts): all optional; bank data only ADMIN+ (masked / hidden for staff).
  /// INDIVIDUAL | COMPANY
  partnerType       String              @default("INDIVIDUAL") @db.VarChar(12)
  companyName       String?             @db.VarChar(160)
  contactPerson     String?             @db.VarChar(120)
  phone2            String?             @db.VarChar(40)
  whatsapp          String?             @db.VarChar(40)
  address           String?             @db.VarChar(255)
  city              String?             @db.VarChar(120)
  country           String?             @db.VarChar(80)
  /// VÖEN / Steuernummer (mask group TAX_ID).
  taxId             String?             @db.VarChar(40)
  bankName          String?             @db.VarChar(120)
  bankAccountHolder String?             @db.VarChar(120)
  /// Mask group IBAN; only ADMIN+ see or edit it.
  iban              String?             @db.VarChar(42)
  bic               String?             @db.VarChar(11)
  contractStart     DateTime?           @db.Date
  contractEnd       DateTime?           @db.Date
  /// az | de | en | ru | tr
  preferredLanguage String?             @db.VarChar(5)
  website           String?             @db.VarChar(255)
  /// string[]
  tags              Json?
  /// Values of the admin-defined fields: { [PartnerFieldDef.id]: string | number | boolean }.
  customData        Json?
  /// The partner's own extra fields: [{ label, value }].
  extraFields       Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cases             Case[]
  commissions       PartnerCommission[]
  settlements       SettlementEntry[]
  ownedClients      User[]              @relation("PartnerOwnedClients")
}

/// History of client ownership by referral partners (sign-up link, partner registration, admin reassignment).
model PartnerClientChange {
  id            String   @id @default(cuid())
  userId        String   @db.VarChar(40)
  fromPartnerId String?  @db.VarChar(40)
  toPartnerId   String?  @db.VarChar(40)
  source        String   @db.VarChar(24) // SIGNUP_LINK | PARTNER_PORTAL | ADMIN
  actorId       String?  @db.VarChar(40)
  note          String?  @db.VarChar(500)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([toPartnerId])
}

enum RegisterColumnType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

/// Extra (admin-defined) column of the Excel-like client register; values live in Case.registerData.
model ClientRegisterColumn {
  id        String             @id @default(cuid())
  label     String             @db.VarChar(80)
  type      RegisterColumnType @default(TEXT)
  options   Json? // SELECT choices: string[]
  width     Int                @default(160)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

/// Admin-defined extra field of every referral partner form; values live in ReferralPartner.customData.
model PartnerFieldDef {
  id        String   @id @default(cuid())
  label     String   @db.VarChar(80)
  /// TEXT | LONG_TEXT | NUMBER | DATE | SELECT | CHECKBOX
  type      String   @default("TEXT") @db.VarChar(12)
  options   Json? // SELECT choices: string[]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Drive collaboration: comments, share links, activity; partner commissions ─

/// Comment on a drive file or folder; @mentions notify staff; can be turned into a task.
model DriveComment {
  id         String    @id @default(cuid())
  nodeId     String
  node       DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?     @relation("DriveCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parentId   String? // reply to another comment
  body       String    @db.Text
  mentions   Json? // user ids
  taskId     String? // task created from this comment
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([nodeId, createdAt])
}

/// Link to share a file/folder with an outside person (employer, translator): expiry, optional password.
model DriveShareLink {
  id           String             @id @default(cuid())
  nodeId       String
  node         DriveNode          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tokenHash    String             @unique @db.Char(64)
  passwordHash String?
  label        String?            @db.VarChar(160) // who it is for
  expiresAt    DateTime
  maxDownloads Int?
  downloads    Int                @default(0)
  allowUpload  Boolean            @default(false)
  createdById  String?
  createdBy    User?              @relation("DriveShareCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?
  createdAt    DateTime           @default(now())
  accesses     DriveShareAccess[]

  @@index([nodeId])
}

/// Every opening / download through a share link (who opened it and when).
model DriveShareAccess {
  id        String         @id @default(cuid())
  linkId    String
  link      DriveShareLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  action    String         @db.VarChar(20) // VIEW | DOWNLOAD | UPLOAD | BAD_PASSWORD
  fileName  String?        @db.VarChar(255)
  ip        String?        @db.VarChar(64)
  userAgent String?        @db.VarChar(255)
  createdAt DateTime       @default(now())

  @@index([linkId, createdAt])
}

/// Activity journal of the drive: who uploaded, moved, renamed, deleted… what and when (per folder).
model DriveActivity {
  id        String   @id @default(cuid())
  nodeId    String? // the item (kept as a plain id: the item may be purged later)
  folderId  String? // the folder the action happened in (for the per-folder journal)
  actorId   String?
  actor     User?    @relation("DriveActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(40) // UPLOAD | NEW_VERSION | MOVE | RENAME | DELETE | RESTORE | CREATE_FOLDER | COPY | SHARE | COMMENT | LOCK …
  name      String   @db.VarChar(255) // item name at that moment
  meta      Json?
  createdAt DateTime @default(now())

  @@index([folderId, createdAt])
  @@index([nodeId, createdAt])
  @@index([actorId, createdAt])
}

/// Commission owed to a referral partner for a client (amount per client, paid or not).
model PartnerCommission {
  id                String           @id @default(cuid())
  partnerId         String
  partner           ReferralPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  caseId            String?
  amountCents       Int
  currency          String           @default("EUR") @db.VarChar(3)
  status            CommissionStatus @default(PENDING)
  note              String?          @db.VarChar(500)
  dueAt             DateTime?
  paidAt            DateTime?
  createdById       String?
  /// Set when the commission comes from a settlement (Hesablaşma) row — kept in sync with its partner share.
  settlementEntryId String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([partnerId, caseId])
  @@index([partnerId, status])
  @@index([status, createdAt])
}

// ─── Settlements (Hesablaşmalar): who brought the client, what was paid, how it is split ─

enum SettlementStage {
  NEW // blue in the old Excel: not started
  IN_PROGRESS // yellow: TLS appointment / waiting
  VISA // green: visa issued
  REFUSED // red: refusal ("atkaz")
  CANCELLED
}

/// One client row of the settlement ledger (mirrors the team's Excel: Zwischen Person, Name, Transporte,
/// Status TLS/…-viza/…, Bezahlung, partner share, owner shares, team, expenses). Linked to a case when known.
model SettlementEntry {
  id                   String           @id @default(cuid())
  project              String           @default("Ümumi") @db.VarChar(80) // sheet / project: "Proyekt 2", "Privat" …
  caseId               String?
  case                 Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull)
  partnerId            String? // Zwischen Person
  partner              ReferralPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  clientName           String           @db.VarChar(160)
  licence              String?          @db.VarChar(20) // CE, BC … (from "(CE)" in the name)
  employer             String?          @db.VarChar(160) // Transporte
  tlsDate              DateTime? // TLS appointment
  visaDate             DateTime? // visa issued
  stage                SettlementStage  @default(NEW)
  stageAuto            Boolean          @default(true) // follow the linked case automatically
  amountCents          Int? // Bezahlung (total agreed)
  currency             String           @default("AZN") @db.VarChar(3) // AZN | EUR
  payAfterVisa         Boolean          @default(false) // "viza sonrası"
  paidCents            Int              @default(0) // received so far
  partnerShareCents    Int? // the middleman's commission (Sanani)
  partnerShareCurrency String           @default("EUR") @db.VarChar(3)
  expensesCents        Int? // Rasxod
  /// Shares per beneficiary id: { [beneficiaryId]: { cents, currency, status: "PENDING"|"PAID"|"NONE", text?, manual? } }
  shares               Json?
  note                 String?          @db.Text
  sortOrder            Int              @default(0)
  createdById          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([project, sortOrder])
  @@index([partnerId])
  @@index([caseId])
  @@index([stage])
}

enum BeneficiaryRule {
  THIRD_OF_NET // net ÷ 3 (Xalid)
  PERCENT_OF_NET // value = basis points of net
  FIXED // value = cents in currency (Team 200 AZN)
  REMAINDER // what is left, split equally between all REMAINDER beneficiaries (Tofiq, Abdulla)
}

/// Who receives a share of each payment and by which rule (configurable; default Xalid / Tofiq / Abdulla / Team).
model SettlementBeneficiary {
  id        String          @id @default(cuid())
  name      String          @unique @db.VarChar(80)
  rule      BeneficiaryRule @default(REMAINDER)
  value     Int             @default(0)
  currency  String?         @db.VarChar(3) // for FIXED
  userId    String? // the team member, if any
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// ─── AI assistant (OpenRouter): clients ask about their application, the super admin manages documents ─

enum AiScope {
  CLIENT // a client asking about their own application
  ADMIN // the super admin operating the drive, spreadsheets, settlements …
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     AiScope
  title     String?     @db.VarChar(200)
  model     String?     @db.VarChar(120)
  context   Json? // where it was opened: { nodeId?, folderId?, caseId?, page? }
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]
  actions   AiAction[]

  @@index([userId, scope, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         @db.VarChar(12) // user | assistant | tool
  content        String?        @db.LongText
  toolCalls      Json? // assistant tool calls [{id, name, arguments}]
  toolCallId     String?        @db.VarChar(80) // for role = tool
  toolName       String?        @db.VarChar(80)
  model          String?        @db.VarChar(120)
  tokensIn       Int            @default(0)
  tokensOut      Int            @default(0)
  costMicros     Int            @default(0) // USD × 1,000,000 as reported by OpenRouter
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

enum AiActionStatus {
  PENDING // proposed by the assistant, waiting for the user's confirmation
  DONE
  REJECTED
  FAILED
  EXPIRED
}

/// A change the assistant wants to make (move/delete/rename files, edit cells …): runs only after the user confirms.
model AiAction {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCallId     String?        @db.VarChar(80)
  tool           String         @db.VarChar(80)
  args           Json
  summary        String         @db.Text // human sentence shown on the confirm card
  status         AiActionStatus @default(PENDING)
  result         Json?
  createdAt      DateTime       @default(now())
  decidedAt      DateTime?

  @@index([conversationId, status])
}

// ─── Document organisation: tags, workflow board, smart folders, folder templates; physical originals ─

enum DocWorkflowStage {
  INCOMING // Gələn
  REVIEW // Yoxlanılır
  TRANSLATION // Tərcümədə
  APOSTILLE // Apostildə
  READY // Hazır
  SENT_TO_EMBASSY // Səfirliyə göndərildi
}

model DriveTag {
  id        String         @id @default(cuid())
  name      String         @unique @db.VarChar(60)
  color     String         @default("amber") @db.VarChar(20)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  nodes     DriveNodeTag[]
}

model DriveNodeTag {
  nodeId    String
  node      DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tagId     String
  tag       DriveTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([nodeId, tagId])
  @@index([tagId])
}

/// Saved search ("Bu həftə yüklənən pasportlar"): private to its owner or shared with the team.
model DriveSmartFolder {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  ownerId   String?
  shared    Boolean  @default(false)
  icon      String?  @db.VarChar(30)
  query     Json // { text?, tags?, types?, stage?, uploadedWithin?, folderId?, … }
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// Sub-folders created inside every new client folder, per visa type and optionally per category.
model DriveFolderTemplate {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(120)
  visaType       VisaType?
  visaCategoryId String?
  folders        Json // ["Pasport", "Diplom", "Dil sertifikatı", …] (nested with "/")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum OriginalStatus {
  IN_OFFICE // in the safe / office
  GIVEN_OUT // handed to someone (staff, translator, authority)
  AT_APOSTILLE // sent for apostille / legalisation
  IN_TRANSIT // with a courier
  DELIVERED // arrived (e.g. at the employer / authority in Germany)
  RETURNED_TO_CLIENT
}

/// A physical original (passport, diploma …) the office holds or tracks for a client.
model OriginalDocument {
  id          String          @id @default(cuid())
  caseId      String
  case        Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title       String          @db.VarChar(160)
  kind        String          @db.VarChar(40) // PASSPORT | DIPLOMA | CERTIFICATE | BIRTH | MARRIAGE | OTHER
  status      OriginalStatus  @default(IN_OFFICE)
  location    String?         @db.VarChar(120) // safe / shelf, e.g. "Seyf A · rəf 3"
  holder      String?         @db.VarChar(160) // who has it now when given out
  carrier     String?         @db.VarChar(60)
  trackingNo  String?         @db.VarChar(80)
  note        String?         @db.Text
  receivedAt  DateTime        @default(now())
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  events      OriginalEvent[]

  @@index([caseId])
  @@index([status])
}

/// Every movement of an original: received, stored, given out, sent to apostille, back, courier, delivered, returned.
model OriginalEvent {
  id         String           @id @default(cuid())
  originalId String
  original   OriginalDocument @relation(fields: [originalId], references: [id], onDelete: Cascade)
  action     String           @db.VarChar(30)
  status     OriginalStatus
  location   String?          @db.VarChar(120)
  holder     String?          @db.VarChar(160)
  carrier    String?          @db.VarChar(60)
  trackingNo String?          @db.VarChar(80)
  note       String?          @db.Text
  actNodeId  String? // drive file of the signed hand-over act (Qəbul-təhvil aktı)
  actorId    String?
  at         DateTime         @default(now())

  @@index([originalId, at])
}

// ─── Employer AI tools ────────────────────────────────────────────────

/// German candidate profile ("Kandidatenprofil") for an employer, drafted by AI from anonymised data and
/// edited by staff. One per application (or several candidate-level drafts without a vacancy). Visible in the
/// employer portal once `sharedAt` is set ("Propose to employer") and the application is employer-visible.
model CandidateProfileDraft {
  id            String              @id @default(cuid())
  applicationId String?             @unique
  application   VacancyApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancyId     String?
  language      String              @default("de") @db.VarChar(5) // de | en
  content       Json // {headline, summary, experience[], languages[], licences[], education, availability, whyFit[], openPoints[]}
  model         String?             @db.VarChar(120)
  costMicros    Int                 @default(0)
  createdById   String?
  sharedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId])
}

// ─── Case AI checks (consistency, contract, VIDEX) ──────────────────────

enum CaseAiKind {
  CONSISTENCY
  CONTRACT
  VIDEX
}

enum CaseAiFindingStatus {
  OK
  FIXED
  IGNORED
}

/// One click on an AI case check (lib/ai/features/caseAi): the structured result the staff member works through.
/// The model only proposes; changes are applied by staff through the case AI routes (audited, in the timeline).
model CaseAiRun {
  id          String     @id @default(cuid())
  caseId      String
  case        Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind        CaseAiKind
  /// Document checked (contract check) when it was a case document.
  subjectId   String?    @db.VarChar(191)
  result      Json
  model       String?    @db.VarChar(120)
  costMicros  Int        @default(0)
  createdById String?    @db.VarChar(191)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([caseId, kind, createdAt])
}

/// Staff decision on one finding of a case AI check ("Mark as OK", fixed, ignored); survives re-runs by `key`.
model CaseAiFindingState {
  id     String              @id @default(cuid())
  caseId String
  case   Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind   CaseAiKind
  key    String              @db.VarChar(191)
  status CaseAiFindingStatus
  note   String?             @db.VarChar(300)
  byId   String?             @db.VarChar(191)
  at     DateTime            @default(now())

  @@unique([caseId, kind, key])
}

// ─── AI mail triage ───────────────────────────────────────────────────

enum MailTriageCategory {
  CANDIDATE
  EMPLOYER
  PARTNER
  EXISTING_CLIENT
  SUPPLIER
  SPAM
  OTHER
}

enum MailTriageUrgency {
  URGENT
  NORMAL
  LOW
}

enum MailTriageStatus {
  PENDING // queued / running
  NEW // analysed, waiting for a click
  ACTIONED // lead created, assigned, answered or marked as spam
  DISMISSED
  SKIPPED // auto-reply, bounce, own message (no AI call)
  FAILED // AI not available or unusable answer (see error)
}

/// AI triage of one incoming e-mail in a shared mailbox (info@…): category, urgency, summary, extracted
/// contact and a reply draft. The model only proposes; every action is a staff click (or an auto-action the
/// super admin switched on in the routing rules).
model MailTriage {
  id                  String              @id @default(cuid())
  messageId           String              @unique
  message             MailMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  accountId           String
  rfcMessageId        String?             @db.VarChar(500) // Message-ID header (dedupe across mailboxes)
  status              MailTriageStatus    @default(PENDING)
  category            MailTriageCategory?
  urgency             MailTriageUrgency?
  language            String?             @db.VarChar(8) // az | de | en | ru | other
  summary             Json? // { lang, text, en }
  contact             Json? // { name, email, phone, company, country }
  intent              String?             @db.VarChar(300)
  visaCategorySlug    String?             @db.VarChar(120)
  assigneeRole        String?             @db.VarChar(40)
  existingClient      Json? // resolved server-side: { userId, name, role, caseId, caseNumber }
  suggestedAssigneeId String?
  replyDraft          Json? // { language, subject, body }
  leadInquiryId       String?
  assignedToId        String?
  actions             Json? // [{ type, by, at, ... }]
  skipReason          String?             @db.VarChar(40)
  error               String?             @db.VarChar(120)
  model               String?             @db.VarChar(120)
  costMicros          Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([accountId, createdAt])
  @@index([rfcMessageId])
  @@index([status])
}

/// Weekly management report (lib/aiMgmt/report.ts): deterministic numbers for one Baku week (Mon–Sun) and the AI narrative per locale.
model ManagementReport {
  id         String   @id @default(cuid())
  weekStart  DateTime @unique // Monday 00:00 Asia/Baku of the reported week, as a UTC instant
  data       Json // numbers: this week vs the week before, stuck cases, staff metrics …
  narrative  Json? // { az?: { headline, highlights[], problems[], recommendations[{ text, metric }] }, de?: … }
  model      String?  @db.VarChar(120)
  costMicros Int      @default(0)
  sentTo     Int      @default(0) // e-mails sent by the Monday job
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Suspicious activity found by the deterministic rules in lib/aiMgmt/security (no AI needed for detection).
model SecurityAlert {
  id           String    @id @default(cuid())
  rule         String    @db.VarChar(40) // failedLoginsAccount | failedLoginsIp | newIpLogin | unusualHourLogin | bulkDownload | bulkDelete | twoFactorDisabled | roleEscalation | apiKeyCreated
  severity     String    @db.VarChar(8) // LOW | MEDIUM | HIGH
  status       String    @default("OPEN") @db.VarChar(16) // OPEN | ACKNOWLEDGED | FALSE_POSITIVE
  fingerprint  String    @db.VarChar(191) // rule + subject: dedupe and false-positive suppression
  userId       String? // the account concerned (plain id: kept when the user is deleted)
  ip           String?   @db.VarChar(64)
  facts        Json // structured facts shown in the UI and given to the AI
  eventIds     Json // audit / session ids already covered (an event never raises two alerts)
  hits         Int       @default(1)
  explanation  Json? // AI: { az?: { summary, actions[] }, … }
  actions      Json? // [{ action, by, at }]
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([fingerprint, lastSeenAt])
}

/// Smart uploads (lib/uploadAi): what a case document or a drive file in a client folder was recognised as
/// (type, fields, confidence), the proposals made from it (standard name, requirement, folder, expiry) and the
/// scan quality measured right after the upload. Proposals are advisory: nothing changes until staff accept
/// them (or the super admin's auto-apply setting does). Plain ids, no foreign keys (like the other AI rows).
model DocumentInsight {
  id                    String    @id @default(cuid())
  documentId            String?   @unique // case Document
  driveNodeId           String?   @unique // drive file (staff upload into a client folder)
  caseId                String? // the case the file belongs to (Document.caseId, or the case of the client folder)
  folderId              String? // drive: parent folder when analysed (bulk "accept all" per folder)
  uploadedById          String?
  sha256                String    @db.Char(64)
  docType               String    @default("OTHER") @db.VarChar(32) // PASSPORT | ID_CARD | DIPLOMA | … | OTHER
  fields                Json // { holderName, firstName, lastName, documentNumber, issueDate, expiryDate, birthDate, issuingCountry, issuingAuthority, language }
  confidence            Float     @default(0)
  source                String    @default("NONE") @db.VarChar(16) // MRZ | TEXT | FILENAME | AI | DOC_CHECK | CACHE | STAFF | NONE
  proposedName          String?   @db.VarChar(255)
  proposedRequirementId String?
  proposedFolderId      String?
  proposals             Json? // { actions[], folder: { parentId, name }, requirementTitle, currentName … }
  expiryDate            DateTime?
  flags                 Json? // ["NAME_MISMATCH", "EXPIRED", "EXPIRES_SOON", "WRONG_REQUIREMENT"]
  quality               Json? // { level, reasons[{ code, level, params }], metrics }
  qualityLevel          String?   @db.VarChar(8) // OK | WARN | BAD
  status                String    @default("PENDING") @db.VarChar(16) // PENDING | PROPOSED | ACCEPTED | REJECTED | AUTO_APPLIED | FAILED
  applied               Json? // [{ action, from, to }]
  clientAckAt           DateTime? // the client kept a file flagged as the wrong document ("upload anyway")
  model                 String?   @db.VarChar(120)
  costMicros            Int       @default(0)
  error                 String?   @db.VarChar(120)
  decidedById           String?
  decidedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([caseId, status])
  @@index([folderId, status])
  @@index([sha256])
}

// ─── Quotes (Angebote) for German employers ──────────────────────────

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

enum QuoteDiscountType {
  NONE
  PERCENT // discountValue in basis points (10 % = 1000)
  AMOUNT // discountValue in cents
}

/// Angebot (quote) to an employer, numbered TV-AN-YYYY-NNNN on first send. Items are
/// { description, quantity, unit (PERSON|PIECE|FLAT|MONTH), unitPriceCents, vatRate?, catalogueId?, convertedQty? }[].
/// The employer accepts or declines through a secret link (/angebot/:token) or the company portal.
model Quote {
  id             String            @id @default(cuid())
  number         String?           @unique @db.VarChar(32)
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vacancyId      String? // optional source vacancy (plain id; positions prefill the quantities)
  contactName    String?           @db.VarChar(160)
  contactEmail   String?           @db.VarChar(200)
  locale         String            @default("de") @db.VarChar(2) // e-mail language: de | en (the document is always German)
  title          String            @db.VarChar(200)
  salutation     String?           @db.VarChar(200)
  introText      String?           @db.Text
  closingText    String?           @db.Text
  items          Json
  discountType   QuoteDiscountType @default(NONE)
  discountValue  Int               @default(0)
  vatRate        Int               @default(19) // default rate for items without their own
  subtotalCents  Int               @default(0)
  discountCents  Int               @default(0)
  netCents       Int               @default(0)
  vatCents       Int               @default(0)
  grossCents     Int               @default(0)
  currency       String            @default("EUR") @db.VarChar(3)
  validUntil     DateTime // calendar day at 12:00 UTC
  paymentTerms   String?           @db.Text
  deliveryTerms  String?           @db.Text
  status         QuoteStatus       @default(DRAFT)
  tokenHash      String?           @unique @db.Char(64)
  tokenSealed    String?           @db.VarChar(255) // the link token, encrypted, so a resend keeps the same link
  sentAt         DateTime?
  viewedAt       DateTime?
  acceptedAt     DateTime?
  acceptedByName String?           @db.VarChar(160)
  acceptedIp     String?           @db.VarChar(64)
  acceptedUa     String?           @db.VarChar(1000)
  declinedAt     DateTime?
  declinedReason String?           @db.Text
  expiredAt      DateTime?
  convertedAt    DateTime?
  invoiceId      String?
  invoice        Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?             @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  events         QuoteEvent[]

  @@index([companyId, status])
  @@index([status, validUntil])
  @@index([invoiceId])
  @@index([createdById])
}

/// Audit trail of a quote: CREATED, UPDATED, SENT, RESENT, VIEWED, ACCEPTED, DECLINED, EXPIRED, REMINDED, CONVERTED, DUPLICATED.
model QuoteEvent {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(32)
  actorId   String? // staff or employer user; null for the public link and jobs
  actorName String?  @db.VarChar(160)
  note      String?  @db.Text
  meta      Json?
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([quoteId, createdAt])
}

/// Field-level change history (lib/history): one row per changed field of a tracked record (Case, User,
/// Company), written by the Prisma client extension in src/db.ts inside the same transaction as the update.
/// Sensitive values (passport number, VAT/tax id) are stored sealed with lib/secretBox ({ "$enc": "v1:…" }).
/// Plain ids, no foreign keys: history must survive the actor's or the record's deletion.
model FieldChange {
  id           String    @id @default(cuid())
  entity       String    @db.VarChar(16) // CASE | USER | COMPANY
  entityId     String    @db.VarChar(40)
  field        String    @db.VarChar(120) // dot path: status, assignedStaffId, registerData.<columnId>
  oldValue     Json?
  newValue     Json?
  actorId      String?   @db.VarChar(40)
  actorRole    String?   @db.VarChar(16)
  source       String    @default("system") @db.VarChar(16) // admin | client | system | ai | automation | revert
  requestId    String?   @db.VarChar(64) // groups the changes of one request / batch
  revertOfId   String?   @db.VarChar(40) // this change undid that one
  revertedById String?   @db.VarChar(40) // the change that undid this one
  revertedAt   DateTime?
  sensitive    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([requestId])
  @@index([createdAt])
}

// ─── Report builder (lib/reports) and profitability per case (lib/profitability) ─────────────

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// A saved no-code report: dataset key + JSON config (columns, filters, groupBy, aggregations, sort).
/// Private to its owner unless `shared` (then visible to every ADMIN+). Plain owner id, no foreign key.
model SavedReport {
  id        String           @id @default(cuid())
  name      String           @db.VarChar(160)
  dataset   String           @db.VarChar(40)
  config    Json
  shared    Boolean          @default(false)
  ownerId   String?          @db.VarChar(40)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  schedules ReportSchedule[]

  @@index([ownerId])
  @@index([shared])
}

/// "Send this report": daily / weekly (weekday 1 = Monday … 7 = Sunday) / monthly (day of month, clamped to
/// the month's last day) at HH:mm Asia/Baku, as an Excel attachment to staff users and allow-listed e-mails.
model ReportSchedule {
  id               String           @id @default(cuid())
  reportId         String
  report           SavedReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  frequency        ReportFrequency
  weekday          Int?
  monthDay         Int?
  time             String           @default("08:00") @db.VarChar(5)
  recipientUserIds Json // string[]
  externalEmails   Json // string[]
  active           Boolean          @default(true)
  createdById      String?          @db.VarChar(40)
  lastPeriodKey    String?          @db.VarChar(20)
  lastRunAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deliveries       ReportDelivery[]

  @@index([active])
}

/// One delivery of a schedule; (scheduleId, periodKey) is unique, so a period is sent at most once.
model ReportDelivery {
  id         String         @id @default(cuid())
  scheduleId String
  schedule   ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  periodKey  String         @db.VarChar(20)
  status     String         @db.VarChar(16) // PENDING | SENT | FAILED
  rows       Int            @default(0)
  recipients Json? // string[] e-mails actually sent to
  error      String?        @db.Text
  createdAt  DateTime       @default(now())

  @@unique([scheduleId, periodKey])
  @@index([scheduleId, createdAt])
}

enum CaseCostCategory {
  TRANSLATION
  COURIER
  EMBASSY_FEE
  VISA_FEE
  AGENT_COMMISSION
  PARTNER_COMMISSION
  TRAVEL
  OTHER
}

/// A manual cost of a case (profitability): amount in EUR or AZN with the AZN-per-EUR rate of its date.
model CaseCost {
  id          String           @id @default(cuid())
  caseId      String
  case        Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  category    CaseCostCategory
  amountCents Int
  currency    String           @default("EUR") @db.VarChar(3) // EUR | AZN
  fxRate      Float // AZN per 1 EUR at incurredAt (stored, so later rate changes never alter old costs)
  incurredAt  DateTime
  note        String?          @db.Text
  documentId  String?          @db.VarChar(40) // optional case Document (receipt)
  createdById String?          @db.VarChar(40)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([caseId])
  @@index([incurredAt])
}

// ─── Duplicate clients: detection (lib/duplicates) and one-click merge (lib/userMerge.ts) ─

enum DuplicateStatus {
  OPEN
  MERGED
  NOT_DUPLICATE
}

/// A pair of CLIENT accounts that may belong to the same person. Ordered (userAId < userBId), so one row per
/// pair; a NOT_DUPLICATE decision sticks across detection runs.
model DuplicatePair {
  id          String          @id @default(cuid())
  userAId     String
  userA       User            @relation("DuplicateA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId     String
  userB       User            @relation("DuplicateB", fields: [userBId], references: [id], onDelete: Cascade)
  score       Int // 0–100
  reasons     Json // [{ rule, strength, value? }]
  status      DuplicateStatus @default(OPEN)
  decidedById String? // plain id: the decision survives the admin's deletion
  decidedAt   DateTime?
  detectedAt  DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userAId, userBId])
  @@index([status, score])
  @@index([userBId])
}

/// One merge of a secondary client account into a primary one: chosen fields, counts per relation and a JSON
/// snapshot of every moved id (no unmerge — support traces moves manually). Plain ids, no foreign keys.
model UserMerge {
  id          String   @id @default(cuid())
  primaryId   String   @db.VarChar(40)
  secondaryId String   @db.VarChar(40)
  actorId     String?  @db.VarChar(40)
  pairId      String?  @db.VarChar(40)
  fields      Json // { field: { kept: "primary" | "secondary", before, after } }
  counts      Json // { "Model.field": n }
  snapshot    Json // { "Model.field": [ids or key tuples], drive: { moved, renamed, trashed } }
  secondary   Json // the secondary's profile before anonymisation (support only)
  createdAt   DateTime @default(now())

  @@index([primaryId])
  @@index([secondaryId])
  @@index([createdAt])
}

/// "View as client" (lib/privacy/impersonation): an ADMIN+ opens a CLIENT's / COMPANY user's portal read-only.
/// Bound to the admin's own web session (adminSessionId); the browser holds an extra httpOnly cookie with a
/// random token whose sha256 is stored here. 30 minutes, never renewed. Plain ids, no foreign keys.
model ImpersonationSession {
  id             String    @id @default(cuid())
  adminId        String
  adminSessionId String
  targetUserId   String
  reason         String    @db.VarChar(24) // SUPPORT_REQUEST | BUG_CHECK | OTHER
  note           String?   @db.VarChar(500)
  tokenHash      String    @unique @db.Char(64)
  returnTo       String?   @db.VarChar(300)
  ip             String?   @db.VarChar(64)
  userAgent      String?   @db.VarChar(300)
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  endedAt        DateTime?
  endReason      String?   @db.VarChar(16) // STOPPED | EXPIRED | LOGOUT | REPLACED
  requestCount   Int       @default(0)

  @@index([targetUserId, startedAt])
  @@index([adminId, startedAt])
}

/// What was viewed during an impersonation session: one row per session and minute window with the
/// distinct API paths (and portal pages) requested in that minute.
model ImpersonationLog {
  id          String   @id @default(cuid())
  sessionId   String
  windowStart DateTime
  paths       Json // ["GET /api/cases/…", "PAGE /account/cases/…"]
  hits        Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([sessionId, windowStart])
}

// ─── No-code automation rules + automatic case assignment ───────────────
// Plain ids (no foreign keys) so the rule log survives deleted cases / users and other models stay untouched.

/// An admin-built "WHEN trigger IF conditions THEN actions" rule (lib/automation). Disabled by default.
model AutomationRule {
  id          String          @id @default(cuid())
  name        String          @db.VarChar(160)
  description String?         @db.Text
  enabled     Boolean         @default(false)
  triggerType String          @db.VarChar(40) // CASE_STATUS_CHANGED, DOCUMENT_REJECTED, CLIENT_INACTIVE, …
  trigger     Json // { type, from?, to?, days?, stages?, … }
  conditions  Json // [{ type, op, values? / key? }] — all must hold (AND)
  actions     Json // [{ type, delay?: { amount, unit }, onlyIfStillTrue?, … }] in order
  exampleKey  String?         @unique @db.VarChar(60) // shipped example rules (created once, never re-created)
  runCount    Int             @default(0)
  lastRunAt   DateTime?
  createdById String?         @db.VarChar(40)
  updatedById String?         @db.VarChar(40)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  runs        AutomationRun[]

  @@index([enabled, triggerType])
}

/// Queue of domain events (case status changed, document rejected, booking created …), processed off the request path.
model AutomationEvent {
  id          String    @id @default(cuid())
  type        String    @db.VarChar(40)
  entityType  String    @db.VarChar(20) // case | document | application | booking | inquiry
  entityId    String    @db.VarChar(40)
  caseId      String?   @db.VarChar(40)
  payload     Json?
  chain       Json? // rule ids whose actions caused this event (loop protection)
  depth       Int       @default(0)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
}

enum AutomationRunStatus {
  RUNNING
  WAITING // delayed steps still pending
  SUCCEEDED
  PARTIAL // some steps failed or were skipped
  SKIPPED
  FAILED
}

enum AutomationStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  SKIPPED
  FAILED
}

/// One firing of a rule for one trigger occurrence. idempotencyKey = rule + entity + occurrence (unique).
model AutomationRun {
  id             String              @id @default(cuid())
  ruleId         String
  rule           AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  idempotencyKey String              @unique @db.VarChar(191)
  triggerType    String              @db.VarChar(40)
  entityType     String              @db.VarChar(20)
  entityId       String              @db.VarChar(40)
  caseId         String?             @db.VarChar(40)
  eventId        String?             @db.VarChar(40)
  status         AutomationRunStatus @default(RUNNING)
  reason         String?             @db.Text
  context        Json? // trigger snapshot used for "only if still true" re-checks
  chain          Json?
  depth          Int                 @default(0)
  createdAt      DateTime            @default(now())
  finishedAt     DateTime?
  steps          AutomationStep[]

  @@index([ruleId, createdAt])
  @@index([entityId, createdAt])
}

/// One action of a run; delayed actions wait here until runAt.
model AutomationStep {
  id              String               @id @default(cuid())
  runId           String
  run             AutomationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  index           Int
  actionType      String               @db.VarChar(40)
  status          AutomationStepStatus @default(PENDING)
  runAt           DateTime
  onlyIfStillTrue Boolean              @default(false)
  reason          String?              @db.Text
  result          Json?
  executedAt      DateTime?

  @@unique([runId, index])
  @@index([status, runAt])
}

/// Per staff member: what they handle for automatic assignment (empty lists = no restriction).
model StaffPreferences {
  userId          String   @id @db.VarChar(40)
  languages       Json? // ["az","ru"]
  visaTypes       Json? // ["WORK","AUSBILDUNG"]
  visaCategoryIds Json?
  maxOpenCases    Int?
  workingDays     Json? // ISO weekdays [1..7], Baku time
  autoAssign      Boolean  @default(true)
  /// Admin navigation: role desk, pinned items and recently opened pages.
  desk            String?  @db.VarChar(20) // MANAGER | FINANCE | MARKETING | ALL
  navPins         Json? // nav item ids
  navRecent       Json? // [{ id, at }]
  updatedAt       DateTime @updatedAt
  /// Personal admin dashboard: widget ids, order and sizes.
  dashboardLayout Json?
}

enum CaseHandoverStatus {
  ACTIVE
  RETURNED // went back to the original owner
  KEPT // reassigned manually meanwhile, left as is
}

/// Temporary reassignment of a case while its owner is on approved leave.
model CaseHandover {
  id              String             @id @default(cuid())
  caseId          String             @db.VarChar(40)
  originalStaffId String             @db.VarChar(40)
  substituteId    String             @db.VarChar(40)
  leaveId         String?            @db.VarChar(40)
  status          CaseHandoverStatus @default(ACTIVE)
  startedAt       DateTime           @default(now())
  plannedEndAt    DateTime?
  endedAt         DateTime?
  note            String?            @db.Text
  checklist       Json? // [{ text, done }]

  @@index([status])
  @@index([originalStaffId, status])
  @@index([caseId, status])
}

// ─── Campaigns to client segments (Admin → Kampaniyalar, lib/campaigns) ───────

enum CampaignKind {
  SERVICE // service information (case / account related); respects emailNotifications / smsNotifications
  MARKETING // advertising: only recipients with an explicit opt-in (User.marketingOptIn)
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignChannel {
  EMAIL
  SMS
  IN_APP
}

enum CampaignRecipientStatus {
  QUEUED
  SENDING // claimed by the worker (never sent twice: a crash leaves it FAILED / INTERRUPTED)
  SENT
  FAILED
  SKIPPED // see skipReason
  BOUNCED // permanent reject (SMTP 5xx, SMS undelivered)
}

/// Saved, click-built recipient filter (definition: { op, groups: [{ op, conditions: [...] }] }, see lib/campaigns/segments.ts).
model CampaignSegment {
  id          String     @id @default(cuid())
  name        String     @db.VarChar(160)
  description String?    @db.Text
  definition  Json
  createdById String?
  createdBy   User?      @relation("CampaignSegmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaigns   Campaign[]
}

model Campaign {
  id              String              @id @default(cuid())
  name            String              @db.VarChar(200)
  kind            CampaignKind        @default(SERVICE)
  status          CampaignStatus      @default(DRAFT)
  segmentId       String?
  segment         CampaignSegment?    @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  segmentSnapshot Json? // definition frozen when the campaign was scheduled / queued
  channels        Json // ["EMAIL", "SMS", "IN_APP"]
  content         Json // { az: { subject, body, sms }, de: …, en: …, ru: … }
  links           Json? // allow-listed destinations of tracked links (index = /c/:token/:index), frozen when scheduled
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  pausedAt        DateTime?
  cancelledAt     DateTime?
  emailsPerMinute Int                 @default(30)
  smsPerMinute    Int                 @default(10)
  quietHours      Boolean             @default(true) // no SMS 21:00–09:00 Baku
  createdById     String?
  createdBy       User?               @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  recipients      CampaignRecipient[]

  @@index([status, scheduledAt])
  @@index([segmentId])
}

/// Send queue + tracking: one row per campaign, person and channel (unique → never sent twice).
model CampaignRecipient {
  id             String                  @id @default(cuid())
  campaignId     String
  campaign       Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId         String
  user           User                    @relation("CampaignRecipientUser", fields: [userId], references: [id], onDelete: Cascade)
  channel        CampaignChannel
  locale         Locale
  status         CampaignRecipientStatus @default(QUEUED)
  skipReason     String?                 @db.VarChar(40) // NO_MARKETING_CONSENT | EMAIL_OPTED_OUT | SMS_OPTED_OUT | NO_PHONE | NO_CONTENT | UNSUBSCRIBED | CANCELLED | INACTIVE
  token          String                  @unique @db.VarChar(64) // pixel, click and unsubscribe links
  address        String?                 @db.VarChar(200) // e-mail / phone used
  attempts       Int                     @default(0)
  nextAttemptAt  DateTime?
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime? // e-mail pixel (approximate: Apple MPP / image proxies)
  clickedAt      DateTime? // first click
  clicks         Int                     @default(0)
  unsubscribedAt DateTime?
  notificationId String? // in-app: Notification.id (read = Notification.readAt)
  outboundId     String? // SMS: OutboundMessage.id
  providerId     String?                 @db.VarChar(120) // SMS provider message id (delivery reports)
  error          String?                 @db.Text
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([campaignId, userId, channel])
  @@index([campaignId, status])
  @@index([campaignId, channel, status])
  @@index([channel, lastAttemptAt])
  @@index([userId])
  @@index([providerId])
  @@index([status, lastAttemptAt])
}

// ─── Client process: ball-in-court, client tasks, office visits (lib/clientProcess) ───

/// Kind of a booking slot: online consultation (public booking page) or a visit to the office (client portal).
enum SlotKind {
  ONLINE
  OFFICE
}

enum ClientTaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// A to-do the team gives the client on a case ("Polis arayışı alın"), with a deadline and reminders
/// (2 days before, on the due date, overdue: once then every 3 days, max 3; ReminderLog keys).
model ClientTask {
  id               String               @id @default(cuid())
  caseId           String
  case             Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// POLICE_CERT | GOETHE_EXAM | PASSPORT_PHOTO | … (lib/clientProcess/texts.ts); null = custom
  template         String?              @db.VarChar(40)
  title            String               @db.VarChar(200)
  description      String?              @db.Text
  dueAt            DateTime?
  status           ClientTaskStatus     @default(OPEN)
  /// Uploading a document to this requirement completes the task automatically.
  requirementId    String?
  requirement      DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  linkUrl          String?              @db.Text
  /// Case Document (stage OTHER) the team attached (form, instructions).
  attachmentId     String?              @db.VarChar(40)
  /// Case Document (stage OTHER) the client uploaded when marking the task done.
  clientDocumentId String?              @db.VarChar(40)
  clientNote       String?              @db.Text
  /// CLIENT | STAFF | UPLOAD (auto-completed by the linked requirement)
  completedVia     String?              @db.VarChar(12)
  completedAt      DateTime?
  completedById    String?              @db.VarChar(40)
  createdById      String?
  createdBy        User?                @relation("ClientTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([caseId, status])
  @@index([status, dueAt])
  @@index([requirementId])
}

// ─── Site growth: start-date calculator settings live in Setting ("growthCalculator", "growthMap", "growthReferral") ───

/// Germany placement map: manual numbers per city (admin). OVERRIDE replaces the computed count, ADD is added
/// to it, HIDE removes the city. Public output only shows cities with at least 3 workers (privacy).
model PlacementMapEntry {
  id          String   @id @default(cuid())
  cityKey     String   @unique @db.VarChar(80) // lower-case city name ("hamburg")
  city        String   @db.VarChar(80) // display name ("Hamburg")
  mode        String   @default("OVERRIDE") @db.VarChar(12) // OVERRIDE | ADD | HIDE
  workers     Int      @default(0)
  professions Json? // string[] shown in the tooltip ("LKW-Fahrer", "Lager")
  lat         Float?
  lng         Float?
  note        String?  @db.VarChar(300) // internal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum InfoEventMode {
  ONLINE
  OFFLINE
}

enum InfoEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum InfoEventAttendance {
  REGISTERED
  CHECKED_IN
  NO_SHOW
}

/// Webinars / info sessions (Admin → Tədbirlər, public /events).
model InfoEvent {
  id             String                  @id @default(cuid())
  slug           String                  @unique @db.VarChar(120)
  title          Json // L10n
  description    Json // L10n
  mode           InfoEventMode           @default(ONLINE)
  meetingUrl     String?                 @db.Text // online: Jitsi room (generated like consultations)
  address        String?                 @db.Text // offline: e.g. the Baku office
  startsAt       DateTime
  endsAt         DateTime
  capacity       Int? // null = unlimited
  language       String                  @default("az") @db.VarChar(8) // az | de | en | ru
  status         InfoEventStatus         @default(DRAFT)
  followUpNote   Json? // optional L10n paragraph added to the post-event follow-up email
  followUpSentAt DateTime?
  recordingUrl   String?                 @db.Text
  createdById    String? // plain id (staff)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  registrations  InfoEventRegistration[]

  @@index([status, startsAt])
}

model InfoEventRegistration {
  id             String              @id @default(cuid())
  eventId        String
  event          InfoEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String              @db.VarChar(120)
  email          String              @db.VarChar(200)
  phone          String?             @db.VarChar(40)
  locale         String              @default("az") @db.VarChar(8)
  attendance     InfoEventAttendance @default(REGISTERED)
  checkedInAt    DateTime?
  markedById     String? // plain id (staff who marked attendance)
  inquiryId      String? // lead created (or the existing one it matched)
  consentAt      DateTime            @default(now())
  followUpSentAt DateTime?
  createdAt      DateTime            @default(now())

  @@unique([eventId, email])
  @@index([eventId, attendance])
}

/// Client referral programme ("Dostunu gətir"): one personal code per CLIENT. Separate from the B2B agent
/// programme (Agent.code); when a sign-up carries an agent code the agent attribution wins.
model ClientReferralCode {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation("ReferralCodeOwner", fields: [userId], references: [id], onDelete: Cascade)
  code            String   @unique @db.VarChar(16)
  createdAt       DateTime @default(now())
  /// Personal landing page /r/<slug> (opt-in; public, noindex): chosen slug, quote and optional photo.
  slug            String?  @unique @db.VarChar(40)
  landingEnabled  Boolean  @default(false)
  landingQuote    String?  @db.VarChar(280)
  landingPhotoUrl String?  @db.VarChar(200) // /uploads/referral/… (re-encoded, EXIF stripped); only shown while enabled
}

enum ReferralStage {
  REGISTERED
  CASE_OPENED
  VISA_APPROVED
  BLOCKED // anti-fraud: self-referral (same e-mail / phone / passport)
}

enum ReferralRewardStatus {
  PENDING
  EARNED
  PAID // payout made
  USED // used as a discount
  CANCELLED
}

model ClientReferral {
  id            String           @id @default(cuid())
  referrerId    String
  referrer      User             @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId    String           @unique // one attribution (and so one reward) per referred client
  referred      User             @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)
  code          String           @db.VarChar(16)
  stage         ReferralStage    @default(REGISTERED)
  blockedReason String?          @db.VarChar(40) // SAME_EMAIL | SAME_PHONE | SAME_PASSPORT
  caseOpenedAt  DateTime?
  approvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  reward        ReferralReward?  @relation("ReferralMainReward")
  bonuses       ReferralReward[] @relation("ReferralBonusSource") // case-opened, tier and friend rewards

  @@index([referrerId])
}

/// Ledger of the client referral programme. type REFERRAL = the one main reward per referral (referralId);
/// STAGE (extra amount at case opened), TIER (bonus at N approved friends) and FRIEND (the referred
/// friend's own discount) have referralId null, the referral that caused them in sourceReferralId and a
/// unique dedupeKey so a sync can never grant them twice.
model ReferralReward {
  id               String               @id @default(cuid())
  referralId       String?              @unique
  referral         ClientReferral?      @relation("ReferralMainReward", fields: [referralId], references: [id], onDelete: Cascade)
  type             String               @default("REFERRAL") @db.VarChar(12) // REFERRAL | STAGE | TIER | FRIEND
  sourceReferralId String?
  source           ClientReferral?      @relation("ReferralBonusSource", fields: [sourceReferralId], references: [id], onDelete: Cascade)
  dedupeKey        String?              @unique @db.VarChar(80) // STAGE:<referralId>:CASE_OPENED | TIER:<userId>:<n> | FRIEND:<referralId>
  referrerId       String // plain id of who gets it (= referral.referrerId; the referred friend for FRIEND), for the ledger queries
  kind             String               @default("DISCOUNT") @db.VarChar(12) // DISCOUNT | PAYOUT (rule at creation)
  trigger          String               @default("VISA_APPROVED") @db.VarChar(16) // CASE_OPENED | VISA_APPROVED (TIER / REGISTERED for bonuses)
  amount           Int // whole currency units
  currency         String               @default("AZN") @db.VarChar(3)
  status           ReferralRewardStatus @default(PENDING)
  earnedAt         DateTime?
  settledAt        DateTime?
  settledById      String? // plain id (admin)
  note             String?              @db.VarChar(300)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([referrerId, status])
  @@index([status])
  @@index([sourceReferralId])
}

// ─── Family members (Familiennachzug) + German language progress ─────

enum FamilyRelation {
  SPOUSE
  CHILD
  PARENT
  OTHER
}

enum FamilyJoinsWhen {
  WITH_MAIN // travels together with the main applicant
  LATER // follows later (separate appointment)
}

/// Personal details of a family member of a main applicant's case. The member's own visa application
/// is a linked sub-case (Case.parentCaseId / Case.relation): its requirements, uploads, review, AI checks,
/// VIDEX and embassy package are the normal case flows. Status = the member case's status.
model FamilyMember {
  id                String          @id @default(cuid())
  mainCaseId        String
  mainCase          Case            @relation("FamilyMemberMain", fields: [mainCaseId], references: [id], onDelete: Cascade)
  memberCaseId      String          @unique
  memberCase        Case            @relation("FamilyMemberCase", fields: [memberCaseId], references: [id], onDelete: Cascade)
  relation          FamilyRelation
  firstName         String          @db.VarChar(80) // as in the passport (Latin)
  lastName          String          @db.VarChar(80)
  birthDate         DateTime?
  birthPlace        String?         @db.VarChar(120) // sensitive (BIRTH_PLACE mask group)
  sex               String?         @db.VarChar(1) // M | F | X
  nationality       String?         @db.VarChar(60)
  passportNumber    String?         @db.VarChar(40) // sensitive (PASSPORT mask group)
  passportIssuedAt  DateTime?
  passportExpiresAt DateTime?
  email             String?         @db.VarChar(190)
  joinsWhen         FamilyJoinsWhen @default(WITH_MAIN)
  plannedEntryAt    DateTime?
  /// Spouse: German A1 not required (exception, e.g. main applicant holds a Blue Card / ICT, EU-Daueraufenthalt …).
  germanExempt      Boolean         @default(false)
  germanExemptNote  String?         @db.VarChar(300)
  notes             String?         @db.Text
  docsCopiedAt      DateTime?
  createdById       String? // plain id (staff or the client)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([mainCaseId])
}

/// Familiennachzug: the main applicant's situation in Germany for the readiness check (lib/family/legal.ts).
/// Empty fields fall back to the case (visa category → title, decision date, employment contract gross).
model FamilyReunionInfo {
  id            String    @id @default(cuid())
  mainCaseId    String    @unique
  mainCase      Case      @relation("FamilyReunionInfo", fields: [mainCaseId], references: [id], onDelete: Cascade)
  sponsorTitle  String?   @db.VarChar(20) // legal.ts SPONSOR_TITLES
  titleIssuedAt DateTime? // first issue of the residence title (calendar day, 00:00 UTC)
  livingSpaceM2 Int? // Wohnfläche of the flat in Germany
  warmRent      Int? // EUR per month incl. heating
  netMonthly    Int? // EUR net salary per month
  notes         String?   @db.Text
  updatedById   String?   @db.VarChar(40)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum GermanCourseStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GermanExamProvider {
  GOETHE
  TELC
  OESD
  TESTDAF
  OTHER
}

enum GermanExamStatus {
  PLANNED // the candidate intends to take it
  REGISTERED // registered with the provider
  TAKEN // written, result outstanding
  PASSED
  FAILED
  CANCELLED
}

/// The candidate's language goal. The CURRENT level is User.germanLevel (single source of truth, used by
/// matching and vacancies); it is raised automatically when staff accept a language certificate.
model GermanPlan {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation("GermanPlanUser", fields: [userId], references: [id], onDelete: Cascade)
  targetLevel String?   @db.VarChar(4) // A1 … C2
  targetDate  DateTime?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GermanCourse {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation("GermanCourseUser", fields: [userId], references: [id], onDelete: Cascade)
  school          String             @db.VarChar(160)
  level           String             @db.VarChar(4) // A1 … C2
  startsAt        DateTime?
  endsAt          DateTime?
  schedule        String?            @db.VarChar(200) // "Mo–Fr 09:00–13:00"
  format          String?            @db.VarChar(10) // online | offline | hybrid
  status          GermanCourseStatus @default(PLANNED)
  catalogCourseId String? // plain id of a LanguageCourse (catalogue) the course was picked from
  notes           String?            @db.Text
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([startsAt])
}

/// Upcoming exam dates entered by admins (Admin → İmtahan tarixləri); clients pick one for their exam.
model GermanExamDate {
  id                   String             @id @default(cuid())
  provider             GermanExamProvider
  level                String?            @db.VarChar(4)
  city                 String             @default("Baku") @db.VarChar(80)
  location             String?            @db.VarChar(200)
  examDate             DateTime
  registrationDeadline DateTime?
  link                 String?            @db.Text
  notes                String?            @db.VarChar(500)
  published            Boolean            @default(true)
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  exams                GermanExam[]

  @@index([examDate])
}

model GermanExam {
  id                    String             @id @default(cuid())
  userId                String
  user                  User               @relation("GermanExamUser", fields: [userId], references: [id], onDelete: Cascade)
  provider              GermanExamProvider
  level                 String             @db.VarChar(4)
  examDateId            String?
  examDateRef           GermanExamDate?    @relation(fields: [examDateId], references: [id], onDelete: SetNull)
  examDate              DateTime?
  location              String?            @db.VarChar(200)
  registrationDeadline  DateTime?
  registeredAt          DateTime?
  status                GermanExamStatus   @default(PLANNED)
  /// Per module: { LESEN|HOEREN|SCHREIBEN|SPRECHEN: { score, max, passed } }
  results               Json?
  passed                Boolean? // overall result
  /// Case document holding the certificate (plain id; the document lives in the client's case).
  certificateDocumentId String?
  notes                 String?            @db.Text
  createdById           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId])
  @@index([examDate])
  @@index([registrationDeadline])
  @@index([certificateDocumentId])
}

/// A self-test (placement test) result of a candidate, kept so staff see the history on the case page.
model GermanTestAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("GermanTestAttemptUser", fields: [userId], references: [id], onDelete: Cascade)
  estimated String   @db.VarChar(4) // none | A1 … B2
  correct   Int
  total     Int
  percent   Int
  levels    Json // [{ level, total, correct, percent, passed }]
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Vocabulary trainer word (starter list seeded from prisma/seed/germanVocabulary.ts, upsert by slug).
model GermanWord {
  id           String               @id @default(cuid())
  slug         String               @unique @db.VarChar(80)
  level        String               @db.VarChar(4) // A1 | A2 | B1 | B2
  field        String               @db.VarChar(20) // GENERAL | WORK | CARE | CONSTRUCTION | HOSPITALITY | DRIVING
  de           String               @db.VarChar(120) // the word without article
  article      String?              @db.VarChar(3) // der | die | das (nouns)
  plural       String?              @db.VarChar(120)
  example      String?              @db.VarChar(300) // German example sentence
  translations Json // { az, ru, en }
  sortOrder    Int                  @default(0)
  published    Boolean              @default(true)
  progress     GermanWordProgress[]

  @@index([level, field])
}

/// Spaced-repetition state (SM-2) of one word for one candidate.
model GermanWordProgress {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation("GermanWordProgressUser", fields: [userId], references: [id], onDelete: Cascade)
  wordId         String
  word           GermanWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  repetitions    Int        @default(0) // successful reviews in a row
  easiness       Float      @default(2.5)
  intervalDays   Int        @default(0)
  dueAt          DateTime
  reviews        Int        @default(0)
  correct        Int        @default(0)
  lapses         Int        @default(0)
  lastGrade      Int?
  lastReviewedAt DateTime?
  createdAt      DateTime   @default(now())

  @@unique([userId, wordId])
  @@index([userId, dueAt])
}

/// Vocabulary practice per candidate and day (Baku calendar day) — streaks and the staff activity view.
model GermanPracticeDay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("GermanPracticeDayUser", fields: [userId], references: [id], onDelete: Cascade)
  day       String   @db.VarChar(10) // YYYY-MM-DD (Asia/Baku)
  reviews   Int      @default(0)
  correct   Int      @default(0)
  newWords  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
}

// ─── Staff time tracking, post-arrival check-ins, client access log ─────

enum TimeActivity {
  DOCUMENTS
  CLIENT_COMMUNICATION
  EMPLOYER_COMMUNICATION
  TRANSLATION
  EMBASSY
  OTHER
}

/// Staff time on a case (lib/timeTracking): a running timer (endedAt = null) or a finished timer / manual entry.
model TimeEntry {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  caseId       String?
  case         Case?        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Optional link to a team task (plain id: the entry stays when the task is deleted).
  taskId       String?
  activity     TimeActivity @default(OTHER)
  note         String?      @db.VarChar(1000)
  source       String       @default("TIMER") @db.VarChar(10) // TIMER | MANUAL
  startedAt    DateTime
  endedAt      DateTime?
  minutes      Int          @default(0)
  /// = userId while the timer runs, null once stopped: at most one running timer per staff member.
  runningKey   String?      @unique @db.VarChar(64)
  /// "Still working?" prompt sent (timer running > 10 h).
  idleWarnedAt DateTime?
  autoStopped  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, startedAt])
  @@index([caseId, startedAt])
  @@index([taskId])
}

/// Hourly labour cost of a staff member from a date on (EUR cents; SUPER_ADMIN only). Plain ids.
model StaffCostRate {
  id            String   @id @default(cuid())
  userId        String
  centsPerHour  Int
  effectiveFrom DateTime @db.Date
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([userId, effectiveFrom])
}

enum CheckInAudience {
  WORKER
  EMPLOYER
}

enum CheckInAnswer {
  OK
  ISSUE
}

/// Follow-up of a worker who arrived in Germany (one per case): arrival date + employment (retention).
model ArrivalFollowUp {
  id             String           @id @default(cuid())
  caseId         String           @unique
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientId       String
  companyId      String?
  arrivedAt      DateTime
  leftJobAt      DateTime?
  leftReason     String?          @db.VarChar(40)
  leftNote       String?          @db.VarChar(1000)
  leftMarkedById String?
  /// Churn risk from the check-in answers (0–100).
  riskScore      Int?
  riskLevel      String?          @db.VarChar(10) // LOW | MEDIUM | HIGH
  riskReasons    Json?
  riskAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  checkIns       ArrivalCheckIn[]

  @@index([arrivedAt])
}

/// One post-arrival check-in (+7 / +30 / +90 days) to the worker, or the employer's short check-in.
model ArrivalCheckIn {
  id           String          @id @default(cuid())
  followUpId   String
  followUp     ArrivalFollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  caseId       String
  audience     CheckInAudience
  offsetDays   Int
  dueAt        DateTime
  sentAt       DateTime?
  /// sha256 of the link token (answer from the e-mail without logging in).
  tokenHash    String          @unique @db.Char(64)
  answer       CheckInAnswer?
  topics       Json?
  comment      String?         @db.Text
  answeredAt   DateTime?
  answeredById String?
  taskId       String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime        @default(now())

  @@unique([followUpId, audience, offsetDays])
  @@index([caseId])
  @@index([answer, resolvedAt])
}

/// Staff previews / downloads of a client's documents (aggregated per 10 minutes) — "who viewed my documents".
model DocumentAccessLog {
  id         String   @id @default(cuid())
  clientId   String
  actorId    String?
  actorRole  String?  @db.VarChar(16)
  documentId String?
  caseId     String?
  action     String   @db.VarChar(16) // VIEW | DOWNLOAD
  source     String   @db.VarChar(16) // FILES | DRIVE
  name       String   @db.VarChar(255)
  count      Int      @default(1)
  firstAt    DateTime @default(now())
  lastAt     DateTime @default(now())

  @@index([clientId, lastAt])
  @@index([actorId, documentId, action, lastAt])
}

// ─── Phone calls, callback requests, AI → human live chat (stream: calls_livechat) ───
// Plain ids (no foreign keys): calls outlive deleted users / inquiries as a log; staff, client, case and
// inquiry are resolved by the routes. Provider settings live in Setting 'calls' (secrets sealed with secretBox).

enum CallDirection {
  OUTBOUND
  INBOUND
}

enum CallStatus {
  QUEUED
  RINGING_STAFF
  RINGING
  IN_PROGRESS
  COMPLETED
  BUSY
  NO_ANSWER
  FAILED
  CANCELED
}

enum CallOutcome {
  REACHED
  NO_ANSWER
  WRONG_NUMBER
  CALL_BACK
}

model Call {
  id             String        @id @default(cuid())
  /// twilio | sipgate | fake | manual (logged by hand, no provider)
  provider       String        @db.VarChar(16)
  /// Twilio CallSid of the first leg / sipgate sessionId
  providerCallId String?       @db.VarChar(80)
  /// second identifier from webhooks (Twilio child leg CallSid, sipgate push callId)
  providerLegId  String?       @db.VarChar(80)
  direction      CallDirection
  fromNumber     String        @db.VarChar(40)
  toNumber       String        @db.VarChar(40)
  staffId        String?
  clientId       String?
  caseId         String?
  inquiryId      String?
  callbackId     String?
  liveChatId     String?
  status         CallStatus    @default(QUEUED)
  startedAt      DateTime      @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int?
  recorded       Boolean       @default(false)
  /// provider recording reference (Twilio RecordingSid); played through the API only
  recordingKey   String?       @db.VarChar(200)
  transcript     String?       @db.Text
  summary        String?       @db.Text
  /// [{ title, dueInDays }] extracted by the AI summary
  followUps      Json?
  outcome        CallOutcome?
  note           String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([providerCallId])
  @@index([providerLegId])
  @@index([clientId, startedAt])
  @@index([caseId, startedAt])
  @@index([inquiryId])
  @@index([staffId, startedAt])
  @@index([callbackId])
}

enum CallbackStatus {
  PENDING
  DONE
  CANCELLED
}

model CallbackRequest {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(120)
  phone       String         @db.VarChar(40)
  email       String?        @db.VarChar(200)
  locale      String         @db.VarChar(2)
  topic       String?        @db.VarChar(40)
  message     String?        @db.Text
  asap        Boolean        @default(false)
  windowStart DateTime
  windowEnd   DateTime
  /// contact | footer | advisor | portal | livechat
  source      String         @db.VarChar(16)
  clientId    String?
  inquiryId   String?
  taskId      String?
  assigneeIds Json?
  status      CallbackStatus @default(PENDING)
  outcome     CallOutcome?
  note        String?        @db.Text
  callId      String?
  remindedAt  DateTime?
  doneAt      DateTime?
  doneById    String?
  createdAt   DateTime       @default(now())

  @@index([status, windowStart])
  @@index([clientId])
}

enum LiveChatStatus {
  WAITING
  ACTIVE
  CLOSED
  MISSED
}

model LiveChat {
  id            String            @id @default(cuid())
  status        LiveChatStatus    @default(WAITING)
  locale        String            @db.VarChar(2)
  visitorName   String?           @db.VarChar(120)
  visitorEmail  String?           @db.VarChar(200)
  visitorPhone  String?           @db.VarChar(40)
  /// AI advisor turns before the handover: [{ role, content }]
  transcript    Json?
  pageUrl       String?           @db.VarChar(300)
  reason        String?           @db.VarChar(20)
  staffId       String?
  clientId      String?
  inquiryId     String?
  callbackId    String?
  acceptedAt    DateTime?
  closedAt      DateTime?
  lastVisitorAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  messages      LiveChatMessage[]

  @@index([status, createdAt])
  @@index([staffId, status])
}

model LiveChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      LiveChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// VISITOR | STAFF | SYSTEM
  author    String   @db.VarChar(8)
  staffId   String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

// ─── Site: installable app (web push), public status check, problem reports ─────────

/// A browser's Web Push subscription (PWA) of a logged-in user. Plain user id (no relation): removed on
/// logout, with the account (lib/userDeletion.ts) and when the push service answers 404/410.
model WebPushSubscription {
  id           String   @id @default(cuid())
  /// sha256 of the endpoint (endpoints are too long for a unique index).
  endpointHash String   @unique @db.Char(64)
  endpoint     String   @db.Text
  p256dh       String   @db.VarChar(200)
  auth         String   @db.VarChar(64)
  userId       String
  userAgent    String?  @db.VarChar(300)
  lastError    String?  @db.VarChar(200)
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@index([userId])
}

/// Public status check (/status) of one case: off until the client turns it on in the portal privacy settings.
/// Plain case id (rows are removed with the client account, lib/userDeletion.ts).
model CasePublicStatus {
  caseId         String    @id
  enabled        Boolean   @default(false)
  /// "For my family" link: sha256 of the random token (the token itself is only shown once).
  tokenHash      String?   @unique @db.Char(64)
  tokenCreatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// One public status lookup: counts towards the lockout (5 wrong tries per hour per case number / IP) and is the audit trail.
model PublicStatusAttempt {
  id         String   @id @default(cuid())
  caseNumber String   @db.VarChar(40)
  ipHash     String   @db.Char(64)
  success    Boolean
  via        String   @db.VarChar(10) // DOB | LINK
  createdAt  DateTime @default(now())

  @@index([caseNumber, createdAt])
  @@index([ipHash, createdAt])
}

enum ProblemReportStatus {
  NEW
  IN_PROGRESS
  DONE
  WONT_FIX
}

/// "Problem bildir": a bug report from any page (visitors too), with the diagnostics the browser collected.
model ProblemReport {
  id            String              @id @default(cuid())
  status        ProblemReportStatus @default(NEW)
  message       String              @db.Text
  pageUrl       String              @db.VarChar(500)
  appVersion    String?             @db.VarChar(40)
  userAgent     String?             @db.VarChar(400)
  platform      String?             @db.VarChar(100)
  screen        String?             @db.VarChar(40)
  language      String?             @db.VarChar(10)
  /// Last client-side console errors (ring buffer, at most 20 short strings).
  consoleErrors Json?
  /// Last failed API call: { method, url, status, code, at }.
  lastApiError  Json?
  /// Reporter (plain ids; anonymous visitors leave an optional e-mail for the answer).
  userId        String?
  userRole      String?             @db.VarChar(20)
  contactEmail  String?             @db.VarChar(200)
  ipHash        String              @db.Char(64)
  /// Attached image (re-encoded, metadata stripped) under uploads/private/problem-reports/.
  imageFile     String?             @db.VarChar(120)
  imageMime     String?             @db.VarChar(40)
  /// Team task created for the report (plain id).
  taskId        String?
  /// Answers sent to the reporter: [{ at, byId, byName, message, channel }].
  replies       Json?
  internalNote  String?             @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([ipHash, createdAt])
}

// ─── Messaging plus: automatic translation, three-party threads, voice messages ─────

/// Cached machine translation of one message into one reader language (lib/messagingPlus/translate.ts).
/// sourceHash = hash of the text that was translated (body or voice transcript); a change re-translates.
model MessageTranslation {
  id             String              @id @default(cuid())
  caseMessageId  String?
  caseMessage    CaseMessage?        @relation(fields: [caseMessageId], references: [id], onDelete: Cascade)
  partyMessageId String?
  partyMessage   PartyThreadMessage? @relation(fields: [partyMessageId], references: [id], onDelete: Cascade)
  lang           Locale
  sourceHash     String              @db.VarChar(64)
  text           String              @db.Text
  model          String?             @db.VarChar(120)
  createdAt      DateTime            @default(now())

  @@unique([caseMessageId, lang])
  @@unique([partyMessageId, lang])
}

enum PartyThreadStatus {
  OPEN
  CLOSED
}

enum PartySide {
  CANDIDATE
  COMPANY
  STAFF
}

enum PartyMessageStatus {
  VISIBLE
  HELD // contact details / voice under staff review: only the author and staff see it
  REJECTED // staff declined a held message: only the author (marked) and staff see it
  HIDDEN // hidden by staff: staff only
  DELETED // content removed by staff
}

/// Moderated group thread candidate + employer + Triad Vision, per vacancy application or per case linked to a company.
model PartyThread {
  id            String               @id @default(cuid())
  applicationId String?              @unique
  application   VacancyApplication?  @relation("PartyThreadApplication", fields: [applicationId], references: [id], onDelete: Cascade)
  caseId        String?              @unique
  case          Case?                @relation("PartyThreadCase", fields: [caseId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     User                 @relation("PartyThreadCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  status        PartyThreadStatus    @default(OPEN)
  /// The candidate sees the employer's name (default: the vacancy's showCompany).
  showCompany   Boolean              @default(false)
  /// Pinned topics: [{ id, topic: INTERVIEW_TIME | START_DATE | ACCOMMODATION | OTHER, text, at, byId }]
  pins          Json?
  createdById   String?
  createdBy     User?                @relation("PartyThreadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedAt      DateTime?
  lastMessageAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       PartyThreadMember[]
  messages      PartyThreadMessage[]

  @@index([companyId])
  @@index([candidateId])
  @@index([status, lastMessageAt])
}

/// Participant state: staff and the candidate are added when the thread opens; employer users on first visit.
model PartyThreadMember {
  id         String      @id @default(cuid())
  threadId   String
  thread     PartyThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation("PartyThreadMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  side       PartySide
  lastReadAt DateTime?
  notifiedAt DateTime?
  createdAt  DateTime    @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

model PartyThreadMessage {
  id           String               @id @default(cuid())
  threadId     String
  thread       PartyThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId     String
  author       User                 @relation("PartyThreadMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  side         PartySide
  body         String               @db.Text
  lang         Locale?
  voiceId      String?              @unique
  voice        VoiceClip?           @relation("PartyMessageVoice", fields: [voiceId], references: [id], onDelete: SetNull)
  status       PartyMessageStatus   @default(VISIBLE)
  holdReason   String?              @db.VarChar(40) // CONTACT_DETAILS | VOICE_REVIEW
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())
  translations MessageTranslation[]

  @@index([threadId, createdAt])
  @@index([status])
}

/// Voice message audio (private upload) + transcript (lib/messagingPlus/voice.ts).
model VoiceClip {
  id               String              @id @default(cuid())
  uploaderId       String
  uploader         User                @relation("VoiceClipUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  storedName       String              @db.VarChar(160)
  mimeType         String              @db.VarChar(60)
  size             Int
  durationMs       Int
  /// PENDING | DONE | EMPTY | FAILED | NOT_CONFIGURED
  transcriptStatus String              @default("PENDING") @db.VarChar(20)
  transcript       String?             @db.Text
  transcriptLang   Locale?
  transcriptError  String?             @db.VarChar(120)
  createdAt        DateTime            @default(now())
  caseMessage      CaseMessage?        @relation("CaseMessageVoice")
  partyMessage     PartyThreadMessage? @relation("PartyMessageVoice")
}

// ─── Client data: smart questionnaires, data confirmation, document guides (lib/clientData) ───

enum CaseFormStatus {
  SENT
  DRAFT
  SUBMITTED
  APPLIED
  CANCELLED
}

enum DataConfirmationStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  CANCELLED
}

/// Questionnaire template ("Ağıllı anket"). Built-in ones carry a key and are created on first use;
/// admins edit them or build their own in the form builder (fields: lib/clientData/formSchema.ts).
model CaseFormTemplate {
  id          String     @id @default(cuid())
  key         String?    @unique @db.VarChar(60)
  title       Json
  description Json?
  fields      Json
  active      Boolean    @default(true)
  builtIn     Boolean    @default(false)
  sortOrder   Int        @default(0)
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  forms       CaseForm[]
}

/// A questionnaire sent to the client of one case (title + fields copied at send time).
model CaseForm {
  id          String            @id @default(cuid())
  caseId      String
  case        Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  templateId  String?
  template    CaseFormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title       Json
  fields      Json
  answers     Json?
  status      CaseFormStatus    @default(SENT)
  note        String?           @db.Text
  dueAt       DateTime?
  sentById    String?
  sentAt      DateTime          @default(now())
  draftAt     DateTime?
  submittedAt DateTime?
  submitIp    String?           @db.VarChar(64)
  appliedAt   DateTime?
  appliedById String?
  /// [{ target, field, before, after }] of every "Apply to profile"
  applied     Json?
  remindedAt  DateTime?
  reminders   Int               @default(0)

  @@index([caseId, status])
  @@index([status, sentAt])
  @@index([templateId])
}

/// "Client confirms their data" before the embassy: the values asked (snapshot), the client's answers
/// (ok / correction + proof), staff decisions and the confirmed snapshot with time, IP and user agent.
model DataConfirmation {
  id              String                 @id @default(cuid())
  caseId          String
  case            Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status          DataConfirmationStatus @default(PENDING)
  fields          Json
  answers         Json?
  decisions       Json?
  snapshot        Json?
  requestedById   String?
  requestedAt     DateTime               @default(now())
  submittedAt     DateTime?
  submitIp        String?                @db.VarChar(64)
  submitUserAgent String?                @db.Text
  reviewedAt      DateTime?
  reviewedById    String?
  remindedAt      DateTime?
  reminders       Int                    @default(0)

  @@index([caseId, requestedAt])
  @@index([status, requestedAt])
}

/// VIDEX values provided by the client (applied questionnaire answers, accepted corrections), keyed by the
/// VIDEX field key; mapVidex uses them before every other source.
model CaseDataValue {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  key         String   @db.VarChar(60)
  value       String   @db.Text
  source      String   @db.VarChar(20) // form | confirmation
  sourceId    String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([caseId, key])
}

/// "Necə almalı?" guide per requirement key (4 languages, sample image, links); built-in drafts until saved.
model DocumentGuide {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(40)
  content     Json
  links       Json?
  sampleImage String?  @db.VarChar(300)
  verified    Boolean  @default(false)
  published   Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Placement, post-arrival, growth, team quality, client experience, legal versions, SEO guides ─

/// Login-free link an employer opens to see one anonymised candidate profile and answer "interested" / "not a fit".
model CandidateShareLink {
  id            String    @id @default(cuid())
  tokenHash     String    @unique @db.Char(64)
  candidateId   String    @db.VarChar(40)
  applicationId String?   @db.VarChar(40)
  companyId     String?   @db.VarChar(40)
  vacancyId     String?   @db.VarChar(40)
  createdById   String?   @db.VarChar(40)
  expiresAt     DateTime
  revokedAt     DateTime?
  viewCount     Int       @default(0)
  lastViewedAt  DateTime?
  decision      String?   @db.VarChar(20) // INTERESTED | REJECTED
  decisionNote  String?   @db.Text
  decidedAt     DateTime?
  decidedByName String?   @db.VarChar(160)
  createdAt     DateTime  @default(now())

  @@index([candidateId])
  @@index([companyId])
}

/// Structured interview feedback (employer or staff), shown on the candidate card.
model InterviewEvaluation {
  id             String   @id @default(cuid())
  interviewId    String   @db.VarChar(40)
  candidateId    String   @db.VarChar(40)
  authorKind     String   @db.VarChar(12) // EMPLOYER | STAFF
  authorId       String?  @db.VarChar(40)
  authorName     String?  @db.VarChar(160)
  overall        Int // 1–5
  scores         Json // { german, skills, experience, motivation, communication } each 1–5
  recommendation String   @db.VarChar(12) // HIRE | MAYBE | NO
  strengths      String?  @db.Text
  concerns       String?  @db.Text
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([interviewId])
  @@index([candidateId])
}

/// The worker's employment contract (Arbeitsvertrag) for a case: terms, probation and the Blue Card salary check.
model EmploymentContract {
  id              String    @id @default(cuid())
  caseId          String    @unique @db.VarChar(40)
  companyId       String?   @db.VarChar(40)
  employerName    String?   @db.VarChar(200)
  jobTitle        String?   @db.VarChar(160)
  contractType    String    @default("UNLIMITED") @db.VarChar(20) // UNLIMITED | FIXED | AUSBILDUNG
  grossMonthly    Decimal?  @db.Decimal(10, 2)
  grossYearly     Decimal?  @db.Decimal(12, 2)
  weeklyHours     Decimal?  @db.Decimal(4, 1)
  vacationDays    Int?
  startDate       DateTime?
  endDate         DateTime?
  probationMonths Int?
  probationEndsAt DateTime?
  signedAt        DateTime?
  driveNodeId     String?   @db.VarChar(40)
  blueCardCheck   String?   @db.VarChar(20) // OK | SHORTAGE_OK | BELOW | NOT_APPLICABLE
  warnings        Json? // [{ code, message }]
  note            String?   @db.Text
  createdById     String?   @db.VarChar(40)
  updatedById     String?   @db.VarChar(40)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([probationEndsAt])
}

/// Anonymous site visitor (first-party id, only after consent) aggregated for lead scoring.
model LeadVisitor {
  id          String   @id @db.VarChar(40)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  visits      Int      @default(1)
  pageViews   Int      @default(0)
  events      Json? // { "page:/visas": 3, "quiz:done": 1, "calc:cost": 1, … }
  source      String?  @db.VarChar(80)
  utm         Json?
  locale      String?  @db.VarChar(8)
  inquiryId   String?  @db.VarChar(40)

  @@index([lastSeenAt])
  @@index([inquiryId])
}

/// Campaign / country landing page assembled from sections, public at /l/:slug.
model LandingPage {
  id             String    @id @default(cuid())
  slug           String    @unique @db.VarChar(120)
  locale         String    @default("az") @db.VarChar(8)
  title          String    @db.VarChar(200)
  status         String    @default("DRAFT") @db.VarChar(12) // DRAFT | PUBLISHED | ARCHIVED
  country        String?   @db.VarChar(40)
  campaignId     String?   @db.VarChar(40)
  sections       Json // [{ id, type: hero|text|benefits|steps|faq|testimonials|form|cta|video|stats, data }]
  formConfig     Json?
  seoTitle       String?   @db.VarChar(200)
  seoDescription String?   @db.VarChar(400)
  ogImage        String?   @db.Text
  views          Int       @default(0)
  submissions    Int       @default(0)
  publishedAt    DateTime?
  createdById    String?   @db.VarChar(40)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model TrainingCourse {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(200)
  description String?  @db.Text
  roles       Json? // ["STAFF","ADMIN"]; null = everyone in the team
  required    Boolean  @default(false)
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  createdById String?  @db.VarChar(40)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TrainingLesson {
  id          String   @id @default(cuid())
  courseId    String   @db.VarChar(40)
  title       String   @db.VarChar(200)
  body        String?  @db.LongText // markdown
  videoUrl    String?  @db.Text
  driveNodeId String?  @db.VarChar(40)
  minutes     Int?
  sortOrder   Int      @default(0)
  quiz        Json? // [{ q, options: string[], answer: number }]
  passScore   Int      @default(70)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, sortOrder])
}

model TrainingProgress {
  id          String    @id @default(cuid())
  userId      String    @db.VarChar(40)
  courseId    String    @db.VarChar(40)
  lessonId    String    @db.VarChar(40)
  completedAt DateTime?
  quizScore   Int?
  attempts    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([courseId])
}

/// Four-eyes check: a second staff member approves the embassy package before it is marked as sent / lodged.
model EmbassyPackageApproval {
  id            String    @id @default(cuid())
  caseId        String    @db.VarChar(40)
  status        String    @default("PENDING") @db.VarChar(12) // PENDING | APPROVED | REJECTED | OVERRIDDEN
  packageHash   String?   @db.Char(64)
  packageNodeId String?   @db.VarChar(40)
  requestedById String    @db.VarChar(40)
  requestedAt   DateTime  @default(now())
  reviewerId    String?   @db.VarChar(40)
  reviewedAt    DateTime?
  comment       String?   @db.Text
  checklist     Json? // [{ key, ok, note }]

  @@index([caseId, requestedAt])
  @@index([status])
}

model StaffShift {
  id          String   @id @default(cuid())
  userId      String   @db.VarChar(40)
  date        DateTime @db.Date
  startMin    Int // minutes after midnight, Baku time
  endMin      Int
  kind        String   @default("OFFICE") @db.VarChar(12) // OFFICE | REMOTE | ON_CALL
  note        String?  @db.VarChar(300)
  createdById String?  @db.VarChar(40)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([userId, date])
}

/// Content for the client "waiting room": short lessons, videos and exercises while the case is in progress.
model WaitingRoomItem {
  id        String   @id @default(cuid())
  kind      String   @db.VarChar(12) // LESSON | VIDEO | EXERCISE | CHECKLIST
  topic     String   @db.VarChar(40) // life | work | language | bureaucracy | culture
  title     Json // L10n
  body      Json? // L10n markdown
  videoUrl  String?  @db.Text
  exercise  Json? // [{ q: L10n, options: L10n[], answer: number }]
  minutes   Int?
  visaTypes Json? // VisaType[]; null = all
  stages    Json? // CaseStatus[]; null = all
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model WaitingRoomProgress {
  id          String    @id @default(cuid())
  userId      String    @db.VarChar(40)
  itemId      String    @db.VarChar(40)
  completedAt DateTime?
  score       Int?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, itemId])
}

/// Versioned legal texts (AGB / privacy / cookies); consents point at the version the person accepted.
model LegalDocument {
  id                   String    @id @default(cuid())
  kind                 String    @db.VarChar(20) // TERMS | PRIVACY | COOKIES
  version              String    @db.VarChar(40)
  title                Json // L10n
  body                 Json // L10n markdown
  changeSummary        Json? // L10n "what changed"
  requiresReacceptance Boolean   @default(false)
  status               String    @default("DRAFT") @db.VarChar(12) // DRAFT | PUBLISHED | ARCHIVED
  publishedAt          DateTime?
  effectiveAt          DateTime?
  createdById          String?   @db.VarChar(40)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([kind, version])
  @@index([kind, status])
}

/// Long SEO guide pages (Chancenkarte, Blue Card, Ausbildung …) with a localised slug per language.
model GuidePage {
  id          String   @id @default(cuid())
  key         String   @db.VarChar(60) // chancenkarte | blue-card | ausbildung | anerkennung | pflege | familiennachzug …
  locale      String   @db.VarChar(8) // az | de | en | ru | tr | uk
  slug        String   @db.VarChar(160)
  title       String   @db.VarChar(200)
  description String   @db.VarChar(400)
  body        String   @db.LongText // markdown
  faq         Json? // [{ q, a }]
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, locale])
  @@unique([locale, slug])
}

// ─── Simplification round: admin page usage, job alerts, lead magnets ─

/// Daily count of admin page opens per user (to find unused pages).
model AdminPageVisit {
  id     String   @id @default(cuid())
  userId String   @db.VarChar(40)
  navId  String   @db.VarChar(60) // nav registry id (or route key)
  day    DateTime @db.Date
  count  Int      @default(1)

  @@unique([userId, navId, day])
  @@index([navId, day])
  @@index([day])
}

/// "Tell me when a vacancy for this profession appears" (double opt-in).
model JobAlert {
  id             String    @id @default(cuid())
  email          String    @db.VarChar(190)
  userId         String?   @db.VarChar(40)
  locale         String    @default("az") @db.VarChar(8)
  professions    Json // string[]
  germanLevel    String?   @db.VarChar(4)
  visaTypes      Json?
  tokenHash      String    @unique @db.Char(64) // manage / unsubscribe link
  confirmedAt    DateTime?
  lastSentAt     DateTime?
  sentCount      Int       @default(0)
  unsubscribedAt DateTime?
  visitorId      String?   @db.VarChar(40)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@index([confirmedAt])
}

/// Downloadable guide (e-book) offered in exchange for an e-mail address.
model LeadMagnet {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(120)
  title       Json // L10n
  description Json? // L10n
  coverUrl    String?  @db.Text
  files       Json // { az: "upload key", de: … } — PDF per language
  published   Boolean  @default(true)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Official forms, client billing, service packages, employer reports ─

/// An official fillable PDF (national visa application, Erklärung zum Beschäftigungsverhältnis …) with its field mapping.
model OfficialFormTemplate {
  id          String   @id @default(cuid())
  key         String   @db.VarChar(60) // NATIONAL_VISA | EMPLOYMENT_DECLARATION | …
  title       String   @db.VarChar(200)
  version     String   @db.VarChar(40)
  fileKey     String   @db.VarChar(300) // stored PDF
  fieldMap    Json // { "<pdf field name>": { source: "client.lastName" | "const:…" | "contract.grossMonthly", format? } }
  active      Boolean  @default(true)
  notes       String?  @db.Text
  createdById String?  @db.VarChar(40)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, version])
  @@index([key, active])
}

/// One filled form for a case (values snapshot, generated PDF, employer signature).
model OfficialFormFill {
  id                 String    @id @default(cuid())
  templateId         String    @db.VarChar(40)
  caseId             String    @db.VarChar(40)
  companyId          String?   @db.VarChar(40)
  values             Json
  missing            Json? // field names / data keys still empty
  fileKey            String?   @db.VarChar(300)
  driveNodeId        String?   @db.VarChar(40)
  status             String    @default("DRAFT") @db.VarChar(20) // DRAFT | GENERATED | SENT_TO_EMPLOYER | SIGNED | SUBMITTED
  signatureRequestId String?   @db.VarChar(40)
  generatedAt        DateTime?
  createdById        String?   @db.VarChar(40)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([caseId])
  @@index([companyId, status])
}

/// Invoice to a private client (service fee, translations, apostille …) — company invoices stay in Invoice.
model ClientInvoice {
  id            String    @id @default(cuid())
  number        String    @unique @db.VarChar(32) // TV-KR-2026-0001
  clientId      String    @db.VarChar(40)
  caseId        String?   @db.VarChar(40)
  issueDate     DateTime
  dueDate       DateTime
  currency      String    @default("EUR") @db.VarChar(3)
  items         Json // [{ description, quantity, unitPriceCents, category? }]
  netCents      Int
  vatRate       Int       @default(19)
  vatCents      Int
  grossCents    Int
  paidCents     Int       @default(0)
  status        String    @default("DRAFT") @db.VarChar(20) // DRAFT | SENT | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  sentAt        DateTime?
  paidAt        DateTime?
  note          String?   @db.Text
  planId        String?   @db.VarChar(40)
  installmentId String?   @db.VarChar(40)
  orderId       String?   @db.VarChar(40)
  remindedAt    DateTime?
  reminderCount Int       @default(0)
  createdById   String?   @db.VarChar(40)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([caseId])
  @@index([status, dueDate])
}

model ClientPayment {
  id           String   @id @default(cuid())
  clientId     String   @db.VarChar(40)
  invoiceId    String?  @db.VarChar(40)
  caseId       String?  @db.VarChar(40)
  amountCents  Int
  currency     String   @default("EUR") @db.VarChar(3)
  method       String   @db.VarChar(12) // CASH | BANK | CARD | OTHER
  paidAt       DateTime
  reference    String?  @db.VarChar(120)
  note         String?  @db.VarChar(500)
  recordedById String?  @db.VarChar(40)
  createdAt    DateTime @default(now())

  @@index([clientId, paidAt])
  @@index([invoiceId])
}

/// Instalment plan for a client (e.g. 40 % on signing, 30 % at embassy, 30 % on approval).
model PaymentPlan {
  id          String   @id @default(cuid())
  clientId    String   @db.VarChar(40)
  caseId      String?  @db.VarChar(40)
  title       String   @db.VarChar(200)
  totalCents  Int
  currency    String   @default("EUR") @db.VarChar(3)
  status      String   @default("ACTIVE") @db.VarChar(12) // ACTIVE | COMPLETED | CANCELLED
  orderId     String?  @db.VarChar(40)
  createdById String?  @db.VarChar(40)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([caseId])
}

model PaymentInstallment {
  id          String    @id @default(cuid())
  planId      String    @db.VarChar(40)
  seq         Int
  label       String?   @db.VarChar(160)
  trigger     String?   @db.VarChar(40) // DATE | ON_SIGN | CASE_STATUS:<status>
  dueDate     DateTime?
  amountCents Int
  invoiceId   String?   @db.VarChar(40)
  status      String    @default("PENDING") @db.VarChar(12) // PENDING | INVOICED | PAID | OVERDUE | CANCELLED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([planId, seq])
  @@index([status, dueDate])
}

/// Public service package (Basic / Standard / Premium) a client can order and sign online.
model ServicePackage {
  id                 String   @id @default(cuid())
  slug               String   @unique @db.VarChar(120)
  tier               String   @db.VarChar(12) // BASIC | STANDARD | PREMIUM
  visaTypes          Json? // VisaType[]; null = all
  title              Json // L10n
  summary            Json // L10n
  features           Json // L10nList
  priceCents         Int
  currency           String   @default("EUR") @db.VarChar(3)
  installments       Json? // [{ label: L10n, percent, trigger }]
  contractTemplateId String?  @db.VarChar(40)
  highlight          Boolean  @default(false)
  published          Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PackageOrder {
  id                 String   @id @default(cuid())
  packageId          String   @db.VarChar(40)
  clientId           String?  @db.VarChar(40)
  email              String   @db.VarChar(190)
  name               String   @db.VarChar(160)
  phone              String?  @db.VarChar(40)
  locale             String   @default("az") @db.VarChar(8)
  visaType           String?  @db.VarChar(30)
  priceCents         Int
  currency           String   @default("EUR") @db.VarChar(3)
  status             String   @default("STARTED") @db.VarChar(12) // STARTED | SIGNED | ACTIVE | CANCELLED
  signatureRequestId String?  @db.VarChar(40)
  caseId             String?  @db.VarChar(40)
  planId             String?  @db.VarChar(40)
  tokenHash          String?  @unique @db.Char(64)
  inquiryId          String?  @db.VarChar(40)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([clientId])
}

/// Monthly PDF report to an employer about its workers (arrived, on the way, risks).
model EmployerReport {
  id        String    @id @default(cuid())
  companyId String    @db.VarChar(40)
  month     String    @db.VarChar(7) // YYYY-MM
  fileKey   String?   @db.VarChar(300)
  stats     Json
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([companyId, month])
}

// ─── Recognition (Anerkennung) and the accelerated skilled-worker procedure (§81a AufenthG) ─

/// Recognition of a foreign qualification for a case: authority, procedure, deficits, adaptation measure.
model RecognitionProcess {
  id                String    @id @default(cuid())
  caseId            String    @db.VarChar(40)
  clientId          String    @db.VarChar(40)
  profession        String    @db.VarChar(160) // German reference profession (Referenzberuf)
  regulated         Boolean   @default(false)
  procedureType     String    @db.VarChar(30) // ZAB_STATEMENT | FULL_RECOGNITION | PARTIAL_RECOGNITION | IHK_FOSA | HWK
  authority         String?   @db.VarChar(200) // e.g. ZAB, Landesamt für Gesundheit, IHK FOSA
  federalState      String?   @db.VarChar(40)
  reference         String?   @db.VarChar(120) // Aktenzeichen
  status            String    @default("PREPARING") @db.VarChar(20) // PREPARING | SUBMITTED | IN_REVIEW | DEFICIT_NOTICE | ADAPTATION | RECOGNISED | PARTIALLY_RECOGNISED | REJECTED | WITHDRAWN
  checklist         Json? // [{ key, label, done, documentId? }]
  submittedAt       DateTime?
  feeCents          Int?
  feePaidAt         DateTime?
  decisionAt        DateTime?
  deficitNotes      String?   @db.Text
  adaptationMeasure String?   @db.VarChar(30) // ANPASSUNGSLEHRGANG | KENNTNISPRUEFUNG | EIGNUNGSPRUEFUNG
  adaptationUntil   DateTime?
  nextDeadline      DateTime?
  nextDeadlineNote  String?   @db.VarChar(300)
  note              String?   @db.Text
  createdById       String?   @db.VarChar(40)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([caseId])
  @@index([status, nextDeadline])
}

model RecognitionEvent {
  id         String   @id @default(cuid())
  processId  String   @db.VarChar(40)
  type       String   @db.VarChar(30) // STATUS | NOTE | DOCUMENT | LETTER_IN | LETTER_OUT | DEADLINE
  fromStatus String?  @db.VarChar(20)
  toStatus   String?  @db.VarChar(20)
  note       String?  @db.Text
  documentId String?  @db.VarChar(40)
  actorId    String?  @db.VarChar(40)
  at         DateTime @default(now())

  @@index([processId, at])
}

/// Beschleunigtes Fachkräfteverfahren (§81a AufenthG) run by the employer via the Ausländerbehörde.
model AcceleratedProcedure {
  id                  String    @id @default(cuid())
  caseId              String    @unique @db.VarChar(40)
  companyId           String?   @db.VarChar(40)
  authority           String?   @db.VarChar(200) // zuständige Ausländerbehörde
  authorityEmail      String?   @db.VarChar(190)
  reference           String?   @db.VarChar(120)
  status              String    @default("PREPARING") @db.VarChar(24) // PREPARING | POWER_OF_ATTORNEY | AGREEMENT_SIGNED | SUBMITTED | FEE_REQUESTED | FEE_PAID | IN_REVIEW | PRE_APPROVAL | SENT_TO_EMBASSY | APPOINTMENT_BOOKED | VISA_DECIDED | REJECTED | CANCELLED
  powerOfAttorneyAt   DateTime?
  agreementSignedAt   DateTime? // Vereinbarung employer ↔ Ausländerbehörde
  submittedAt         DateTime?
  feeCents            Int?
  feeRequestedAt      DateTime?
  feePaidAt           DateTime?
  preApprovalAt       DateTime? // Vorabzustimmung
  preApprovalDocId    String?   @db.VarChar(40)
  embassyNotifiedAt   DateTime?
  appointmentDeadline DateTime? // embassy appointment within 3 weeks of the pre-approval
  appointmentAt       DateTime?
  decisionDeadline    DateTime? // embassy decision usually within 3 weeks of the complete application
  decidedAt           DateTime?
  note                String?   @db.Text
  createdById         String?   @db.VarChar(40)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([companyId])
}

/// Correspondence log with the Ausländerbehörde / embassy for a §81a procedure.
model AcceleratedMessage {
  id          String    @id @default(cuid())
  procedureId String    @db.VarChar(40)
  direction   String    @db.VarChar(4) // IN | OUT
  channel     String    @db.VarChar(10) // EMAIL | LETTER | PORTAL | PHONE | FAX
  subject     String?   @db.VarChar(300)
  body        String?   @db.Text
  documentId  String?   @db.VarChar(40)
  dueAt       DateTime? // reply deadline set by the authority
  actorId     String?   @db.VarChar(40)
  at          DateTime  @default(now())

  @@index([procedureId, at])
}

/// History of the team document workflow of a case ("Schon geschrieben" → "Fertig", "Ablehnung"): who moved it, when, to whom, with a note.
model CaseProcessingMove {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStage  String?  @db.VarChar(16)
  toStage    String   @db.VarChar(16)
  actorId    String?  @db.VarChar(40)
  assigneeId String?  @db.VarChar(40)
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([assigneeId])
}

// ─── Skill videos (candidate shows a skill: vehicle check, weld seam, …) ─────

enum SkillVideoStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Short video a candidate records or uploads to show a practical skill. Employers see it only when staff
/// approved it, the candidate consents (consentAt set, not withdrawn) and the candidate was presented to them.
/// Files: <uploads>/private/skill-video/<storedName> (+ optional JPEG/PNG poster). Design: lib/skillVideos.
model SkillVideo {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation("SkillVideoOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// Case of the candidate at upload time (plain id); retention runs off the candidate's closed cases.
  caseId             String?          @db.VarChar(40)
  title              String           @db.VarChar(120)
  skill              String           @db.VarChar(40) // tag key: driver | welder | cook | nurse | … | safety | other
  source             String           @db.VarChar(10) // RECORDED | UPLOADED
  storedName         String           @db.VarChar(200)
  mimeType           String           @db.VarChar(40)
  size               Int
  durationSec        Int?
  posterName         String?          @db.VarChar(200)
  status             SkillVideoStatus @default(PENDING)
  rejectReason       String?          @db.Text
  reviewedById       String?          @db.VarChar(40)
  reviewedAt         DateTime?
  /// Consent that prospective employers may watch it; withdrawing hides it immediately.
  consentAt          DateTime?
  consentWithdrawnAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  views              SkillVideoView[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// One employer view of a skill video (deduplicated per viewer and video within 30 minutes).
model SkillVideoView {
  id            String     @id @default(cuid())
  videoId       String
  video         SkillVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  companyId     String     @db.VarChar(40)
  viewerId      String?    @db.VarChar(40)
  applicationId String?    @db.VarChar(40)
  createdAt     DateTime   @default(now())

  @@index([videoId, createdAt])
  @@index([companyId])
}

// ─── Pre-departure course (LMS) for candidates: course → module → lesson, quizzes, certificate ─────

enum CourseLessonKind {
  VIDEO
  TEXT
  QUIZ
}

enum CourseQuestionKind {
  SINGLE
  MULTIPLE
}

/// A course for candidates (client portal → Öyrən → Kurs). Texts are L10n JSON. Design: lib/course.
model Course {
  id                 String    @id @default(cuid())
  /// Stable key (the starter course is "pre-departure"); unique, so seeding is idempotent.
  slug               String    @unique @db.VarChar(80)
  title              Json
  description        Json?
  /// Shown on the overview and in every lesson ("general information, not legal advice").
  disclaimer         Json?
  published          Boolean   @default(false)
  /// CaseStatus[]: CLIENT users with a case in one of these statuses are enrolled automatically; null / [] = manual only.
  autoEnrollStatuses Json?
  sortOrder          Int       @default(0)
  createdById        String?   @db.VarChar(40)
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([published, sortOrder])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String   @db.VarChar(40)
  title       Json
  description Json?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, sortOrder])
}

/// Files live in <uploads>/private/course/ (video with HTTP range streaming, poster image, WebVTT subtitles per locale).
model CourseLesson {
  id            String           @id @default(cuid())
  courseId      String           @db.VarChar(40)
  moduleId      String           @db.VarChar(40)
  kind          CourseLessonKind
  title         Json
  body          Json? // L10n markdown (TEXT; intro text for VIDEO / QUIZ)
  minutes       Int?
  videoKey      String?          @db.VarChar(200)
  videoMime     String?          @db.VarChar(40)
  videoSize     Int?
  videoDuration Int? // seconds
  posterKey     String?          @db.VarChar(200)
  subtitles     Json? // { az?: key, de?: key, en?: key, ru?: key }
  passMark      Int              @default(70) // QUIZ: percent needed to pass
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([moduleId, sortOrder])
  @@index([courseId])
}

model CourseQuizQuestion {
  id          String             @id @default(cuid())
  lessonId    String             @db.VarChar(40)
  kind        CourseQuestionKind @default(SINGLE)
  prompt      Json // L10n
  options     Json // L10n[]
  correct     Json // number[] (indexes into options)
  explanation Json? // L10n, shown after answering
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([lessonId, sortOrder])
}

model CourseEnrollment {
  id             String    @id @default(cuid())
  courseId       String    @db.VarChar(40)
  userId         String    @db.VarChar(40)
  source         String    @default("AUTO") @db.VarChar(8) // AUTO | MANUAL
  enrolledById   String?   @db.VarChar(40)
  enrolledAt     DateTime  @default(now())
  /// Staff removed the enrollment (kept, so automatic enrollment does not bring it back).
  removedAt      DateTime?
  completedAt    DateTime?
  lastActivityAt DateTime?

  @@unique([courseId, userId])
  @@index([userId])
}

model CourseLessonProgress {
  id              String    @id @default(cuid())
  userId          String    @db.VarChar(40)
  courseId        String    @db.VarChar(40)
  lessonId        String    @db.VarChar(40)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  watchedSeconds  Int       @default(0)
  positionSeconds Int       @default(0)
  updatedAt       DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([courseId, userId])
}

model CourseQuizAttempt {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(40)
  courseId  String   @db.VarChar(40)
  lessonId  String   @db.VarChar(40)
  answers   Json // number[][] (chosen option indexes per question)
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([userId, lessonId, createdAt])
  @@index([courseId])
}

/// Completion certificate. The public page /certificate/:code shows only the holder's initials, course and date.
model CourseCertificate {
  id         String   @id @default(cuid())
  number     String   @unique @db.VarChar(40)
  code       String   @unique @db.VarChar(32)
  courseId   String   @db.VarChar(40)
  userId     String   @db.VarChar(40)
  holderName String   @db.VarChar(200)
  issuedAt   DateTime @default(now())

  @@unique([courseId, userId])
  @@index([userId])
}

// ─── First-month budget calculator (lib/budget) ─────────────────────────

/// Cost of living per destination for the first-month budget (/budget). Conservative, dated estimates,
/// editable by ADMIN+ (Sayt → Şəhər xərcləri, audit-logged). kind GENERIC = fallback per size class.
model CityCost {
  id            String   @id @default(cuid())
  slug          String   @unique @db.VarChar(60)
  name          String   @db.VarChar(80)
  /// CITY (a real city) | GENERIC (size-class fallback for places without an own row)
  kind          String   @default("CITY") @db.VarChar(10)
  /// Bundesland code (BW, BY, BE …); null for GENERIC rows
  state         String?  @db.VarChar(2)
  /// METRO | LARGE | MEDIUM | SMALL
  sizeClass     String   @default("LARGE") @db.VarChar(10)
  /// Nearby towns matched to this row (comma separated), e.g. vacancy cities around a big city
  aliases       String?  @db.Text
  /// EUR per month: WG room all-in; flats cold (Kaltmiete) + utilities incl. heating (Nebenkosten)
  wgMin         Int
  wgMax         Int
  flat1ColdMin  Int
  flat1ColdMax  Int
  flat1UtilMin  Int
  flat1UtilMax  Int
  flat2ColdMin  Int
  flat2ColdMax  Int
  flat2UtilMin  Int
  flat2UtilMax  Int
  /// Typical employer-provided room (all-in) when the company gives no figure
  companyMin    Int
  companyMax    Int
  /// Food and household per adult and month
  foodMin       Int
  foodMax       Int
  /// Local transport per adult and month (Deutschlandticket unless set otherwise)
  transport     Int      @default(63)
  /// Typical deposit in net cold rents (legal maximum 3, §551 BGB)
  depositMonths Float    @default(3)
  sourceNote    String?  @db.Text
  /// Date the figures were checked (shown as "as of")
  checkedAt     DateTime @db.Date
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, sortOrder])
}
