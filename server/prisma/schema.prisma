// ─── Privacy (DSGVO / GDPR) ─────────────────────────────────────────────

/// Append-only log of consents given or withdrawn (who, what, which text version, when, from where).
model ConsentRecord {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String?  @db.VarChar(200) // for consents given before an account exists (booking, inquiry)
  type            String   @db.VarChar(40) // PRIVACY_POLICY | TERMS | MARKETING_EMAIL | WHATSAPP | SMS | EMPLOYER_SHARING | PASSPORT_OCR ...
  granted         Boolean
  version         String   @db.VarChar(40) // version / date of the policy text shown
  source          String   @db.VarChar(40) // REGISTER | PROFILE | PRIVACY_CENTER | BOOKING | INQUIRY | MOBILE ...
  ip              String?  @db.VarChar(64)
  userAgent       String?  @db.VarChar(400)
  /// The published legal text version the consent refers to (LegalDocument), and the anonymous visitor for cookie consent.
  legalDocumentId String?  @db.VarChar(40)
  visitorId       String?  @db.VarChar(40)
  createdAt       DateTime @default(now())

  @@index([userId, type, createdAt])
  @@index([email])
}

enum PrivacyRequestType {
  EXPORT // Art. 15 / 20
  DELETION // Art. 17
  RECTIFICATION // Art. 16
  RESTRICTION // Art. 18
  OBJECTION // Art. 21
}

enum PrivacyRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

model PrivacyRequest {
  id           String               @id @default(cuid())
  userId       String?
  user         User?                @relation("PrivacyRequester", fields: [userId], references: [id], onDelete: SetNull)
  email        String               @db.VarChar(200) // kept after the account is deleted (proof of completion)
  type         PrivacyRequestType
  status       PrivacyRequestStatus @default(OPEN)
  message      String?              @db.Text
  decisionNote String?              @db.Text
  dueAt        DateTime // one month after the request (Art. 12(3))
  handledById  String?
  handledBy    User?                @relation("PrivacyHandler", fields: [handledById], references: [id], onDelete: SetNull)
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, dueAt])
  @@index([userId])
}

// ─── Client tools: CV, motivation letters, document vault, arrival ──────

/// Structured CV data (Lebenslauf / Europass) of a client; personal basics come from the User row.
model CandidateCv {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// { photoVaultId?, headline, summary, experience[], education[], languages[], skills[], certificates[], drivingLicences[], interests[] }
  data               Json
  template           String   @default("lebenslauf") @db.VarChar(20) // lebenslauf | europass
  /// May staff present this CV (anonymised) to employers?
  shareWithEmployers Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

enum LetterKind {
  VISA // Motivationsschreiben for the embassy
  JOB // Anschreiben for an employer / vacancy
  ANERKENNUNG // cover letter for the recognition authority
}

model MotivationLetter {
