}

model ChatMember {
  id         String         @id @default(cuid())
  channelId  String
  channel    ChatChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ChatMemberRole @default(MEMBER)
  joinedAt   DateTime       @default(now())
  lastReadAt DateTime?
  muted      Boolean        @default(false)
  pinned     Boolean        @default(false)

  @@unique([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id          String           @id @default(cuid())
  channelId   String
  channel     ChatChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body        String           @db.Text
  parentId    String? // thread reply
  parent      ChatMessage?     @relation("ChatThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ChatMessage[]    @relation("ChatThread")
  replyCount  Int              @default(0)
  mentions    Json? // user ids mentioned
  editedAt    DateTime?
  deletedAt   DateTime?
  pinnedAt    DateTime?
  createdAt   DateTime         @default(now())
  attachments ChatAttachment[]
  reactions   ChatReaction[]

  @@index([channelId, createdAt])
  @@index([parentId])
  @@fulltext([body])
}

model ChatAttachment {
  id          String      @id @default(cuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String      @db.VarChar(255)
  mimeType    String      @db.VarChar(120)
  size        Int
  storageKey  String      @unique // <DOCS_DIR>/chat/<key>
  driveNodeId String? // when shared from the team drive instead of uploaded

  @@index([messageId])
}

model ChatReaction {
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String      @db.VarChar(16)
  createdAt DateTime    @default(now())

  @@id([messageId, userId, emoji])
}

// ─── Team workspace: calendar ───────────────────────────────────────────

