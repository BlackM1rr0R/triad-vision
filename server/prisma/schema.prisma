  @@index([userId, startsAt])
  @@index([status])
}

// ─── Online electronic signatures (multi-party) ─────────────────────────
// Simple electronic signature (einfache elektronische Signatur, eIDAS Art. 25(1)) with an audit trail.

enum SignatureRequestStatus {
  DRAFT
  SENT
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED
}

enum SignatureOrder {
  SEQUENTIAL // by signer order (candidate → company → Triad Vision); equal order numbers sign in parallel
  PARALLEL
}

enum SignerRole {
  CANDIDATE
  COMPANY
  STAFF
  OTHER
}

enum SignerStatus {
  PENDING
  VIEWED
  SIGNED
  DECLINED
}

enum SignatureEventType {
  CREATED
  SENT
  VIEWED
  OTP_SENT
  OTP_VERIFIED
  SIGNED
  DECLINED
  REMINDED
  COMPLETED
  CANCELLED
  EXPIRED
  DOWNLOADED
}

/// A document sent to one or more parties for signature. PDFs live in the private upload dir
/// (originalKey / finalKey = stored file names); the SHA-256 of every version is kept.
model SignatureRequest {
  id              String                 @id @default(cuid())
  title           String                 @db.VarChar(200)
  caseId          String?
  case            Case?                  @relation(fields: [caseId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?                  @relation("SignatureRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  status          SignatureRequestStatus @default(DRAFT)
  order           SignatureOrder         @default(SEQUENTIAL)
  /// The case's employment contract: completion marks Case.contract as signed.
  isCaseContract  Boolean                @default(false)
  originalName    String                 @db.VarChar(255)
  originalKey     String                 @unique @db.VarChar(191)
  originalSha256  String                 @db.Char(64)
  originalSize    Int
  originalPages   Int
  finalKey        String?                @unique @db.VarChar(191)
  finalSha256     String?                @db.Char(64)
  finalSize       Int?
  /// Case Document (stage CONTRACT_SIGNED) holding a copy of the final PDF.
  finalDocumentId String?
  message         String?                @db.Text
  expiresAt       DateTime?
  sentAt          DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  signers         SignatureSigner[]
  events          SignatureEvent[]

  @@index([status, expiresAt])
  @@index([caseId])
  @@index([companyId])
  @@index([createdAt])
}

/// One party of a request. The email link carries a random token; only its SHA-256 is stored.
model SignatureSigner {
  id                String           @id @default(cuid())
  requestId         String
  request           SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  role              SignerRole
  userId            String?
  user              User?            @relation("SignatureSignerUser", fields: [userId], references: [id], onDelete: SetNull)
  name              String           @db.VarChar(160)
  email             String           @db.VarChar(191)
  /// Mobile number for the signing code (SMS); falls back to e-mail when there is none or SMS is not set up.
  phone             String?          @db.VarChar(32)
  locale            Locale           @default(az)
  order             Int              @default(1)
  status            SignerStatus     @default(PENDING)
  /// sha256(hex) of the current link token; null until the signer is invited (sequential order).
  tokenHash         String?          @unique @db.Char(64)
  invitedAt         DateTime?
  viewedAt          DateTime?
  signedAt          DateTime?
  declinedAt        DateTime?
  declinedReason    String?          @db.Text
  /// DRAW = hand-drawn image, TYPE = typed name.
  signatureMode     String?          @db.VarChar(8)
  signatureImageKey String?          @db.VarChar(191)
  typedName         String?          @db.VarChar(160)
  /// EMAIL_OTP (link + emailed code) or PORTAL (logged-in account).
  authMethod        String?          @db.VarChar(16)
  ip                String?          @db.VarChar(64)
  userAgent         String?          @db.Text
  // Email code (identity check before signing via the link)
  otpHash           String?          @db.Char(64)
  otpExpiresAt      DateTime?
  otpAttempts       Int              @default(0)
  otpSentAt         DateTime?
  otpWindowAt       DateTime?
  otpWindowCount    Int              @default(0)
  otpVerifiedAt     DateTime?
  /// sha256 of the short-lived signing session handed out after a correct code (HttpOnly cookie).
  sessionHash       String?          @db.Char(64)
  sessionExpiresAt  DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  events            SignatureEvent[]

  @@index([requestId, order])
  @@index([userId])
}

/// Audit trail of a request (printed on the certificate of completion).
model SignatureEvent {
  id        String             @id @default(cuid())
  requestId String
  request   SignatureRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  signerId  String?
  signer    SignatureSigner?   @relation(fields: [signerId], references: [id], onDelete: SetNull)
  actorId   String?
  type      SignatureEventType
  note      String?            @db.Text
  ip        String?            @db.VarChar(64)
  userAgent String?            @db.Text
  at        DateTime           @default(now())

  @@index([requestId, at])
}

// ─── Agent / partner programme ──────────────────────────────────────────

enum AgentStatus {
  ACTIVE
  PAUSED
}

enum CommissionType {
  FIXED // amountCents per qualifying event
  PERCENT // percent (basis points) of the paid invoice amount
}

/// A regional partner. Logs in with a User of role AGENT; clients who sign up with the agent's
/// link or code are attributed to the agent and earn commissions on the configured events.
model Agent {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation("AgentUser", fields: [userId], references: [id], onDelete: Cascade)
  code            String            @unique @db.VarChar(32) // referral code, e.g. GANJA-ALI
  region          String?           @db.VarChar(120)
  company         String?           @db.VarChar(160)
  status          AgentStatus       @default(ACTIVE)
  commissionType  CommissionType    @default(FIXED)
  commissionValue Int               @default(0) // cents (FIXED) or basis points (PERCENT, 1000 = 10 %)
  currency        String            @default("EUR") @db.VarChar(3)
  /// Which case events pay a commission: ["CASE_CREATED","CONTRACT_SIGNED","VISA_APPROVED","INVOICE_PAID"]
  payoutEvents    Json?
  iban            String?           @db.VarChar(64)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  referrals       User[]            @relation("AgentReferrals")
  commissions     AgentCommission[]

  @@index([status])
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model AgentCommission {
  id          String           @id @default(cuid())
  agentId     String
  agent       Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  clientId    String?
  client      User?            @relation("CommissionClient", fields: [clientId], references: [id], onDelete: SetNull)
  caseId      String?
  case        Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull)
  event       String           @db.VarChar(40) // CASE_CREATED | CONTRACT_SIGNED | VISA_APPROVED | INVOICE_PAID | MANUAL
  sourceRef   String?          @db.VarChar(80) // e.g. invoice id; with event it keeps a commission from being created twice
  amountCents Int
  currency    String           @default("EUR") @db.VarChar(3)
  status      CommissionStatus @default(PENDING)
  note        String?          @db.VarChar(500)
  payoutRef   String?          @db.VarChar(120) // bank transfer reference when paid
  approvedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([agentId, event, caseId, sourceRef])
  @@index([agentId, status])
  @@index([status, createdAt])
}

// ─── Translation and apostille orders ───────────────────────────────────

enum TranslationService {
  TRANSLATION
  APOSTILLE
  TRANSLATION_APOSTILLE
  NOTARY
}

enum TranslationStatus {
  NEW // submitted by the client
  QUOTED // staff sent price and due date
  ACCEPTED // client accepted the quote
  IN_PROGRESS
  READY // finished, waiting for delivery / pick-up
  DELIVERED
  CANCELLED
}

enum TranslationUrgency {
  STANDARD
  EXPRESS
}

enum DeliveryMethod {
  DIGITAL
  PICKUP
  COURIER
}

model TranslationOrder {
  id              String                  @id @default(cuid())
  number          Int                     @unique // shown as TR-0001
  clientId        String
  client          User                    @relation("TranslationClient", fields: [clientId], references: [id], onDelete: Cascade)
  caseId          String?
  case            Case?                   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  service         TranslationService
  sourceLang      String                  @db.VarChar(8)
  targetLang      String                  @db.VarChar(8)
  documentTypes   Json? // ["DIPLOMA","BIRTH_CERT",...]
  pages           Int                     @default(1)
  urgency         TranslationUrgency      @default(STANDARD)
  status          TranslationStatus       @default(NEW)
  priceCents      Int?
  currency        String                  @default("EUR") @db.VarChar(3)
  quoteNote       String?                 @db.Text
  dueAt           DateTime?
  deliveryMethod  DeliveryMethod          @default(DIGITAL)
  deliveryAddress String?                 @db.VarChar(300)
  trackingNumber  String?                 @db.VarChar(80)
  clientNote      String?                 @db.Text
  staffNote       String?                 @db.Text // internal
  assignedStaffId String?
  assignedStaff   User?                   @relation("TranslationStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  acceptedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  files           TranslationOrderFile[]
  events          TranslationOrderEvent[]

  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

enum TranslationFileKind {
  SOURCE // uploaded by the client (or picked from the case documents)
  RESULT // finished translation / apostilled scan uploaded by staff
}

model TranslationOrderFile {
  id         String              @id @default(cuid())
  orderId    String
  order      TranslationOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind       TranslationFileKind
  documentId String? // case document reused as the source
  storageKey String?             @unique // <UPLOADS>/private/translations/<key>
  filename   String              @db.VarChar(255)
  mimeType   String              @db.VarChar(120)
  size       Int
  createdAt  DateTime            @default(now())

  @@index([orderId, kind])
}

model TranslationOrderEvent {
  id              String             @id @default(cuid())
  orderId         String
  order           TranslationOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          TranslationStatus?
  note            String?            @db.Text
  visibleToClient Boolean            @default(true)
  actorId         String?
  actor           User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())

  @@index([orderId, createdAt])
}

// ─── Privacy (DSGVO / GDPR) ─────────────────────────────────────────────

/// Append-only log of consents given or withdrawn (who, what, which text version, when, from where).
model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?  @db.VarChar(200) // for consents given before an account exists (booking, inquiry)
  type      String   @db.VarChar(40) // PRIVACY_POLICY | TERMS | MARKETING_EMAIL | WHATSAPP | SMS | EMPLOYER_SHARING | PASSPORT_OCR ...
  granted   Boolean
  version   String   @db.VarChar(40) // version / date of the policy text shown
  source    String   @db.VarChar(40) // REGISTER | PROFILE | PRIVACY_CENTER | BOOKING | INQUIRY | MOBILE ...
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(400)
  createdAt DateTime @default(now())

  @@index([userId, type, createdAt])
  @@index([email])
}

enum PrivacyRequestType {
  EXPORT // Art. 15 / 20
  DELETION // Art. 17
  RECTIFICATION // Art. 16
  RESTRICTION // Art. 18
  OBJECTION // Art. 21
}

enum PrivacyRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

model PrivacyRequest {
  id           String               @id @default(cuid())
  userId       String?
  user         User?                @relation("PrivacyRequester", fields: [userId], references: [id], onDelete: SetNull)
  email        String               @db.VarChar(200) // kept after the account is deleted (proof of completion)
  type         PrivacyRequestType
  status       PrivacyRequestStatus @default(OPEN)
  message      String?              @db.Text
  decisionNote String?              @db.Text
  dueAt        DateTime // one month after the request (Art. 12(3))
  handledById  String?
  handledBy    User?                @relation("PrivacyHandler", fields: [handledById], references: [id], onDelete: SetNull)
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, dueAt])
  @@index([userId])
}

// ─── Client tools: CV, motivation letters, document vault, arrival ──────

/// Structured CV data (Lebenslauf / Europass) of a client; personal basics come from the User row.
model CandidateCv {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// { photoVaultId?, headline, summary, experience[], education[], languages[], skills[], certificates[], drivingLicences[], interests[] }
  data               Json
  template           String   @default("lebenslauf") @db.VarChar(20) // lebenslauf | europass
  /// May staff present this CV (anonymised) to employers?
  shareWithEmployers Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

enum LetterKind {
  VISA // Motivationsschreiben for the embassy
  JOB // Anschreiben for an employer / vacancy
  ANERKENNUNG // cover letter for the recognition authority
}

model MotivationLetter {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      LetterKind
  caseId    String?
  case      Case?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  vacancyId String?
  title     String     @db.VarChar(200)
  language  String     @default("de") @db.VarChar(5)
  /// answers the template was filled with (motivation, strengths, plans …)
  answers   Json?
  body      String     @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, kind])
}

enum VaultDocKind {
  PASSPORT
  ID_CARD
  PHOTO
  DIPLOMA
  TRANSCRIPT
  CERTIFICATE
  EMPLOYMENT_REF
  LANGUAGE_CERT
  DRIVING_LICENCE
  BIRTH_CERT
  MARRIAGE_CERT
  POLICE_CLEARANCE
  CV
  OTHER
}

/// Personal document vault: uploaded once, reused for later cases, translation orders and family members.
model VaultDocument {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       VaultDocKind
  title      String       @db.VarChar(200)
  ownerName  String?      @db.VarChar(160) // whose document it is (the client or a family member)
  storageKey String       @unique // <UPLOADS>/private/vault/<key>
  filename   String       @db.VarChar(255)
  mimeType   String       @db.VarChar(120)
  size       Int
  issuedAt   DateTime?
  expiresAt  DateTime?
  checks     Json? // same quality checks as case documents
  ocr        Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId, kind])
  @@index([expiresAt])
}

enum ArrivalStatus {
  DRAFT // client is filling it in
  SUBMITTED // sent to the team
  CONFIRMED // pickup / housing organised
  COMPLETED // arrived
  CANCELLED
}

enum HousingStatus {
  NONE // not requested
  REQUESTED
  SEARCHING
  OFFERED
  ARRANGED
}

/// Travel and arrival planning of an approved case: flight, airport pickup, first accommodation.
model ArrivalPlan {
  id               String        @id @default(cuid())
  caseId           String        @unique
  case             Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientId         String
  client           User          @relation("ArrivalClient", fields: [clientId], references: [id], onDelete: Cascade)
  status           ArrivalStatus @default(DRAFT)
  flightDate       DateTime?
  flightNumber     String?       @db.VarChar(20)
  departureAirport String?       @db.VarChar(80)
  arrivalAirport   String?       @db.VarChar(80)
  arrivalTime      DateTime?
  travellers       Int           @default(1)
  luggageNote      String?       @db.VarChar(300)
  pickupRequested  Boolean       @default(false)
  pickupConfirmed  Boolean       @default(false)
  pickupDetails    String?       @db.Text // who picks up, meeting point, phone — written by staff
  housingStatus    HousingStatus @default(NONE)
  housingCity      String?       @db.VarChar(80)
  housingBudget    Int? // EUR per month
  housingFrom      DateTime?
  housingNote      String?       @db.Text // client wishes
  housingDetails   String?       @db.Text // address / contract details — written by staff
  clientNote       String?       @db.Text
  staffNote        String?       @db.Text // internal
  handledById      String?
  handledBy        User?         @relation("ArrivalStaff", fields: [handledById], references: [id], onDelete: SetNull)
  submittedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, flightDate])
}

// ─── Interview preparation, satisfaction, contract templates, employer requests ─

enum InterviewKind {
  EMBASSY // visa interview at the German embassy
  EMPLOYER // job interview with the German employer
}

/// Question bank for interview preparation: the question in four languages, a model answer in German.
model InterviewPrepQuestion {
  id        String        @id @default(cuid())
  kind      InterviewKind
  category  String        @db.VarChar(40) // personal | motivation | job | germany | family | finances | language …
  question  Json // { az, de, en, ru }
  answerDe  String        @db.Text // model answer in German (the client adapts it)
  tips      Json? // { az, de, en, ru } short advice
  visaTypes Json? // ["WORK","AUSBILDUNG",…]; null = every type
  sortOrder Int           @default(0)
  published Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([kind, published, sortOrder])
}

enum SurveyTrigger {
  VISA_APPROVED
  CASE_CLOSED // rejected or cancelled
}

/// Short satisfaction survey sent to the client when the visa is approved or the case is closed.
model SatisfactionSurvey {
  id         String        @id @default(cuid())
  caseId     String        @unique
  case       Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientId   String
  client     User          @relation("SurveyClient", fields: [clientId], references: [id], onDelete: Cascade)
  staffId    String? // assigned staff member at the time (results per employee)
  staff      User?         @relation("SurveyStaff", fields: [staffId], references: [id], onDelete: SetNull)
  trigger    SurveyTrigger
  tokenHash  String        @unique @db.Char(64) // sha256 of the link token (answer without logging in)
  score      Int? // 0–10 recommendation score (NPS)
  ratings    Json? // { communication, speed, clarity, support } 1–5
  comment    String?       @db.Text
  sentAt     DateTime      @default(now())
  remindedAt DateTime?
  answeredAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([answeredAt])
  @@index([staffId, answeredAt])
}

enum ContractKind {
  WORK // Arbeitsvertrag
  AUSBILDUNG // Ausbildungsvertrag
  SERVICE // Dienstleistungsvertrag (Triad Vision ↔ client)
}

/// Contract template with {{placeholders}} filled from client / case / company data, then sent for e-signature.
model ContractTemplate {
  id          String       @id @default(cuid())
  name        String       @db.VarChar(160)
  kind        ContractKind
  language    String       @default("de") @db.VarChar(5)
  body        String       @db.LongText
  isDefault   Boolean      @default(false)
  active      Boolean      @default(true)
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([kind, active])
}

enum CandidateRequestStatus {
  OPEN
  IN_PROGRESS
  FILLED
  CANCELLED
}

/// Employer's bulk request ("we need 10 truck drivers"); staff match and propose candidates.
model CandidateRequest {
  id             String                 @id @default(cuid())
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title          String                 @db.VarChar(200)
  profession     String                 @db.VarChar(120)
  quantity       Int
  visaCategoryId String?
  germanLevel    String?                @db.VarChar(4)
  drivingLicence String?                @db.VarChar(40)
  minExperience  Int?
  city           String?                @db.VarChar(80)
  startDate      DateTime?
  salaryMin      Int?
  salaryMax      Int?
  notes          String?                @db.Text
  status         CandidateRequestStatus @default(OPEN)
  vacancyId      String? // vacancy created from the request (candidates are proposed through it)
  staffNote      String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([companyId, status])
  @@index([status, createdAt])
}
