enum ArrivalStatus {
  DRAFT // client is filling it in
  SUBMITTED // sent to the team
  CONFIRMED // pickup / housing organised
  COMPLETED // arrived
  CANCELLED
}

enum HousingStatus {
  NONE // not requested
  REQUESTED
  SEARCHING
  OFFERED
  ARRANGED
}

