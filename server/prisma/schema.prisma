  name         String             @db.VarChar(160)
  city         String             @db.VarChar(80)
  type         HousingListingType @default(APARTMENT)
  priceMin     Int? // EUR per month
  priceMax     Int?
  description  String?            @db.Text // shown to clients
  contactName  String?            @db.VarChar(160)
  contactPhone String?            @db.VarChar(60)
  contactEmail String?            @db.VarChar(190)
