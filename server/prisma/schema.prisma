generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Localized text fields are stored as JSON: { "az": "...", "de": "...", "en": "...", "ru": "..." }

enum Role {
  CLIENT
  COMPANY // employer account (belongs to a Company)
  AGENT // regional partner who brings candidates (agent portal only)
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum Locale {
  az
  de
  en
  ru
}

model User {
  id                    String                   @id @default(cuid())
  email                 String                   @unique
  passwordHash          String
  role                  Role                     @default(CLIENT)
  firstName             String
  lastName              String
  phone                 String?
  locale                Locale                   @default(az)
  isActive              Boolean                  @default(true)
  // Candidate profile (all optional, filled in the portal)
  birthDate             DateTime?
  nationality           String?
  city                  String?
  address               String?                  @db.Text
  profession            String?
  experienceYears       Int?
  germanLevel           String? // none | A1 | A2 | B1 | B2 | C1 | C2
  education             String? // school | vocational | university
  drivingLicence        String? // e.g. "B, C, CE"
  about                 String?                  @db.Text
  // Notification preferences (in-app notifications are always kept)
  emailNotifications    Boolean                  @default(true)
  pushNotifications     Boolean                  @default(true)
  passportExpiry        DateTime? // for the passport-expiry reminder
  passportNumber        String? // from passport OCR (MRZ) or typed by the client
  whatsappOptIn         Boolean                  @default(true) // case updates via WhatsApp (needs a phone number)
  smsNotifications      Boolean                  @default(true) // appointment reminders via SMS
  calendarToken         String?                  @unique // secret for the personal ICS feed (staff)
  // Email verification and two-factor authentication
  emailVerifiedAt       DateTime?
  totpSecret            String?                  @db.Text // encrypted with the server key; set while enrolling
  totpEnabledAt         DateTime?
  recoveryCodes         Json? // sha256 hashes of unused one-time recovery codes
  emailOtpEnabledAt     DateTime? // two-step login with a code sent by email (CLIENT / COMPANY only)
  emailOtpCodes         EmailOtpCode[]
  // Employer accounts
  companyId             String?
  company               Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  cases                 Case[]                   @relation("CaseClient")
  assignedCases         Case[]                   @relation("CaseStaff")
  notifications         Notification[]
  events                CaseEvent[]
  messages              CaseMessage[]
  documents             Document[]
  resetTokens           PasswordResetToken[]
  devices               PushDevice[]
  sessions              Session[]
  auditLogs             AuditLog[]
  docFolder             DocFolder?
  docGrants             DocGrant[]               @relation("GrantUser")
  grantsGiven           DocGrant[]               @relation("GrantedBy")
  docFiles              DocFile[]
  verifyTokens          EmailVerificationToken[]
  applications          VacancyApplication[]
  bookings              Booking[]                @relation("BookingUser")
  slots                 ConsultationSlot[]       @relation("SlotStaff")
  reviews               Review[]
  driveNodesCreated     DriveNode[]              @relation("DriveNodeCreatedBy")
  driveNodesOwned       DriveNode[]              @relation("DriveNodeOwner")
  driveNodesDeleted     DriveNode[]              @relation("DriveNodeDeletedBy")
  driveGrants           DriveGrant[]             @relation("DriveGrantUser")
  driveGrantsGiven      DriveGrant[]             @relation("DriveGrantGivenBy")
  driveVersions         DriveFileVersion[]
  driveFavorites        DriveFavorite[]
  tasksCreated          Task[]                   @relation("TaskCreatedBy")
  taskAssignments       TaskAssignee[]
  taskComments          TaskComment[]
  outboundMessages      OutboundMessage[]
  templateEdits         NotificationTemplate[]
  kbArticles            KbArticle[]
  apiKeys               ApiKey[]
  webhooks              Webhook[]
  interviewsAsCandidate Interview[]              @relation("InterviewCandidate")
  interviewsAsStaff     Interview[]              @relation("InterviewStaff")
  interviewsCreated     Interview[]              @relation("InterviewCreatedBy")
  statusText            String?                  @db.VarChar(120) // workspace presence: "In a meeting", …
  statusEmoji           String?                  @db.VarChar(16)
  statusUntil           DateTime?
  mailAccounts          MailAccount[]
  mailLabels            MailLabel[]
  mailRules             MailRule[]
  mailTemplates         MailTemplate[]
  chatChannelsCreated   ChatChannel[]            @relation("ChatChannelCreatedBy")
  chatMemberships       ChatMember[]
  chatMessages          ChatMessage[]
  chatReactions         ChatReaction[]
  calendarEvents        CalendarEvent[]          @relation("CalendarEventOwner")
  calendarAttendance    CalendarAttendee[]
  contactsCreated       Contact[]                @relation("ContactCreatedBy")
  contactLinks          Contact[]                @relation("ContactUser")
  announcements         Announcement[]
  announcementReads     AnnouncementRead[]
  notes                 Note[]
  polls                 Poll[]
  pollVotes             PollVote[]
  leaveRequests         LeaveRequest[]           @relation("LeaveUser")
  leaveDecisions        LeaveRequest[]           @relation("LeaveDecidedBy")
  referredByAgentId     String? // agent whose link / code the client signed up with
  referredByAgent       Agent?                   @relation("AgentReferrals", fields: [referredByAgentId], references: [id], onDelete: SetNull)
  referredAt            DateTime?
  agentProfile          Agent?                   @relation("AgentUser")
  agentCommissions      AgentCommission[]        @relation("CommissionClient")
  translationOrders     TranslationOrder[]       @relation("TranslationClient")
  translationAssigned   TranslationOrder[]       @relation("TranslationStaff")
  translationEvents     TranslationOrderEvent[]
  consents              ConsentRecord[]
  privacyRequests       PrivacyRequest[]         @relation("PrivacyRequester")
  privacyHandled        PrivacyRequest[]         @relation("PrivacyHandler")
  cv                    CandidateCv?
  motivationLetters     MotivationLetter[]
  vaultDocuments        VaultDocument[]
  arrivalPlans          ArrivalPlan[]            @relation("ArrivalClient")
  arrivalPlansHandled   ArrivalPlan[]            @relation("ArrivalStaff")
  surveys               SatisfactionSurvey[]     @relation("SurveyClient")
  surveysAbout          SatisfactionSurvey[]     @relation("SurveyStaff")
  contractTemplates     ContractTemplate[]
  candidateRequests     CandidateRequest[]
  signatureRequests     SignatureRequest[]       @relation("SignatureRequestCreatedBy")
  signatureSignings     SignatureSigner[]        @relation("SignatureSignerUser")

  @@index([companyId])
}

/// Server-side login session. The JWT only carries the session id, so a session can be revoked
/// (logout, password change, admin action) and expires after `expiresAt` or a period of inactivity.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client     String // web | mobile
  ip         String?
  userAgent  String?   @db.Text
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// Security-relevant actions (user management, permissions, document changes, session revocations).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ─── Staff document workspace (/docs/<user>) ───────────────────────────

enum DocAccess {
  VIEW // list and preview in the browser
  DOWNLOAD // VIEW + download/export
  EDIT // DOWNLOAD + upload, replace, rename, move, delete
}

/// One workspace per staff member, stored on disk at <DOCS_DIR>/<slug>/.
model DocFolder {
  id        String     @id @default(cuid())
  ownerId   String     @unique
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slug      String     @unique
  createdAt DateTime   @default(now())
  files     DocFile[]
  dirs      DocDir[]
  grants    DocGrant[]
}

/// A sub-directory inside a workspace (kept so empty directories survive). `path` is relative, "/"-separated.
model DocDir {
  id        String    @id @default(cuid())
  folderId  String
  folder    DocFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  path      String
  createdAt DateTime  @default(now())

  @@unique([folderId, path])
}

model DocFile {
  id           String    @id @default(cuid())
  folderId     String
  folder       DocFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  path         String // directory inside the workspace, "" for the root
  name         String // file name on disk
  mimeType     String
  size         Int
  version      Int       @default(1)
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([folderId, path, name])
  @@index([folderId, path])
}

/// What another staff member may do inside a workspace. Granted by the super admin.
model DocGrant {
  id          String    @id @default(cuid())
  folderId    String
  folder      DocFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("GrantUser", fields: [userId], references: [id], onDelete: Cascade)
  access      DocAccess
  grantedById String?
  grantedBy   User?     @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([folderId, userId])
  @@index([userId])
}

/// Expo push token of a phone where the user is logged in to the mobile app.
model PushDevice {
  id         String   @id @default(cuid())
  token      String   @unique
  platform   String // ios | android
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─── Visa case workflow ────────────────────────────────────────────────

/// Kind of application the client starts (chosen instead of typing a profession).
enum VisaType {
  WORK // skilled work / employment visa (§18a, §18b, §19c …)
  AUSBILDUNG // vocational training (§16a)
  WEITERBILDUNG // further training / qualification measure for recognition (§16d)
  JOB_SEEKER // Chancenkarte / job seeker visa
  STUDY // university studies (§16b)
  FAMILY // family reunion
  TOURIST // Schengen visitor visa
}

enum CaseStatus {
  DOCUMENTS_PENDING // client uploads initial documents
  DOCUMENTS_REVIEW // client submitted, staff reviewing
  CONTRACT_SENT // staff sent contract, waiting for client signature
  CONTRACT_SIGNED // client signed, staff verifying
  EMBASSY_DOCUMENTS // client uploads embassy documents
  EMBASSY_REVIEW // client submitted embassy docs, staff reviewing
  APPOINTMENT_SCHEDULED // embassy appointment date set
  DECISION_PENDING // application lodged at the embassy, awaiting decision
  APPROVED
  REJECTED
  CANCELLED
}

enum DocStage {
  INITIAL
  EMBASSY
  CONTRACT
  CONTRACT_SIGNED
  VISA
  OTHER
}

enum DocStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Case {
  id                String                @id @default(cuid())
  number            String                @unique
  clientId          String
  client            User                  @relation("CaseClient", fields: [clientId], references: [id], onDelete: Cascade)
  assignedStaffId   String?
  assignedStaff     User?                 @relation("CaseStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  visaCategoryId    String?
  visaCategory      VisaCategory?         @relation(fields: [visaCategoryId], references: [id], onDelete: SetNull)
  profession        String
  visaType          VisaType              @default(WORK) // what the client applies for: drives step names and expected durations
  status            CaseStatus            @default(DOCUMENTS_PENDING)
  staffNote         String?               @db.Text // latest note visible to client (e.g. what to fix)
  appointmentAt     DateTime?
  appointmentPlace  String?               @db.Text
  decisionAt        DateTime?
  decisionReason    String?               @db.Text // rejection reason or approval remark
  visaValidFrom     DateTime?
  visaValidTo       DateTime?
  cancelReason      String?               @db.Text
  companyId         String? // employer this candidate is placed with (company portal visibility)
  company           Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vacancyId         String?
  vacancy           Vacancy?              @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  // Family reunion (Familiennachzug): member cases hang under the main applicant's case.
  parentCaseId      String?
  parentCase        Case?                 @relation("CaseFamily", fields: [parentCaseId], references: [id], onDelete: SetNull)
  familyMembers     Case[]                @relation("CaseFamily")
  relation          String? // spouse | child | parent (for member cases)
  closedAt          DateTime? // set when the case reaches APPROVED / REJECTED / CANCELLED
  documentsPurgedAt DateTime? // DSGVO retention: files deleted after the retention period
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  requirements      DocumentRequirement[]
  documents         Document[]
  contract          Contract?
  events            CaseEvent[]
  messages          CaseMessage[]
  notifications     Notification[]
  tasks             Task[]
  outboundMessages  OutboundMessage[]
  onboarding        CaseOnboarding[]
  mailMessages      MailMessage[]
  chatChannels      ChatChannel[]
  calendarEvents    CalendarEvent[]
  agentCommissions  AgentCommission[]
  translationOrders TranslationOrder[]
  arrivalPlan       ArrivalPlan?
  motivationLetters MotivationLetter[]
  surveys           SatisfactionSurvey[]
  signatureRequests SignatureRequest[]

  @@index([clientId])
  @@index([status])
  @@index([companyId])
  @@index([closedAt])
  @@index([parentCaseId])
}

model DocumentRequirement {
  id          String     @id @default(cuid())
  key         String? // stable id from the template (e.g. PASSPORT, LANGUAGE_CERT) for automations
  caseId      String
  case        Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage       DocStage
  title       Json
  description Json?
  required    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  documents   Document[]

  @@index([caseId, stage])
}

model Document {
  id              String               @id @default(cuid())
  caseId          String
  case            Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requirementId   String?
  requirement     DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  stage           DocStage
  originalName    String
  storedName      String               @unique
  mimeType        String
  size            Int
  status          DocStatus            @default(PENDING)
  reviewNote      String?              @db.Text
  ocr             Json? // fields extracted from the file (passport MRZ: number, names, birthDate, expiry…)
  ocrAt           DateTime?
  checks          Json? // automatic quality checks right after upload (blur, darkness, cut-off, type, expiry)
  checkedAt       DateTime?
  vaultDocumentId String? // copied from the client's document vault
  uploadedById    String
  uploadedBy      User                 @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime             @default(now())

  @@index([caseId, stage])
}

model Contract {
  id                 String    @id @default(cuid())
  caseId             String    @unique
  case               Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileDocumentId     String // unsigned contract (Document with stage CONTRACT)
  signedDocumentId   String? // signed PDF produced by the server (Document with stage CONTRACT_SIGNED)
  signerName         String?
  signedAt           DateTime?
  signerIp           String?
  signerUserAgent    String?   @db.Text
  sentAt             DateTime  @default(now())
  version            Int       @default(1)
  signatureRequestId String? // set when this version is signed through the multi-party module (SignatureRequest.id)
}

model CaseEvent {
  id              String      @id @default(cuid())
  caseId          String
  case            Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type            String // e.g. STATUS_CHANGED, DOCUMENT_UPLOADED, DOCUMENT_REVIEWED, CONTRACT_SIGNED
  fromStatus      CaseStatus?
  toStatus        CaseStatus?
  note            String?     @db.Text
  actorId         String?
  actor           User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  visibleToClient Boolean     @default(true)
  createdAt       DateTime    @default(now())

  @@index([caseId, createdAt])
  @@index([createdAt])
}

model CaseMessage {
  id         String    @id @default(cuid())
  caseId     String
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String    @db.Text
  channel    String    @default("app") // app | whatsapp | sms
  externalId String?   @unique // provider message id (WhatsApp), for de-duplication
  readAt     DateTime? // when the other side opened it (read receipt)
  createdAt  DateTime  @default(now())

  @@index([caseId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String?
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @db.Text
  link      String?   @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String   @db.Text
  status    String // SENT | FAILED | CONSOLE
  error     String?  @db.Text
  createdAt DateTime @default(now())
}

// ─── Website content (CMS) ─────────────────────────────────────────────

model VisaCategory {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  icon                 String // lucide icon name
  image                String                @db.Text
  visaLabel            String // e.g. "§18b", "§16d", "Saisonarbeit"
  title                Json
  summary              Json
  items                Json // { az: string[], de: string[], ... }
  body                 Json // long description per locale
  // Structured details for the visa page (all optional; figures are indicative and editable in the CMS)
  germanLevel          String? // e.g. "A2", "B1"
  salaryMin            Int? // EUR gross per month
  salaryMax            Int?
  processingMin        Int? // weeks
  processingMax        Int?
  familyReunion        Boolean?
  requirements         Json? // L10nList
  documents            Json? // L10nList
  faq                  Json? // { q: L10n, a: L10n }[]
  forecast             Json? // optional per-step expected days { DOCUMENTS: [min,max], CONTRACT: …, EMBASSY: …, APPOINTMENT: …, DECISION: … }
  sortOrder            Int                   @default(0)
  published            Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  cases                Case[]
  vacancies            Vacancy[]
  requirementTemplates RequirementTemplate[]
}

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  icon      String // lucide icon name
  image     String   @db.Text
  audience  String   @default("all") // all | company | candidate
  title     Json
  summary   Json
  body      Json // long description per locale, paragraphs separated by blank lines
  features  Json // { az: string[], ... } what is included
  steps     Json? // L10nList: service-specific "how it works" steps
  duration  Json? // L10n, e.g. "2–4 weeks"
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id          String  @id @default(cuid())
  name        String
  logo        String? @db.Text // URL; if empty the name is rendered as a wordmark
  website     String? @db.Text
  sector      String? // logistics | courier | industry | construction | hospitality | healthcare | agriculture | other
  city        String? // German location shown on the partners map
  description Json? // L10n
  featured    Boolean @default(false)
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model VisaSample {
  id         String  @id @default(cuid())
  image      String  @db.Text
  profession Json
  visaLabel  String
  dateLabel  Json
  sortOrder  Int     @default(0)
  published  Boolean @default(true)
}

model Testimonial {
  id        String  @id @default(cuid())
  quote     Json
  author    Json
  role      Json
  kind      String  @default("company") // company | candidate
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model Stat {
  id        String @id @default(cuid())
  icon      String
  value     Int
  prefix    String @default("")
  suffix    String @default("")
  label     Json
  sortOrder Int    @default(0)
}

model Faq {
  id        String  @id @default(cuid())
  question  Json
  answer    Json
  audience  String  @default("all") // all | company | candidate
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  cover       String   @db.Text
  title       Json
  excerpt     Json
  body        Json
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
  ARCHIVED
}

model Inquiry {
  id            String        @id @default(cuid())
  kind          String // company | contact
  companyName   String?
  contactName   String
  email         String
  phone         String?
  sector        String?
  workersNeeded Int?
  message       String        @db.Text
  locale        String
  status        InquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())

  @@index([status, createdAt])
}

model Setting {
  key   String @id
  value Json
}

// ─── Email verification ──────────────────────────────────────────────

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// One-time 6-digit codes sent by email: second login factor (LOGIN, tied to one login challenge)
/// or confirmation when turning email two-step login on (ENABLE). Only a peppered sha256 is stored.
model EmailOtpCode {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     String // LOGIN | ENABLE
  challengeId String? // jti of the login challenge the code belongs to (LOGIN only)
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, purpose])
}

// ─── Employers, vacancies, applications ──────────────────────────────

enum CompanyStatus {
  PENDING // registered, waiting for staff approval
  ACTIVE
  SUSPENDED
}

model Company {
  id                String             @id @default(cuid())
  name              String
  legalForm         String?
  sector            String? // logistics | courier | industry | construction | hospitality | healthcare | agriculture | other
  city              String?
  address           String?            @db.Text
  vatId             String?
  website           String?            @db.Text
  contactName       String?
  phone             String?
  email             String?
  status            CompanyStatus      @default(PENDING)
  note              String?            @db.Text // internal staff note
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]
  vacancies         Vacancy[]
  cases             Case[]
  invoices          Invoice[]
  interviews        Interview[]
  apiKeys           ApiKey[]
  webhooks          Webhook[]
  contacts          Contact[]
  signatureRequests SignatureRequest[]
  candidateRequests CandidateRequest[]

  @@index([status])
}

enum VacancyStatus {
  DRAFT
  PENDING // submitted by a company, waiting for staff review
  OPEN
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  SEASONAL
  AUSBILDUNG
}

model Vacancy {
  id             String               @id @default(cuid())
  slug           String               @unique
  companyId      String?
  company        Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  visaCategoryId String?
  visaCategory   VisaCategory?        @relation(fields: [visaCategoryId], references: [id], onDelete: SetNull)
  title          Json // L10n
  description    Json // L10n
  requirements   Json? // L10nList
  benefits       Json? // L10nList
  sector         String?
  city           String?
  profession     String? // normalised profession used for matching
  germanLevel    String? // minimum: none | A1 | A2 | B1 | B2 | C1 | C2
  minExperience  Int?
  drivingLicence String? // e.g. "CE"
  salaryMin      Int? // EUR gross per month
  salaryMax      Int?
  positions      Int                  @default(1)
  employmentType EmploymentType       @default(FULL_TIME)
  showCompany    Boolean              @default(false) // publish the employer's name on the public board
  status         VacancyStatus        @default(DRAFT)
  publishedAt    DateTime?
  closesAt       DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  applications   VacancyApplication[]
  cases          Case[]

  @@index([status, publishedAt])
  @@index([companyId])
}

enum ApplicationStatus {
  NEW
  SHORTLISTED
  PROPOSED // shown to the employer
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model VacancyApplication {
  id          String            @id @default(cuid())
  vacancyId   String
  vacancy     Vacancy           @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(NEW)
  matchScore  Int? // 0–100 at the time of applying / last recompute
  message     String?           @db.Text // candidate's note
  staffNote   String?           @db.Text // internal
  companyNote String?           @db.Text // employer feedback
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  interviews  Interview[]

  @@unique([vacancyId, userId])
  @@index([userId])
  @@index([status])
}

// ─── Consultation booking ────────────────────────────────────────────

model ConsultationSlot {
  id        String   @id @default(cuid())
  staffId   String
  staff     User     @relation("SlotStaff", fields: [staffId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  booking   Booking?

  @@unique([staffId, startsAt])
  @@index([startsAt])
}

enum BookingStatus {
  BOOKED
  CANCELLED
  DONE
  NO_SHOW
}

model Booking {
  id          String           @id @default(cuid())
  slotId      String           @unique
  slot        ConsultationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?            @relation("BookingUser", fields: [userId], references: [id], onDelete: SetNull)
  name        String
  email       String
  phone       String?
  topic       String? // candidate | company | other
  message     String?          @db.Text
  locale      String           @default("az")
  meetingUrl  String           @db.Text
  manageToken String           @unique // sha256 of the cancel link token
  status      BookingStatus    @default(BOOKED)
  createdAt   DateTime         @default(now())

  @@index([email])
}

// ─── Invoices ─────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique // e.g. TV-RE-2026-0001
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  issueDate  DateTime
  dueDate    DateTime
  currency   String        @default("EUR")
  items      Json // { description, quantity, unitPriceCents }[]
  netCents   Int
  vatRate    Int           @default(19) // percent
  vatCents   Int
  grossCents Int
  status     InvoiceStatus @default(DRAFT)
  sentAt     DateTime?
  paidAt     DateTime?
  note       String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([companyId])
  @@index([status, dueDate])
}

// ─── Reviews (collected after a visa approval) ───────────────────────

enum ReviewStatus {
  REQUESTED // invitation sent, not answered yet
  PENDING // submitted, waiting for moderation
  APPROVED
  REJECTED
}

model Review {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId         String       @unique
  tokenHash      String       @unique // link in the invitation email
  rating         Int? // 1–5
  text           String?      @db.Text
  displayName    String? // e.g. "Ali M., truck driver"
  consentPublish Boolean      @default(false)
  locale         String       @default("az")
  status         ReviewStatus @default(REQUESTED)
  createdAt      DateTime     @default(now())
  submittedAt    DateTime?

  @@index([status])
}

// ─── Scheduled jobs and privacy-friendly analytics ───────────────────

/// One row per reminder actually sent, so a job never sends the same reminder twice.
model ReminderLog {
  id     String   @id @default(cuid())
  key    String   @unique // e.g. "appointment-24h:<caseId>:<appointmentAt ISO>"
  sentAt DateTime @default(now())
}

/// Aggregated daily counters (no cookies, no IPs, no user ids) for the conversion funnel.
model AnalyticsDaily {
  id     String   @id @default(cuid())
  day    DateTime @db.Date
  metric String // visit | register | email_verified | case_created | approved | inquiry | booking | vacancy_apply
  source String   @default("") // utm_source / referrer host, lower-cased, max 60 chars
  count  Int      @default(0)

  @@unique([day, metric, source])
  @@index([metric, day])
}

// ─── Team workspace: drive (folders/files with inherited permissions) ───

enum DriveSpace {
  SHARED // the company drive everyone in the team works in
  PERSONAL // one root per staff member ("My files")
  CASES // system root; per-case sub-folders are virtual (built from Case/Document)
}

enum DriveNodeKind {
  FOLDER
  FILE
}

/// Ordered from least to most. Each level includes everything below it.
enum DriveAccess {
  VIEW // see the folder and preview files in the browser
  DOWNLOAD // VIEW + download single files
  EXPORT // DOWNLOAD + download whole folders as ZIP
  EDIT // EXPORT + upload, create folders, rename, move, delete (to trash), new versions
  MANAGE // EDIT + change who has access to this folder
}

/// One folder or file. Files are stored on disk under <DOCS_DIR>/drive/<storageKey> (renames and moves
/// never touch the disk). Sibling names are unique among non-deleted nodes (enforced in code).
model DriveNode {
  id                 String             @id @default(cuid())
  space              DriveSpace
  kind               DriveNodeKind
  parentId           String?
  parent             DriveNode?         @relation("DriveTree", fields: [parentId], references: [id], onDelete: Cascade)
  children           DriveNode[]        @relation("DriveTree")
  name               String             @db.VarChar(255)
  /// PERSONAL space: the staff member whose "My files" this is (set on every node of that tree).
  ownerId            String?
  owner              User?              @relation("DriveNodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// false = permissions are NOT inherited from the parent (only grants from this node down apply).
  inheritPermissions Boolean            @default(true)
  /// System nodes (space roots) cannot be renamed, moved or deleted.
  system             Boolean            @default(false)
  color              String?            @db.VarChar(20) // folder colour in the explorer
  // File fields (kind = FILE)
  storageKey         String?            @unique
  mimeType           String?
  size               Int?
  version            Int                @default(1)
  createdById        String?
  createdBy          User?              @relation("DriveNodeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  /// Recycle bin: set when deleted; purged for good after the trash period.
  deletedAt          DateTime?
  deletedById        String?
  deletedBy          User?              @relation("DriveNodeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  grants             DriveGrant[]
  versions           DriveFileVersion[]
  favorites          DriveFavorite[]
  taskLinks          TaskAttachment[]

  @@index([parentId, deletedAt])
  @@index([space, ownerId])
  @@index([deletedAt])
  @@index([name])
}

/// Access to a node (and, by inheritance, everything below it) for one user OR every user of a role.
model DriveGrant {
  id          String      @id @default(cuid())
  nodeId      String
  node        DriveNode   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?       @relation("DriveGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  role        Role? // e.g. STAFF = everyone on the team with that role (and above)
  access      DriveAccess
  grantedById String?
  grantedBy   User?       @relation("DriveGrantGivenBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([nodeId, userId])
  @@unique([nodeId, role])
  @@index([userId])
}

/// Previous versions of a file (the current one lives on the node itself).
model DriveFileVersion {
  id           String    @id @default(cuid())
  nodeId       String
  node         DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  version      Int
  storageKey   String    @unique
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@unique([nodeId, version])
}

model DriveFavorite {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId    String
  node      DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([userId, nodeId])
}

// ─── Team workspace: tasks ─────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id          String              @id @default(cuid())
  number      Int                 @unique // shown as T-0001; assigned as max+1 in code
  title       String              @db.VarChar(200)
  description String?             @db.Text
  status      TaskStatus          @default(TODO)
  priority    TaskPriority        @default(NORMAL)
  startAt     DateTime?
  dueAt       DateTime? // deadline: by when it must be solved
  completedAt DateTime?
  sortOrder   Int                 @default(0) // order inside a board column
  caseId      String? // optional link to a visa case
  case        Case?               @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?               @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignees   TaskAssignee[]
  comments    TaskComment[]
  checklist   TaskChecklistItem[]
  attachments TaskAttachment[]

  @@index([status, dueAt])
  @@index([caseId])
}

model TaskAssignee {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String   @db.Text
  /// System entries ("status changed to Done") render as activity, not as a comment bubble.
  system    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model TaskChecklistItem {
  id        String  @id @default(cuid())
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String  @db.VarChar(300)
  done      Boolean @default(false)
  sortOrder Int     @default(0)
}

/// A drive file or folder linked to a task.
model TaskAttachment {
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  nodeId    String
  node      DriveNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([taskId, nodeId])
}

// ─── Messaging: WhatsApp / SMS, templates ───────────────────────────────

enum OutboundChannel {
  WHATSAPP
  SMS
}

enum OutboundStatus {
  QUEUED
  SENT
  FAILED
  CONSOLE
}

/// Every WhatsApp/SMS message the system tried to send (like EmailLog, with provider ids and errors).
model OutboundMessage {
  id          String          @id @default(cuid())
  channel     OutboundChannel
  to          String
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  caseId      String?
  case        Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  templateKey String?
  body        String          @db.Text
  status      OutboundStatus  @default(QUEUED)
  providerId  String?
  error       String?         @db.Text
  createdAt   DateTime        @default(now())
  sentAt      DateTime?

  @@index([userId, createdAt])
  @@index([caseId])
  @@index([status, createdAt])
}

/// Admin-edited override of a notification text (title/body per type and locale). Missing rows fall back to code.
model NotificationTemplate {
  id          String   @id @default(cuid())
  type        String
  locale      Locale
  title       String
  body        String   @db.Text
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@unique([type, locale])
}

// ─── Document requirement templates per visa type ──────────────────────

model RequirementTemplate {
  id             String        @id @default(cuid())
  visaCategoryId String? // null = default set used when the visa type has no own list
  visaCategory   VisaCategory? @relation(fields: [visaCategoryId], references: [id], onDelete: Cascade)
  stage          DocStage
  key            String? // PASSPORT, PHOTO, CV, DIPLOMA, LANGUAGE_CERT, …
  title          Json
  description    Json?
  required       Boolean       @default(true)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())

  @@index([visaCategoryId, stage])
}

// ─── Post-arrival onboarding, German preparation ───────────────────────

model OnboardingItem {
  id        String           @id @default(cuid())
  slug      String           @unique
  icon      String           @default("CheckCircle2")
  title     Json
  body      Json // L10n, paragraphs separated by blank lines
  link      String?          @db.Text
  dueDays   Int? // days after arrival by which it should be done (e.g. Anmeldung: 14)
  sortOrder Int              @default(0)
  published Boolean          @default(true)
  progress  CaseOnboarding[]
}

model CaseOnboarding {
  id     String         @id @default(cuid())
  caseId String
  case   Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  itemId String
  item   OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  doneAt DateTime?
  note   String?        @db.Text

  @@unique([caseId, itemId])
}

model GermanQuestion {
  id        String  @id @default(cuid())
  level     String // A1 | A2 | B1 | B2
  question  Json // L10n prompt (the sentence itself is German)
  options   Json // string[]
  answer    Int
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model LanguageCourse {
  id          String  @id @default(cuid())
  name        String
  provider    String?
  city        String?
  url         String? @db.Text
  levels      String? // e.g. "A1–B1"
  format      String? // online | offline | hybrid
  description Json? // L10n
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

// ─── Interviews (employer ↔ candidate) ─────────────────────────────────

enum InterviewStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
  DONE
  NO_SHOW
}

model Interview {
  id            String              @id @default(cuid())
  applicationId String?
  application   VacancyApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  candidateId   String
  candidate     User                @relation("InterviewCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  staffId       String?
  staff         User?               @relation("InterviewStaff", fields: [staffId], references: [id], onDelete: SetNull)
  startsAt      DateTime
  endsAt        DateTime
  meetingUrl    String?             @db.Text
  status        InterviewStatus     @default(PROPOSED)
  notes         String?             @db.Text
  createdById   String?
  createdBy     User?               @relation("InterviewCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([candidateId, startsAt])
  @@index([companyId, startsAt])
  @@index([startsAt])
}

// ─── Internal knowledge base ───────────────────────────────────────────

model KbCategory {
  id        String      @id @default(cuid())
  name      String
  sortOrder Int         @default(0)
  articles  KbArticle[]
}

model KbArticle {
  id          String      @id @default(cuid())
  categoryId  String?
  category    KbCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title       String
  body        String      @db.Text // markdown
  tags        Json? // string[]
  pinned      Boolean     @default(false)
  published   Boolean     @default(true)
  updatedById String?
  updatedBy   User?       @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@fulltext([title, body])
}

// ─── Partner API keys and webhooks ─────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String // first 8 chars, shown in the UI
  keyHash     String    @unique // sha256 of the full key
  scopes      Json // string[] e.g. ["vacancies:read","applications:read","candidates:read"]
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Webhook {
  id          String            @id @default(cuid())
  url         String            @db.Text
  secret      String // HMAC-SHA256 signing secret
  events      Json // string[] e.g. ["case.status_changed","application.created"]
  companyId   String?
  company     Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  active      Boolean           @default(true)
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  deliveries  WebhookDelivery[]
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model WebhookDelivery {
  id            String         @id @default(cuid())
  webhookId     String
  webhook       Webhook        @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  responseCode  Int?
  lastError     String?        @db.Text
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime       @default(now())

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
}

// ─── Team workspace: mail ───────────────────────────────────────────────

enum MailProvider {
  GMAIL
  OUTLOOK
  YANDEX
  MAILRU
  CUSTOM
}

enum MailSyncStatus {
  IDLE
  SYNCING
  OK
  ERROR
}

/// A staff member's own mailbox (IMAP + SMTP); the password is sealed with the server key.
model MailAccount {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String         @db.VarChar(190)
  displayName   String?        @db.VarChar(120)
  provider      MailProvider   @default(CUSTOM)
  imapHost      String         @db.VarChar(190)
  imapPort      Int            @default(993)
  imapSecure    Boolean        @default(true)
  smtpHost      String         @db.VarChar(190)
  smtpPort      Int            @default(465)
  smtpSecure    Boolean        @default(true)
  username      String         @db.VarChar(190)
  passwordEnc   String         @db.Text
  signatureHtml String?        @db.Text
  isDefault     Boolean        @default(false)
  syncEnabled   Boolean        @default(true)
  syncStatus    MailSyncStatus @default(IDLE)
  syncError     String?        @db.VarChar(500)
  lastSyncAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  folders       MailFolder[]
  messages      MailMessage[]
  rules         MailRule[]

  @@unique([userId, email])
}

enum MailFolderRole {
  INBOX
  SENT
  DRAFTS
  TRASH
  JUNK
  ARCHIVE
  OTHER
}

model MailFolder {
  id          String         @id @default(cuid())
  accountId   String
  account     MailAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  path        String         @db.VarChar(255) // IMAP mailbox path
  name        String         @db.VarChar(120)
  role        MailFolderRole @default(OTHER)
  delimiter   String?        @db.VarChar(4)
  uidValidity BigInt?
  lastUid     BigInt         @default(0) // highest UID synced so far
  total       Int            @default(0)
  unread      Int            @default(0)
  subscribed  Boolean        @default(true)
  sortOrder   Int            @default(0)
  messages    MailMessage[]

  @@unique([accountId, path])
}

model MailMessage {
  id             String             @id @default(cuid())
  accountId      String
  account        MailAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folderId       String
  folder         MailFolder         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uid            BigInt? // IMAP UID inside the folder; null for local drafts
  messageId      String?            @db.VarChar(500)
  inReplyTo      String?            @db.VarChar(500)
  refs           String?            @db.Text // References header
  threadKey      String?            @db.VarChar(190) // root Message-ID of the conversation
  subject        String?            @db.VarChar(1000)
  fromName       String?            @db.VarChar(255)
  fromAddr       String?            @db.VarChar(255)
  toList         Json // [{ name, address }]
  ccList         Json?
  bccList        Json?
  replyTo        String?            @db.VarChar(255)
  date           DateTime
  snippet        String?            @db.VarChar(300)
  text           String?            @db.LongText
  html           String?            @db.LongText // sanitised before storing
  hasAttachments Boolean            @default(false)
  size           Int?
  seen           Boolean            @default(false)
  flagged        Boolean            @default(false)
  answered       Boolean            @default(false)
  isDraft        Boolean            @default(false)
  snoozedUntil   DateTime?
  caseId         String? // linked visa case
  case           Case?              @relation(fields: [caseId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  attachments    MailAttachment[]
  labels         MailMessageLabel[]

  @@unique([folderId, uid])
  @@index([accountId, date])
  @@index([accountId, threadKey])
  @@index([accountId, seen])
  @@index([messageId])
  @@index([snoozedUntil])
  @@fulltext([subject, text])
}

model MailAttachment {
  id         String      @id @default(cuid())
  messageId  String
  message    MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename   String      @db.VarChar(255)
  mimeType   String      @db.VarChar(120)
  size       Int
  contentId  String?     @db.VarChar(255) // inline images (cid:)
  inline     Boolean     @default(false)
  partId     String?     @db.VarChar(40) // IMAP body part, for lazy download
  storageKey String?     @unique // <DOCS_DIR>/mail/<key> once fetched

  @@index([messageId])
}

model MailLabel {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String             @db.VarChar(60)
  color     String             @db.VarChar(20)
  sortOrder Int                @default(0)
  messages  MailMessageLabel[]

  @@unique([userId, name])
}

model MailMessageLabel {
  messageId String
  message   MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  labelId   String
  label     MailLabel   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([messageId, labelId])
}

/// Inbox rule: when an incoming message matches `conditions`, apply `actions` (label, mark read, move, flag, link to case).
model MailRule {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String?
  account    MailAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String       @db.VarChar(80)
  enabled    Boolean      @default(true)
  conditions Json
  actions    Json
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

