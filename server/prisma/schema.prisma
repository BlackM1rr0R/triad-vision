  @@index([score])
  @@index([visitorId])
}

model Setting {
  key   String @id
  value Json
}

// ─── Email verification ──────────────────────────────────────────────

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// One-time 6-digit codes sent by email: second login factor (LOGIN, tied to one login challenge)
/// or confirmation when turning email two-step login on (ENABLE). Only a peppered sha256 is stored.
model EmailOtpCode {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     String // LOGIN | ENABLE
  challengeId String? // jti of the login challenge the code belongs to (LOGIN only)
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, purpose])
}

// ─── Employers, vacancies, applications ──────────────────────────────

enum CompanyStatus {
  PENDING // registered, waiting for staff approval
  ACTIVE
  SUSPENDED
}

model Company {
  id                    String                       @id @default(cuid())
  name                  String
  legalForm             String?
  sector                String? // logistics | courier | industry | construction | hospitality | healthcare | agriculture | other
  city                  String?
  address               String?                      @db.Text
  vatId                 String?
  website               String?                      @db.Text
  contactName           String?
  phone                 String?
  email                 String?
  status                CompanyStatus                @default(PENDING)
  note                  String?                      @db.Text // internal staff note
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  users                 User[]
  vacancies             Vacancy[]
  cases                 Case[]
  invoices              Invoice[]
  interviews            Interview[]
  interviewAvailability InterviewAvailability[]
  interviewScheduling   InterviewSchedulingSettings?
  interviewInvites      InterviewInvite[]
  apiKeys               ApiKey[]
  webhooks              Webhook[]
  contacts              Contact[]
  signatureRequests     SignatureRequest[]
  candidateRequests     CandidateRequest[]
  quotes                Quote[]
  partyThreads          PartyThread[]
  partnerHousing        PartnerHousing[] // partner landlord listings linked to this employer (lib/housing)
  /// Agent (or client) referral the employer signed up with (same codes as the client sign-up).
  referredByAgentId     String?                      @db.VarChar(40)
  referralCode          String?                      @db.VarChar(40)
  referredAt            DateTime?

  @@index([status])
}

enum VacancyStatus {
  DRAFT
  PENDING // submitted by a company, waiting for staff review
  OPEN
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  SEASONAL
  AUSBILDUNG
}

model Vacancy {
  id             String                @id @default(cuid())
  slug           String                @unique
  companyId      String?
  company        Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  visaCategoryId String?
  visaCategory   VisaCategory?         @relation(fields: [visaCategoryId], references: [id], onDelete: SetNull)
  title          Json // L10n
  description    Json // L10n
  requirements   Json? // L10nList
  benefits       Json? // L10nList
  sector         String?
  city           String?
  profession     String? // normalised profession used for matching
  germanLevel    String? // minimum: none | A1 | A2 | B1 | B2 | C1 | C2
  minExperience  Int?
  drivingLicence String? // e.g. "CE"
  salaryMin      Int? // EUR gross per month
  salaryMax      Int?
  positions      Int                   @default(1)
  employmentType EmploymentType        @default(FULL_TIME)
  showCompany    Boolean               @default(false) // publish the employer's name on the public board
  status         VacancyStatus         @default(DRAFT)
  publishedAt    DateTime?
  closesAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  applications   VacancyApplication[]
  cases          Case[]
  distribution   VacancyDistribution? // external job boards (lib/jobFeeds)
  channelStates  VacancyChannelState[]
  /// Cover image and gallery: [{ url, alt? }] (public uploads); the first one is the card/OG image.
  images         Json?

  @@index([status, publishedAt])
  @@index([companyId])
}

enum ApplicationStatus {
  NEW
  SHORTLISTED
  PROPOSED // shown to the employer
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model VacancyApplication {
  id               String                 @id @default(cuid())
  vacancyId        String
  vacancy          Vacancy                @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           ApplicationStatus      @default(NEW)
  matchScore       Int? // 0–100 at the time of applying / last recompute
  message          String?                @db.Text // candidate's note
  staffNote        String?                @db.Text // internal
  companyNote      String?                @db.Text // employer feedback
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  interviews       Interview[]
  interviewInvites InterviewInvite[]
  profileDraft     CandidateProfileDraft?
  partyThread      PartyThread?           @relation("PartyThreadApplication")

  @@unique([vacancyId, userId])
  @@index([userId])
  @@index([status])
}

// ─── Job feeds: vacancies on external job boards (lib/jobFeeds) ──────

enum JobChannelStatus {
  PENDING // switched on, not exported yet
  PUBLISHED // in the last feed build / BA file
  ERROR // left out: required fields missing (error says which)
  EXPIRED // was published, the vacancy is closed or past closesAt
}

/// Per-vacancy distribution settings: which boards, which language, how the employer is shown.
model VacancyDistribution {
  vacancyId      String    @id
  vacancy        Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  /// Channel keys: indeed | stepstone | generic | ba
  channels       Json
  language       String    @default("de") @db.VarChar(5)
  hideEmployer   Boolean   @default(true)
  /// Shown instead of the employer when hidden (default "<brand> (für einen Kunden)").
  employerLabel  String?   @db.VarChar(160)
  /// External apply URL override; default the public /de/jobs/<slug> page. UTM parameters are added per channel.
  applyUrl       String?   @db.VarChar(500)
  /// KldB 2010 occupation code (5 digits, Statistik der BA).
  occupationCode String?   @db.VarChar(10)
  /// BA Jobbörse TitleCode (Berufe-ID / DKZ from the HR-BA-XML catalogue).
  baTitleCode    String?   @db.VarChar(12)
  postalCode     String?   @db.VarChar(10)
  weeklyHours    Int?
  /// Befristung: fixed-term contract (until limitedUntil when known).
  limited        Boolean   @default(false)
  limitedUntil   DateTime?
  startDate      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Export status of one vacancy on one channel.
model VacancyChannelState {
  id           String           @id @default(cuid())
  vacancyId    String
  vacancy      Vacancy          @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  channel      String           @db.VarChar(20)
  status       JobChannelStatus @default(PENDING)
  lastExportAt DateTime?
  error        String?          @db.Text
  updatedAt    DateTime         @updatedAt

  @@unique([vacancyId, channel])
  @@index([channel, status])
}

/// Singleton (id "default"): feed token, BA partner credentials (sealed with lib/secretBox), last fetches.
model JobFeedConfig {
  id              String    @id @default("default")
  tokenSealed     String    @db.Text
  tokenRotatedAt  DateTime  @default(now())
  baSupplierId    String?   @db.VarChar(40)
  baPartnerId     String?   @db.VarChar(40)
  baCertSealed    String?   @db.MediumText
  baPassSealed    String?   @db.Text
  baUploadUrl     String?   @db.VarChar(500)
  baUploadEnabled Boolean   @default(false)
  baLastUploadAt  DateTime?
  baLastError     String?   @db.Text
  /// { [channel]: { at: ISO, items: number } } — last feed build per channel
  feedStats       Json?
  updatedAt       DateTime  @updatedAt
}

// ─── Consultation booking ────────────────────────────────────────────

model ConsultationSlot {
  id        String   @id @default(cuid())
  staffId   String
  staff     User     @relation("SlotStaff", fields: [staffId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  booking   Booking?
  /// ONLINE consultation (Jitsi) or OFFICE visit (address from Setting 'contact' offices).
  kind      SlotKind @default(ONLINE)
  /// Office visits: the office address shown to the client.
  location  String?  @db.Text
  /// Office visits: seat number at the same time (capacity = seats sharing staffId + startsAt).
  seat      Int      @default(0)

  @@unique([staffId, startsAt, seat])
  @@index([startsAt])
  @@index([kind, startsAt])
}

enum BookingStatus {
  BOOKED
  CANCELLED
  DONE
  NO_SHOW
}

model Booking {
  id          String           @id @default(cuid())
  slotId      String           @unique
  slot        ConsultationSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
