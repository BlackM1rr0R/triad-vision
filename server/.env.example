DATABASE_URL="mysql://triad:triad_dev_password@localhost:3308/triad_vision"
PORT=4000
CLIENT_URL="http://localhost:5173"
JWT_SECRET="change-me-to-a-long-random-string"

# Where staff notifications (new applications, inquiries, client actions) are sent
ADMIN_NOTIFY_EMAIL="abdllyevv@gmail.com"

# SMTP. For Gmail: host smtp.gmail.com, port 465, secure true, and an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Leave SMTP_HOST empty in development: emails are then printed to the console instead of sent.
SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Triad Vision <no-reply@triad-vision.de>"

# Initial admin account created by the seed script
SEED_ADMIN_EMAIL="abdllyevv@gmail.com"
# Required by the seed script. Use a strong password and change it after the first login.
SEED_ADMIN_PASSWORD=""

# Optional: where uploads are stored (default: server/uploads). Tests point this at a temp folder.
# UPLOADS_DIR=""

# ─── Security / sessions ─────────────────────────────────────────────
# Set to 1 ONLY when the API runs behind exactly one reverse proxy (nginx, Caddy, Traefik).
# Leave unset/false when the API is exposed directly, otherwise clients can spoof their IP.
TRUST_PROXY=false
# Extra browser origins allowed besides CLIENT_URL (comma-separated), e.g. a staging domain.
ALLOWED_ORIGINS=""
# Web sessions: end after this many minutes without activity, and after SESSION_MAX_HOURS at most.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Mobile app sessions (used intermittently, so longer windows).
MOBILE_SESSION_IDLE_DAYS=14
MOBILE_SESSION_MAX_DAYS=30
# Failed logins per account before it is locked for LOGIN_LOCK_MINUTES.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Optional: shared Redis for rate limits and login locks when running several API instances.
# REDIS_URL=redis://redis:6379

# ─── Staff document workspaces ───────────────────────────────────────
# Each staff member gets <DOCS_DIR>/<first-name>/senedleri/ (default: server/docs); company folders are
# <first-name>/senedleri/<company>/senedler/. Point this at a
# backed-up location in production. Files keep their real names, so the folder is browsable on the server.
# DOCS_DIR=""
DOCS_MAX_FILE_MB=5
# Team drive (/workspace/drive): per-file upload limit, MB.
DRIVE_MAX_FILE_MB=50
# Client case documents (PDF/images/Word) size limit.
UPLOAD_MAX_FILE_MB=5

# ─── Messaging (WhatsApp Business + SMS) ─────────────────────────────
# Leave everything empty in development: messages are then printed to the console and recorded in the
# OutboundMessage table with status CONSOLE (admin panel → Messaging → Outbound log).
#
# WhatsApp Business (Meta Cloud API). Create an app at developers.facebook.com, add the WhatsApp product,
# generate a permanent system-user token and copy the "Phone number ID" of the sender number.
# Free-form texts are only delivered inside the 24-hour customer service window (after the client wrote to
# the business number); outside it Meta requires a pre-approved template (WHATSAPP_TEMPLATE_<TYPE> below).
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_API_VERSION="v20.0"
# Webhook (Meta app → WhatsApp → Configuration): callback URL https://<api>/api/messaging/webhooks/whatsapp
# WHATSAPP_VERIFY_TOKEN="choose-a-random-string"      # echoed during the verification GET
# WHATSAPP_APP_SECRET=""                               # Meta app secret; validates X-Hub-Signature-256
# WHATSAPP_WEBHOOK_SECRET=""                           # fallback: append ?token=<secret> to the callback URL
# Optional approved template per notification type (body gets one {{1}} parameter with the text):
# WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER="appointment_reminder"
# WHATSAPP_TEMPLATE_LANG="en"
#
# SMS: "twilio" (or any Twilio-compatible API) or "http" (generic JSON gateway: POST {to, text}).
# SMS_PROVIDER=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+49..."
# TWILIO_API_URL="https://api.twilio.com"
# SMS_HTTP_URL="https://sms.example.com/send"
# SMS_HTTP_AUTH="Bearer <key>"                         # sent as the Authorization header
# Country code assumed for local numbers without a prefix (0501234567 → +994501234567).
# SMS_DEFAULT_COUNTRY_CODE="994"

# ─── Mail workspace (/workspace/mail: staff IMAP/SMTP mailboxes) ─────
# Passwords of staff mailboxes are sealed with TOTP_ENC_KEY (or JWT_SECRET) via lib/secretBox.
# Newest messages fetched per folder when a mailbox is synced for the first time.
MAIL_INITIAL_SYNC_LIMIT=500
# Seconds between background sync runs (every account with sync enabled).
MAIL_SYNC_INTERVAL_SEC=60
# Push mail: one IMAP IDLE connection per mailbox keeps INBOX current in real time (0 = off, poll only).
MAIL_IDLE=1
# IDLE connections at most; further accounts are polled every MAIL_SYNC_INTERVAL_SEC.
MAIL_IDLE_MAX_CONNECTIONS=50
# Full-sync safety net for accounts watched by IDLE, seconds.
MAIL_IDLE_POLL_INTERVAL_SEC=300
# Per-attachment limit (uploads and lazy IMAP downloads), MB.
MAIL_ATTACHMENT_MAX_MB=25
# How much of each message source is fetched during sync, MB (text parts come first; attachments are fetched on demand).
MAIL_FETCH_SOURCE_MAX_MB=3
# Outgoing messages per account per hour.
MAIL_SEND_PER_HOUR=60
# Known messages per folder whose flags are re-read on every sync (reads done on the phone show up).
MAIL_FLAG_RESYNC_WINDOW=200
# IMAP/SMTP socket timeout, ms.
MAIL_TIMEOUT_MS=30000

# ─── Own mail server (Stalwart) — Admin → Mailboxes, workspace mail "Mailbox security" ─
# Leave STALWART_ADMIN_USER / STALWART_ADMIN_PASSWORD empty: the pages show "mail server not connected".
# Management API (JMAP) base URL; inside docker-compose.prod the service is http://mail:8080.
STALWART_URL=""
# A Stalwart administrator account (e.g. admin@triad-vision.de) and its password.
STALWART_ADMIN_USER=""
STALWART_ADMIN_PASSWORD=""
# Domain whose mailboxes are managed (default triad-vision.de).
STALWART_DOMAIN=""
# Public IMAP/SMTP host shown to users; workspace accounts on this host get re-encrypted passwords on change (default mail.triad-vision.de).
STALWART_MAIL_HOST=""
# Request timeout, ms (default 10000).
# STALWART_TIMEOUT_MS=10000

# ─── Campaigns (Admin → Kampaniyalar, lib/campaigns) ─────────────────
# Ceiling for campaign e-mails per minute across all running campaigns (protects our own mail server; default 60).
# CAMPAIGN_MAX_EMAILS_PER_MINUTE=60
# Extra hosts tracked links may lead to, comma separated (our own CLIENT_URL host and triad-vision.de are always allowed).
# CAMPAIGN_LINK_HOSTS="make-it-in-germany.com"
# Optional SMS delivery reports: the provider calls POST /api/campaign-sms-status?secret=<this value>.
# CAMPAIGN_SMS_STATUS_SECRET=""
