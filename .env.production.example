# Production environment for docker-compose.prod.yml. Copy to .env.production and fill every <...>.
# Never commit .env.production.

# ─── Site ────────────────────────────────────────────────────────────
SITE_DOMAIN=triad-vision.de
# Let's Encrypt notifications about certificates
ACME_EMAIL=<your@email>
CLIENT_URL=https://triad-vision.de
# extra browser origins (comma-separated); www is redirected to the apex by Caddy, so usually empty
ALLOWED_ORIGINS=
# Caddy is the one proxy in front of the API and passes the real visitor IP (from Cloudflare's
# CF-Connecting-IP). Without this every visitor looks like the Caddy container and per-IP rate limits
# become one global limit.
TRUST_PROXY=1

# ─── Database (used by the MySQL container AND the API) ───────────────
MYSQL_DATABASE=triad_vision
MYSQL_USER=triad
MYSQL_PASSWORD=<strong-password>
MYSQL_ROOT_PASSWORD=<another-strong-password>
DATABASE_URL=mysql://triad:<strong-password>@db:3306/triad_vision

# ─── Security ────────────────────────────────────────────────────────
# At least 32 random characters, e.g.  openssl rand -hex 48
JWT_SECRET=<random-64-hex>
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
MOBILE_SESSION_IDLE_DAYS=14
MOBILE_SESSION_MAX_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ─── Files ───────────────────────────────────────────────────────────
DOCS_MAX_FILE_MB=5
# Team drive (/workspace/drive): per-file upload limit, MB.
DRIVE_MAX_FILE_MB=50
UPLOAD_MAX_FILE_MB=5

# ─── E-mail (Gmail: smtp.gmail.com, 465, App Password) ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<your@gmail.com>
SMTP_PASS=<16-char-app-password>
MAIL_FROM=Triad Vision <no-reply@triad-vision.de>
ADMIN_NOTIFY_EMAIL=abdllyevv@gmail.com

# ─── Own mail server (Stalwart) management — Admin → Mailboxes ──────
# Empty admin user/password = feature shows "mail server not connected".
# SMTP_USER above is protected: its mailbox cannot be deleted or have its password reset from the UI.
STALWART_URL=http://mail:8080
STALWART_ADMIN_USER=<stalwart-admin-login>
STALWART_ADMIN_PASSWORD=<stalwart-admin-password>
STALWART_DOMAIN=triad-vision.de
STALWART_MAIL_HOST=mail.triad-vision.de
# STALWART_TIMEOUT_MS=10000

# ─── First admin (super admin), created by the seed ──────────────────
SEED_ADMIN_EMAIL=abdllyevv@gmail.com
SEED_ADMIN_PASSWORD=<at-least-10-chars-change-after-first-login>
