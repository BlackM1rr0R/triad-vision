{
  // Type-checks the Playwright config, fixtures and specs: npx tsc --noEmit -p tests/browser
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["output", ".data"]
}
