# Copy to .env and adjust. Variables prefixed with EXPO_PUBLIC_ are inlined into the app bundle.

# API base URL as seen FROM THE PHONE. "localhost" does not work on a phone - use this PC's LAN IP
# (run ipconfig and take the IPv4 address of your Wi-Fi adapter).
# Leave it unset to auto-detect: the app reuses the IP of the Expo dev server (Metro) with port 4000.
# Android emulator: http://10.0.2.2:4000/api   |   iOS simulator: http://localhost:4000/api
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api

# EAS project id — enables remote push (Expo push tokens). Get it with `npx eas-cli@latest init`,
# then set it in ALL of these places (the same value): here (local dev builds), the `env` of every
# profile in eas.json (cloud builds; this is what store builds use) and/or the committed constant
# in app.config.ts. The all-zero placeholder is ignored by app.config.ts (push stays disabled).
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Build variant. "development" allows plain-HTTP API access (LAN dev server) and is what
# the eas.json `development` profile sets. Never set it for preview/production builds.
APP_VARIANT=development
