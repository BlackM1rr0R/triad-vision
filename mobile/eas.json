{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "development", "EAS_PROJECT_ID": "00000000-0000-0000-0000-000000000000" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://triad-vision.de/api", "EAS_PROJECT_ID": "00000000-0000-0000-0000-000000000000" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://triad-vision.de/api", "EAS_PROJECT_ID": "00000000-0000-0000-0000-000000000000" }
    }
  },
  "submit": {
    "production": {}
  }
}
