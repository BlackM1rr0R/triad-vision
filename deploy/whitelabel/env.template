# .env.production of a white-label customer instance — rendered by deploy/whitelabel/new-instance.sh
# (${NAME} placeholders come from the script: random secrets + the BRAND_* / LICENSE_KEY values you pass in).
# Lives at <APP_DIR>/.env.production on the customer's server (chmod 600). Never commit a rendered copy.

# ─── Instance ────────────────────────────────────────────────────────
# customer: this server needs a valid LICENSE_KEY (issued with deploy/whitelabel/issue-license.mjs).
INSTANCE_ROLE=customer
LICENSE_KEY=${LICENSE_KEY}
# Seed without the owner's business content; the first SUPER_ADMIN gets a one-time setup link.
SEED_PROFILE=whitelabel

# ─── Site ────────────────────────────────────────────────────────────
SITE_DOMAIN=${DOMAIN}
ACME_EMAIL=${ACME_EMAIL}
CLIENT_URL=https://${DOMAIN}
ALLOWED_ORIGINS=
TRUST_PROXY=1

# ─── Brand (defaults; the SUPER_ADMIN can override them in System → Brand) ─
BRAND_NAME=${BRAND_NAME}
BRAND_SHORT=${BRAND_SHORT}
BRAND_DOMAIN=${DOMAIN}
BRAND_LEGAL_NAME=${BRAND_LEGAL_NAME}
BRAND_SUPPORT_EMAIL=${BRAND_SUPPORT_EMAIL}
BRAND_PHONE=${BRAND_PHONE}
BRAND_COUNTRY=${BRAND_COUNTRY}
BRAND_TAGLINE=${BRAND_TAGLINE}
BRAND_LANGUAGES=${BRAND_LANGUAGES}

# ─── Database (used by the MySQL container AND the API) ───────────────
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=${DB_PASSWORD}
MYSQL_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
DATABASE_URL=mysql://app:${DB_PASSWORD}@db:3306/app

# ─── Security ────────────────────────────────────────────────────────
JWT_SECRET=${JWT_SECRET}
# Encrypts 2FA secrets and other sealed values (lib/secretBox.ts), independent of JWT_SECRET.
TOTP_ENC_KEY=${TOTP_ENC_KEY}
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
MOBILE_SESSION_IDLE_DAYS=14
MOBILE_SESSION_MAX_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Web push of the installable site (generated key pair).
VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
VAPID_PRIVATE_KEY=${VAPID_PRIVATE_KEY}
VAPID_SUBJECT=mailto:${ADMIN_EMAIL}

# ─── Files ───────────────────────────────────────────────────────────
DOCS_MAX_FILE_MB=5
DRIVE_MAX_FILE_MB=50
UPLOAD_MAX_FILE_MB=5

# ─── E-mail: the agency's own SMTP (empty SMTP_HOST = mails are only logged) ─
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_SECURE=true
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
MAIL_FROM=${BRAND_NAME} <${MAIL_FROM_ADDRESS}>
ADMIN_NOTIFY_EMAIL=${ADMIN_EMAIL}

# ─── First super admin (setup link printed by the seed; no password here) ─
SEED_ADMIN_EMAIL=${ADMIN_EMAIL}

# Optional: OPENROUTER_API_KEY (AI assistant), GA4_ID, WHATSAPP_* / SMS_* — see server/.env.example.
