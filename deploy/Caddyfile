{
	email {$ACME_EMAIL}

	servers {
		# The site sits behind Cloudflare. Only Cloudflare's edges may tell Caddy who the real visitor
		# is (CF-Connecting-IP); a request arriving from anywhere else keeps its own address, so the
		# header can't be spoofed. Source: https://www.cloudflare.com/ips/ (update if Cloudflare adds ranges;
		# deploy/cloudflare-firewall.sh uses the same list for the host firewall).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# CSP of the site pages (the API sets its own); shared by the SPA and its 404 page (handle_errors). The sha256 is
# the theme/accessibility script inlined in client/index.html — if that script changes, recompute the hash or the
# page falls back to defaults. googletagmanager / google-analytics: optional GA4, loaded only after analytics
# consent (src/lib/analytics.ts).
(spa_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-sNwUVmDspMX6YHVZ8Jci0RFWQlS7b6Bm5BlswyrkSJA=' https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://cloudflareinsights.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; frame-src https://www.openstreetmap.org https://www.youtube-nocookie.com https://player.vimeo.com; worker-src 'self' blob:; media-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
}

# The HTML shell is a Caddy template (custom delimiters, so the actions are plain HTML comments in
# client/index.html and the Vite dev server ignores them). The included tags are built by the API with all text
# escaped; it can never contain the delimiters.
(spa_templates) {
	templates @shell {
		mime text/html
		between "<!--tv:" ":tv-->"
	}
}

# www → apex, so the session cookie and CSRF origin always see one host.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Mail client autoconfiguration (e-mail + password is enough in Thunderbird, Outlook and most mobile apps).
# DNS: CNAME autoconfig and autodiscover → the apex. The API answers with the settings of our own mail
# server (routes/mailAutoconfig.ts); Stalwart's management listener (8080) stays private.
autoconfig.{$SITE_DOMAIN}, autodiscover.{$SITE_DOMAIN} {
	@mailconfig path /mail/config-v1.1.xml /.well-known/autoconfig/mail/config-v1.1.xml /autodiscover/autodiscover.xml
	handle @mailconfig {
		rewrite * /api/mail-autoconfig{path}
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
			header_up -Cookie
		}
	}
	handle {
		respond 404
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# robots.txt, the sitemaps (index + /sitemaps/*.xml), the RSS feeds (/rss.xml, /de/rss.xml …) and the
	# generated Open Graph title cards (/og/…) and the IndexNow key file come from the API (cached there).
	@seofiles path /robots.txt /indexnow.txt /sitemap.xml /sitemaps/* /rss.xml /de/rss.xml /en/rss.xml /ru/rss.xml /tr/rss.xml /uk/rss.xml /og/*
	handle @seofiles {
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Job board feeds (/feeds/indeed.xml, /feeds/stepstone.xml, /feeds/generic.xml ?token=…) come from the API,
	# which checks the secret token and caches each feed for 10 minutes (server/src/routes/jobFeeds.ts,
	# deploy/README-jobfeeds.md). The token travels in the query string and so appears in the access log below;
	# rotate it (Admin → İş elanı kanalları) if logs are shared with anyone who should not read the feeds.
	@jobfeeds path /feeds/*
	handle @jobfeeds {
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Per-page <head> tags (title, description, canonical, hreflang, Open Graph, JSON-LD), the page's HTTP status
	# (/__seo/status: "404" for unknown URLs and missing/expired content), the white-label brand
	# tags (/__seo/brand: theme colour, icons, app title) and the crawlable page
	# body (/__seo/body, placed inside <div id="root">) for crawlers that do not run JavaScript. index.html
	# includes them via httpInclude (see the templates directive below). Only Caddy's own include sub-requests
	# match here (they come from 127.0.0.1 and carry Caddy-Templates-Include);
	# anyone else asking for /__seo/head just gets the SPA. Short timeouts: a slow API must not hold pages up.
	@seohead {
		path /__seo/head /__seo/body /__seo/brand /__seo/status
		remote_ip 127.0.0.1
		header Caddy-Templates-Include *
	}
	handle @seohead {
		reverse_proxy api:4000 {
			header_up -Cookie
			header_up -Authorization
			transport http {
				dial_timeout 1s
				response_header_timeout 2s
			}
		}
	}

	# Server-rendered page markup (SSR service, client/ssr/server.mjs; index.html includes /__ssr/render?url=…
	# into <div id="root">, and the browser hydrates it). Same rules as the SEO includes: only Caddy's own include
	# sub-requests, no cookies (the render is the anonymous visitor's page), short timeouts — when the service is
	# slow, down or not deployed, handle_errors answers empty and the page falls back to the client-side render.
	@ssrrender {
		path /__ssr/render
		remote_ip 127.0.0.1
		header Caddy-Templates-Include *
	}
	handle @ssrrender {
		rewrite * /render?{query}
		reverse_proxy {$SSR_UPSTREAM:ssr:4100} {
			header_up -Cookie
			header_up -Authorization
			transport http {
				dial_timeout 500ms
				response_header_timeout 1500ms
			}
		}
	}

	# API and CMS images come from the Node service. X-Forwarded-For is replaced with the real visitor IP
	# resolved above, so the API (TRUST_PROXY=1) rate-limits and audits per visitor, not per Cloudflare edge.
	# Server-sent events (realtime chat/notifications): stream immediately, never buffer.
	@sse path /api/messaging/events
	handle @sse {
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
			transport http {
				response_header_timeout 0
			}
		}
	}

	# Mail client autoconfiguration on the apex: Thunderbird's well-known fallback and Outlook, which tries
	# https://<domain>/autodiscover/autodiscover.xml before the autodiscover subdomain (paths match case-insensitively).
	@mailconfig path /.well-known/autoconfig/mail/config-v1.1.xml /autodiscover/autodiscover.xml
	handle @mailconfig {
		rewrite * /api/mail-autoconfig{path}
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
			header_up -Cookie
		}
	}

	@backend path /api/* /uploads/*
	handle @backend {
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Google review request link (/r/review/<token>, from e-mails and notifications): straight to the API, which
	# counts the click and answers with a 302 to Google — no SPA load in between. Exactly one segment and GET
	# only: /r/review/<token>/optout stays the SPA page (it posts the opt-out itself).
	@reviewlink {
		method GET
		path_regexp reviewlink ^/r/review/[^/]+$
	}
	handle @reviewlink {
		rewrite * /api{path}
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Web app manifest of the installable site: built by the API from the instance brand (name, icons, colour).
	# If the API is unreachable, handle_errors below serves the static client/public/manifest.webmanifest.
	@manifestapi path /manifest.webmanifest
	handle @manifestapi {
		header Cache-Control "no-cache"
		reverse_proxy api:4000 {
			header_up -Cookie
			header_up -Authorization
			transport http {
				dial_timeout 1s
				response_header_timeout 2s
			}
		}
	}

	# Language URLs: Azerbaijani lives at the root, the other languages under /de/, /en/, /ru/, /tr/, /uk/.
	# Old links with ?lng=xx (and /az/…) get ONE permanent redirect to the clean URL, so every page has exactly one
	# URL per language: ?lng=ru on a bare path → /ru/<path> (lng=az → the bare path), other query parameters kept,
	# a trailing slash dropped in the same hop (/?lng=de → /de, not /de/). On an already prefixed path the prefix
	# wins and the parameter is just removed (/de/jobs?lng=ru → /de/jobs); an unknown or empty value is removed
	# too. The value is matched case-insensitively and may carry a region (ru-RU, de_DE). The redirect target never
	# carries lng=, so it cannot loop. Private areas (the list mirrors PRIVATE_PREFIXES in
	# server/src/lib/seoCatalogue.ts — tests/unit/seo.test.ts compares them), token pages and files keep ?lng=
	# (the mobile app opens them in its language). deploy/caddy-redirects-test.sh checks all of this in CI.
	# /az/… first (az lives at the root); a ?lng= it carries is handled on the next request.
	@azprefix path /az /az/*
	handle @azprefix {
		route {
			uri strip_prefix /az
			redir {uri} permanent
		}
	}
	@lnglegacy {
		query lng=*
		not path_regexp ^(/(de|en|ru|tr|uk))?/(api|uploads|__seo|__ssr|assets|og|sitemaps|feeds|admin|workspace|account|company|agent|partner|booking/manage|review|verify-email|confirm-email-change|login/2fa|reset-password|sign|angebot|share|q|survey|check-in|unsubscribe|kandidat|job-alert|r)(/|$)|[.][A-Za-z0-9]+$
	}
	handle @lnglegacy {
		route {
			# map is evaluated lazily (when {lng_prefix} is read): keep the value before the parameter is removed.
			vars lng_raw {query.lng}
			map {vars.lng_raw} {lng_prefix} {
				~(?i)^de([-_,].*)?$ /de
				~(?i)^en([-_,].*)?$ /en
				~(?i)^ru([-_,].*)?$ /ru
				~(?i)^tr([-_,].*)?$ /tr
				~(?i)^uk([-_,].*)?$ /uk
				default none
			}
			uri query -lng
			@lngprefixed path_regexp lngprefixed ^(/(?:de|en|ru|tr|uk)(?:/.*?[^/])?)/*$
			redir @lngprefixed {re.lngprefixed.1}{?query} permanent
			@lngto {
				not vars {lng_prefix} none
				path_regexp lngto ^(.*?)/*$
			}
			redir @lngto {lng_prefix}{re.lngto.1}{?query} permanent
			@lngbare path_regexp lngbare ^(/.*?)/*$
			redir @lngbare {re.lngbare.1}{?query} permanent
		}
	}

	# Old alias routes of the SPA (client-side <Navigate>): a permanent redirect, so crawlers see one URL. Inside
	# handle blocks (a bare redir would run before every handle, i.e. before the ?lng= redirect above, and drop
	# the language: /calculators?lng=de must end on /de/tools).
	@aliasTools path_regexp aliasTools ^(/(?:de|en|ru|tr|uk))?/calculators$
	handle @aliasTools {
		redir {re.aliasTools.1}/tools{?query} permanent
	}
	@aliasWorkers path_regexp aliasWorkers ^(/(?:de|en|ru|tr|uk))?/(?:workers|candidates)$
	handle @aliasWorkers {
		redir {re.aliasWorkers.1}/for-workers{?query} permanent
	}
	@aliasEmployers path_regexp aliasEmployers ^(/(?:de|en|ru|tr|uk))?/employers$
	handle @aliasEmployers {
		redir {re.aliasEmployers.1}/for-employers{?query} permanent
	}

	# Single-page app: hashed assets are immutable, everything else falls back to index.html.
	handle {
		import spa_csp
		root * /srv
		# One URL per page: a trailing slash (/visas/, /de/) gets a permanent redirect to the bare path.
		@trailingSlash path_regexp trailingSlash ^(/.*[^/])/+$
		redir @trailingSlash {re.trailingSlash.1}{?query} permanent
		# Browsers and some crawlers (Bing, Yandex) ask for /favicon.ico without reading the <link> tags.
		@faviconIco path /favicon.ico
		rewrite @faviconIco /icons/icon-192.png
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Unhashed images and icons in the web root (og-default.png, logo, favicons): a week, then revalidate.
		@staticImages path_regexp staticImages ^/(?:icons/)?[^/]+\.(?:png|svg|ico|webp|jpg)$
		header @staticImages Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		# Installable site (PWA): the service worker, manifest and offline page are always revalidated, so
		# Cloudflare or the browser never hold an old sw.js (that would delay the "new version" prompt).
		@pwa path /sw.js /manifest.webmanifest /offline.html
		header @pwa Cache-Control "no-cache"
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
		# Only the HTML shell is a template (never JS/CSS/images), see (spa_templates). It asks the API for the
		# page's status and stops with httpError 404 for unknown URLs (handle_errors below serves the shell then).
		@shell path / /index.html
		import spa_templates
		try_files {path} /index.html
		# Hashed JS/CSS/SVG ship with a Brotli copy (*.br, written by the client build, quality 11): ~15 % smaller
		# than the gzip `encode` makes on the fly. Everything else (index.html is a template) is compressed live.
		file_server {
			precompressed br
		}
	}

	# Fail soft: if the API is down or too slow, the head and body includes answer empty and index.html keeps
	# its static fallback title/description (and an empty #root) instead of the whole page failing. Other errors keep Caddy's default.
	handle_errors {
		@seoheadFailed path /__seo/head /__seo/body /__seo/brand /__seo/status
		respond @seoheadFailed 200
		# The SSR include (rewritten to /render above): empty = the page renders on the client.
		@ssrFailed {
			path /render /__ssr/render
			header Caddy-Templates-Include *
		}
		respond @ssrFailed 200
		# Unknown page (httpError 404 from the shell template, see client/index.html): the same SPA shell with
		# status 404, so crawlers get a real 404 (no soft 404) and visitors the app's "not found" page. The
		# template skips its status check here (http.error.status_code is set), so this cannot loop.
		@pageNotFound expression {err.status_code} == 404
		handle @pageNotFound {
			import spa_csp
			header Cache-Control "no-cache"
			root * /srv
			rewrite * /index.html
			@shell path /index.html
			import spa_templates
			file_server {
				status 404
			}
		}
		@manifestFailed path /manifest.webmanifest
		handle @manifestFailed {
			root * /srv
			header Content-Type "application/manifest+json"
			header Cache-Control "no-cache"
			file_server
		}
	}

	log {
		output stdout
		format console
	}
}
