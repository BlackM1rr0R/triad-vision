{
	email {$ACME_EMAIL}

	servers {
		# The site sits behind Cloudflare. Only Cloudflare's edges may tell Caddy who the real visitor
		# is (CF-Connecting-IP); a request arriving from anywhere else keeps its own address, so the
		# header can't be spoofed. Source: https://www.cloudflare.com/ips/ (update if Cloudflare adds ranges;
		# deploy/cloudflare-firewall.sh uses the same list for the host firewall).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# www → apex, so the session cookie and CSRF origin always see one host.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# robots.txt and sitemap.xml are generated by the API from the CMS (cached there).
	@seofiles path /robots.txt /sitemap.xml
	handle @seofiles {
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Per-page <head> tags (title, description, canonical, hreflang, Open Graph, JSON-LD) for crawlers that do
	# not run JavaScript. index.html includes them via httpInclude (see the templates directive below). Only
	# Caddy's own include sub-requests match here (they come from 127.0.0.1 and carry Caddy-Templates-Include);
	# anyone else asking for /__seo/head just gets the SPA. Short timeouts: a slow API must not hold pages up.
	@seohead {
		path /__seo/head
		remote_ip 127.0.0.1
		header Caddy-Templates-Include *
	}
	handle @seohead {
		reverse_proxy api:4000 {
			header_up -Cookie
			header_up -Authorization
			transport http {
				dial_timeout 1s
				response_header_timeout 2s
			}
		}
	}

	# API and CMS images come from the Node service. X-Forwarded-For is replaced with the real visitor IP
	# resolved above, so the API (TRUST_PROXY=1) rate-limits and audits per visitor, not per Cloudflare edge.
	@backend path /api/* /uploads/*
	handle @backend {
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Single-page app: hashed assets are immutable, everything else falls back to index.html.
	handle {
		# CSP for the site pages (the API sets its own). The sha256 is the theme/accessibility script inlined
		# in client/index.html — if that script changes, recompute the hash or the page falls back to defaults.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-eF7y+eIxsWekSgobRFwXMaYNlrkIyBdPm8rc2J8Ia7Y=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.openstreetmap.org; worker-src 'self' blob:; media-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Only the HTML shell is a template (never JS/CSS/images). Custom delimiters, so the actions are plain
		# HTML comments in client/index.html and the Vite dev server ignores them. The included tags are built by
		# the API with all text escaped; it can never contain the delimiters.
		@shell path / /index.html
		templates @shell {
			mime text/html
			between "<!--tv:" ":tv-->"
		}
		try_files {path} /index.html
		file_server
	}

	# Fail soft: if the API is down or too slow, the head include answers empty and index.html keeps its
	# static fallback title/description instead of the whole page failing. Other errors keep Caddy's default.
	handle_errors {
		@seoheadFailed path /__seo/head
		respond @seoheadFailed 200
	}

	log {
		output stdout
		format console
	}
}
